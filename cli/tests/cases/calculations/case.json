{
  "steps": [
    {
      "cli": [
        "render",
        "calc.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "calculations | select {line, expression, bracketed, display}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "diagnostics | select {line, severity, code, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "length(filter(references, fn(r) => r.name == \"budget\"))",
        "--json"
      ]
    },
    {
      "cli": [
        "render",
        "math.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "math.x.md",
        "calculations | select {line, expression, bracketed, display}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "math.x.md",
        "diagnostics | select {line, severity, code, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "render",
        "errors.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "errors.x.md",
        "diagnostics | select {line, severity, code, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "unknown.x.md",
        "diagnostics | select {line, severity, code, message}",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "ratio.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "ratio.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "ratio.x.md",
          "line": 2,
          "character": 13
        },
        {
          "request": "textDocument/hover",
          "file": "ratio.x.md",
          "line": 2,
          "character": 8
        },
        {
          "open": "math.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "math.x.md",
          "line": 2,
          "character": 10
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "calc.x.md"
        }
      ]
    }
  ]
}
