{
  "steps": [
    {
      "cli": [
        "render",
        "calc.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "map(calculations, fn(r) => {line: r.line, expression: r.expression, bracketed: r.bracketed, display: r.display})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "length(filter(references, fn(r) => r.name == \"budget\"))",
        "--json"
      ]
    },
    {
      "cli": [
        "render",
        "math.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "math.x.md",
        "map(calculations, fn(r) => {line: r.line, expression: r.expression, bracketed: r.bracketed, display: r.display})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "math.x.md",
        "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "cli": [
        "render",
        "errors.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "errors.x.md",
        "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "unknown.x.md",
        "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "ratio.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "ratio.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "ratio.x.md",
          "line": 2,
          "character": 13
        },
        {
          "request": "textDocument/hover",
          "file": "ratio.x.md",
          "line": 2,
          "character": 8
        },
        {
          "open": "math.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "math.x.md",
          "line": 2,
          "character": 10
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "calc.x.md"
        }
      ]
    }
  ]
}
