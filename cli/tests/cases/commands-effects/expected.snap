### 0 cli run ./effects.x.md work --mode http
$ xmd run ./effects.x.md work --mode http
exit 0
--- stdout
{"json": {"method": "POST", "received": {"name": "Widget", "tags": ["a", "b"]}, "rest": "-H X-Trace: t1 -H Content-Type: application/json --data-binary @-"}, "ok": true, "status": 201, "text": ""}
{"json": null, "ok": true, "status": 201, "text": "{\"method\":\"PATCH\",\"rest\":\"\",\"received\":}"}
{"json": null, "ok": true, "status": 200, "text": "plain words"}
{"json": {"message": "Not Found"}, "ok": true, "status": 404, "text": ""}
{"error": "curl failed: curl: (6) Could not resolve host for https://api.example.com/broken", "ok": false}
{"error": "Unsupported method TRACE", "ok": false}
{"error": "ftp://example.com/file: only http and https addresses", "ok": false}
{"error": "http needs a url", "ok": false}
{"error": "Invalid header Bad:Name", "ok": false}
{"error": "Header values must be text", "ok": false}

### 1 cli run ./effects.x.md work --mode env
$ XMD_EMPTY= XMD_SET=yes xmd run ./effects.x.md work --mode env
exit 0
--- stdout
{"ok": true, "value": "yes"}
{"ok": true, "value": null}
{"ok": true, "value": null}

### 2 cli run ./effects.x.md work --mode env-refused
$ xmd run ./effects.x.md work --mode env-refused
exit 1
--- stderr
xmd: effects: only XMD_* variables can be read

### 3 cli run ./effects.x.md work --mode credential
$ XDG_CONFIG_HOME=config xmd run ./effects.x.md work --mode credential
exit 0
--- stdout
{"ok": true, "value": null}

### 4 cli run ./effects.x.md work --mode credential --key k9
