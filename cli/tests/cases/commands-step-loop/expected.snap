### 14 cli render lookups.x.md --format text
$ xmd render lookups.x.md --format text --root <root> --now 2026-09-18T12:00:00Z
exit 0
--- stdout
# Provider loops
spin := quote("SPIN")
text_requests := quote("TEXT") = $1
loops := quote("LOOPS")
file := quote("FILE")
no_url := quote("NOURL")
down := quote("DOWN") = $2
fail := quote("FAIL")
null_error := quote("NULLERR") = $3
not_record := quote("RECORD")

## Builds
https://ci.example/builds/1 green:green green
https://ci.example/builds/2 build:broken build
https://ci.example/builds/3 build:unknown build
https://ci.example/builds/4 build:garbled build
https://ci.example/builds/5 build:missing build
