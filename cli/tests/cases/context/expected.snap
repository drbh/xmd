### 0 cli render imports.x.md --format text
$ xmd render imports.x.md --format text --root <root> --now 2026-09-16T12:00:00-04:00
exit 1
--- stdout
[broken] := import("./b.x.md").remote + 1
[other] := 1 / 0
[good] := 4 = 4
--- stderr
<root>/imports.x.md:1:2: error: Dependency error: Unknown name 'absent'
<root>/imports.x.md:2:16: error: Division by zero (Number / Number)
xmd: 2 error(s) while rendering

### 1 cli query imports.x.md map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message}) --json
$ xmd query imports.x.md map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message}) --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "code": "dependency",
    "line": 0,
    "message": "Dependency error: Unknown name 'absent'",
    "severity": "error"
  },
  {
    "code": "evaluation",
    "line": 1,
    "message": "Division by zero (Number / Number)",
    "severity": "error"
  }
]

### 2 cli query imports.x.md map(values, fn(r) => {name: r.name, display: r.display}) --json
$ xmd query imports.x.md map(values, fn(r) => {name: r.name, display: r.display}) --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "display": null,
    "name": "broken"
  },
  {
    "display": null,
    "name": "other"
  },
  {
    "display": "4",
    "name": "good"
  }
]

