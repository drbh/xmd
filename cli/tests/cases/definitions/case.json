{
  "steps": [
    {
      "cli": [
        "query",
        "defs.x.md",
        "map(values, fn(r) => {name: r.name, type: r.type, display: r.display})",
        "--json"
      ]
    },
    {
      "cli": [
        "render",
        "defs.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "defs.x.md",
        "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "defs.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "defs.x.md"
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "defs.x.md"
        },
        {
          "request": "textDocument/documentLink",
          "file": "defs.x.md"
        }
      ]
    },
    {
      "cli": [
        "render",
        "calc.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "calc.x.md",
        "map(values, fn(r) => {name: r.name, display: r.display})",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "calc.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "calc.x.md",
          "line": 2,
          "character": 2
        },
        {
          "open": "prose.x.md"
        },
        {
          "request": "textDocument/documentSymbol",
          "file": "prose.x.md"
        }
      ]
    },
    {
      "cli": [
        "query",
        "prose.x.md",
        "map(values, fn(r) => {name: r.name})",
        "--json"
      ]
    },
    {
      "cli": [
        "render",
        "both.x.md",
        "--format",
        "text"
      ]
    },
    {
      "lsp": [
        {
          "open": "both.x.md"
        },
        {
          "request": "textDocument/references",
          "file": "both.x.md",
          "line": 0,
          "character": 28,
          "extra": {
            "context": {
              "includeDeclaration": true
            }
          }
        },
        {
          "request": "textDocument/prepareRename",
          "file": "both.x.md",
          "line": 0,
          "character": 28
        },
        {
          "request": "textDocument/rename",
          "file": "both.x.md",
          "line": 0,
          "character": 28,
          "extra": {
            "newName": "outgoing"
          }
        }
      ]
    }
  ]
}
