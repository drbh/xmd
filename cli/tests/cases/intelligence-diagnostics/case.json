{
  "steps": [
    {
      "cli": [
        "query",
        "types.x.md",
        "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "syntax.x.md",
        "map(diagnostics, fn(r) => {line: r.line, code: r.code, message: r.message})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "clock.x.md",
        "map(diagnostics, fn(r) => {line: r.line, message: r.message})",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "clock.x.md",
        "map(diagnostics, fn(r) => {line: r.line, message: r.message})",
        "--json",
        "--now",
        "2026-09-16T14:00:01-04:00"
      ]
    },
    {
      "lsp": [
        {
          "open": "types.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "types.x.md"
        },
        {
          "open": "syntax.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "syntax.x.md"
        },
        {
          "open": "cycles.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "cycles.x.md"
        },
        {
          "open": "ambiguous.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "ambiguous.x.md"
        },
        {
          "open": "tasks.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "tasks.x.md"
        }
      ]
    }
  ]
}
