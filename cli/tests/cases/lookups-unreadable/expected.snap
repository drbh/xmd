### 1 cli render lookups.x.md --format text
$ xmd render lookups.x.md --format text --root <root> --now 2026-09-18T12:00:00Z
exit 1
--- stdout
# Cached lookups
unreadable_rate := rate(EUR, USD)
negative_rate := rate(EUR, GBP)
failed_rate := rate(EUR, JPY)
pending_rate := rate(EUR, CAD)
uncached_rate := rate(CHF, USD)
unreadable_quote := quote("nvda")
failed_quote := quote(AAPL)
odd_currency := quote("msft") = 10 XYZ
uncached_quote := quote(TSLA)
hot := forecast("Oaxaca", 2026-09-20)
no_low := forecast("Lima", 2026-09-20)
pending_forecast := forecast("Quito", 2026-09-20)
uncached_forecast := forecast("Cusco", 2026-09-20)

## Monday, September 21, 2026 · Bogota 0 stops · in 3 days · Station offline

## Tuesday, September 22, 2026 · Medellín 0 stops · in 4 days
