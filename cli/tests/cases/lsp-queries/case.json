{
  "steps": [
    {
      "lsp": [
        {
          "open": "n.x.md"
        },
        {
          "change": {
            "file": "n.x.md",
            "text": "$9:price\n- [ ] Unsaved\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "n.x.md"
        },
        {
          "query": {
            "query": "map(values, fn(r) => {name: r.name, value: r.value, day:today(), clock:now()})"
          }
        },
        {
          "query": {
            "query": "map(sort_by(sort_by(filter(tasks, fn(r) => r.leaf && !r.done), fn(r) => r.source.line), fn(r) => r.source.path), fn(r) => r.title)"
          }
        },
        {
          "change": {
            "file": "n.x.md",
            "text": "$12:price\n- [x] Finished\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "n.x.md"
        },
        {
          "query": {
            "query": "sort_by(sort_by(filter(tasks, fn(r) => r.leaf && !r.done), fn(r) => r.source.line), fn(r) => r.source.path)"
          }
        },
        {
          "request": "xmd/query",
          "params": {
            "query": "filter(tasks, fn(r) => ()"
          }
        }
      ]
    },
    {
      "read": [
        "n.x.md"
      ]
    },
    {
      "lsp": [
        {
          "open": "one.x.md"
        },
        {
          "change": {
            "file": "one.x.md",
            "text": "answer := import(\"./two.x.md\").rate * 2\n- [ ] Local\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "one.x.md"
        },
        {
          "query": {
            "query": "map(filter(ast, fn(n) => n.kind == \"definition\"), fn(n) => n.name)",
            "uri": "one.x.md"
          }
        },
        {
          "query": {
            "query": "map(tasks, fn(r) => r.title)",
            "uri": "one.x.md"
          }
        },
        {
          "query": {
            "query": "length(tasks)"
          }
        },
        {
          "query": {
            "query": "map(filter(graph.nodes, fn(r) => r.external), fn(r) => r.name)",
            "uri": "one.x.md"
          }
        },
        {
          "request": "xmd/query",
          "params": {
            "uri": "https://example.com/n.x.md",
            "query": "ast"
          }
        },
        {
          "request": "xmd/query",
          "params": {
            "uri": "${uri:missing.x.md}",
            "query": "ast"
          }
        }
      ]
    },
    {
      "lsp": [
        {
          "open": "main.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "main.x.md"
        },
        {
          "change": {
            "file": "main.x.md",
            "text": "src := import(\"./.hidden/values.x.md\")\nanswer := src.amount\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "main.x.md"
        },
        {
          "query": {
            "query": "answer",
            "uri": "main.x.md"
          }
        },
        {
          "open": ".hidden/values.x.md"
        },
        {
          "change": {
            "file": ".hidden/values.x.md",
            "text": "amount := 77\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": ".hidden/values.x.md"
        },
        {
          "query": {
            "query": "answer",
            "uri": "main.x.md"
          }
        },
        {
          "close": ".hidden/values.x.md"
        },
        {
          "query": {
            "query": "answer",
            "uri": "main.x.md"
          }
        }
      ]
    },
    {
      "read": [
        "main.x.md",
        ".hidden/values.x.md"
      ]
    }
