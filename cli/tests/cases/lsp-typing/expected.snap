### 0 lsp
-- initialize
{
  "capabilities": {
    "callHierarchyProvider": true,
    "codeActionProvider": true,
    "codeLensProvider": {
      "resolveProvider": false
    },
    "completionProvider": {
      "triggerCharacters": [
        "[",
        "@",
        "."
      ]
    },
    "definitionProvider": true,
    "documentFormattingProvider": true,
    "documentHighlightProvider": true,
    "documentLinkProvider": {
      "resolveProvider": false
    },
    "documentOnTypeFormattingProvider": {
      "firstTriggerCharacter": "\n",
      "moreTriggerCharacter": [
        "|"
      ]
    },
    "documentSymbolProvider": true,
    "executeCommandProvider": {
      "commands": [
        "xmd.invoke",
        "xmd.applyEdits",
        "xmd.task",
        "xmd.timer",
        "xmd.openResource",
        "xmd.refreshResource",
        "xmd.refresh",
        "xmd.today"
      ]
    },
    "experimental": {
      "xmdQuery": {
        "method": "xmd/query",
        "schemaVersion": 1
      }
    },
    "foldingRangeProvider": true,
    "hoverProvider": true,
    "inlayHintProvider": true,
    "referencesProvider": true,
    "renameProvider": {
      "prepareProvider": true
    },
    "semanticTokensProvider": {
      "full": true,
      "legend": {
        "tokenModifiers": [
          "declaration",
          "defaultLibrary"
        ],
        "tokenTypes": [
          "comment",
          "keyword",
          "number",
          "variable",
          "operator",
          "string",
          "heading",
          "function",
          "property",
          "decorator",
          "xmdMoney",
          "xmdDate",
          "xmdDuration",
          "xmdRatio",
          "xmdBoolean",
          "xmdPunctuation",
          "xmdCode",
          "xmdLink",
          "xmdCheckbox",
          "xmdTaskDone",
          "xmdCheckboxChecked",
          "xmdCheckboxInProgress",
          "xmdTime",
          "xmdDay",
          "xmdPlace",
          "xmdDetailKey",
          "xmdDepart",
          "xmdArrive",
          "xmdTransit",
          "xmdStay",
          "xmdMeal",
          "xmdVisit",
          "xmdExplore"
        ]
      }
    },
    "signatureHelpProvider": {
      "retriggerCharacters": [
        ")"
      ],
      "triggerCharacters": [
        "(",
        ","
      ]
    },
    "textDocumentSync": 1,
    "workspaceSymbolProvider": true
  },
  "serverInfo": {
    "name": "XMD",
    "version": "0.1.0"
  }
}
