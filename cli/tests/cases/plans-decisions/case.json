{
  "steps": [
    { "cli": ["render", "gear.x.md", "--format", "text"] },
    { "cli": ["query", "gear.x.md", "plans | select {name, display}", "--json"] },
    { "cli": ["query", "gear.x.md", "decisions | select {title, plan, line, value}", "--json"] },
    { "cli": ["query", "gear.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    {
      "lsp": [
        { "open": "gear.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "gear.x.md" },
        { "request": "textDocument/hover", "file": "gear.x.md", "line": 1, "character": 29 },
        { "request": "textDocument/hover", "file": "gear.x.md", "line": 7, "character": 2 },
        { "request": "textDocument/hover", "file": "gear.x.md", "line": 16, "character": 2 },
        {
          "request": "textDocument/codeAction",
          "file": "gear.x.md",
          "range": { "start": { "line": 7, "character": 2 }, "end": { "line": 7, "character": 2 } },
          "extra": { "context": { "diagnostics": [] } }
        }
      ]
    },
    { "cli": ["render", "packed.x.md", "--format", "text"] },
    { "cli": ["query", "packed.x.md", "plans | select {name, display}", "--json"] },
    { "cli": ["query", "packed.x.md", "rows | select {table, line, cells}", "--json"] },
    {
      "lsp": [
        { "open": "packed.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "packed.x.md" },
        {
          "request": "textDocument/formatting",
          "file": "packed.x.md",
          "extra": { "options": { "tabSize": 2, "insertSpaces": true } }
        },
        {
          "request": "textDocument/codeAction",
          "file": "packed.x.md",
          "range": { "start": { "line": 7, "character": 2 }, "end": { "line": 7, "character": 2 } },
          "extra": { "context": { "diagnostics": [] } }
        }
      ]
    }
  ]
}
