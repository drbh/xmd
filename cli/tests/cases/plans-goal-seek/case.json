{
  "steps": [
    { "cli": ["render", "savings.x.md", "--format", "text"] },
    { "cli": ["query", "savings.x.md", "map(values, fn(r) => {name: r.name, display: r.display})", "--json"] },
    { "cli": ["query", "savings.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    {
      "lsp": [
        { "open": "savings.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "savings.x.md" },
        { "request": "textDocument/hover", "file": "savings.x.md", "line": 3, "character": 3 }
      ]
    },
    { "cli": ["render", "units.x.md", "--format", "text"] },
    { "cli": ["query", "units.x.md", "map(values, fn(r) => {name: r.name, display: r.display})", "--json"] },
    { "cli": ["query", "unknowns.x.md", "map(values, fn(r) => {name: r.name, display: r.display})", "--json"] },
    { "cli": ["render", "broken.x.md", "--format", "text"] },
    { "cli": ["query", "broken.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] }
  ]
}
