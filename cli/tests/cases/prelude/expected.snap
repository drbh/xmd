### 0 cli render main.x.md --format text
$ xmd render main.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 1
--- stdout
# Prelude

## Trip :trip ████░░░░ 2/4 complete · 65m estimated left

- [x] Book flights @estimate(2h)
- [ ] Pack @estimate(45m)
- [ ] Passport ████░░░░ 1/2 subtasks
  - [x] Photo @estimate(missing)
  - [ ] Form @estimate(20m)

[count] := total(trip) = 4
[done] := completed(trip) = 2
[left] := remaining(trip) = 2
[work] := effort(trip) = 65m
[titles] := map(trip.tasks, .title) = ["Book flights", "Pack", "Photo", "Form"]
[open] := trip.tasks | filter(fn(t) => !t.done) | map(.title) = ["Pack", "Form"]
[charts] := map([[1, 2, 3], [3, 2, 1]], sparkline) = ["▁▅█", "█▅▁"]
[fixed] := sparkline([1, 5, 3], 0, 10) = ▂▅▃
greet := fn(name, greeting = "Hello", mark = if(greeting == "Hello", ".", "!")) => greeting + ", " + name + mark = <function>
[a] := greet("Ada") = Hello, Ada.
[b] := greet("Ada", "Hi") = Hi, Ada!
[c] := greet()
[d] := greet("Ada", "Hi", "?", 4)
