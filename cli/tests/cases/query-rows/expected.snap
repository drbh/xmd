### 11 cli query --workspace sort_by(map(group_by(tasks, fn(r) => r.source.path), fn(r) => {path:r.key, tasks:length(r.rows), effort:sum(r.rows.estimate)}), fn(r) => r.path) --root effort --json
$ xmd query --workspace sort_by(map(group_by(tasks, fn(r) => r.source.path), fn(r) => {path:r.key, tasks:length(r.rows), effort:sum(r.rows.estimate)}), fn(r) => r.path) --root effort --json --now 2026-09-16T12:00:00-04:00
exit 0
