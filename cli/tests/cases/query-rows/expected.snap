### 0 cli query tasks.x.md length(tasks) --json
$ xmd query tasks.x.md length(tasks) --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  4
]

### 1 cli query tasks.x.md slice(sort_by(map(filter(tasks, fn(r) => r.leaf && !r.done && contains(r.tags, "errands")), fn(r) => {title: r.title, due: r.due, estimate: r.estimate, source: r.source, parent: r.parent}), fn(r) => r.due), 0, 1) --json
$ xmd query tasks.x.md slice(sort_by(map(filter(tasks, fn(r) => r.leaf && !r.done && contains(r.tags, "errands")), fn(r) => {title: r.title, due: r.due, estimate: r.estimate, source: r.source, parent: r.parent}), fn(r) => r.due), 0, 1) --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "due": {
      "type": "date",
      "value": "2026-09-17"
    },
    "estimate": {
      "seconds": 90,
      "type": "duration"
    },
    "parent": {
      "line": 1,
      "path": "<root>/tasks.x.md",
      "range": {
        "end": {
          "character": 5,
          "line": 0
        },
        "start": {
          "character": 2,
          "line": 0
        }
      },
      "uri": "file://<root>/tasks.x.md#L1"
    },
    "source": {
      "line": 2,
      "path": "<root>/tasks.x.md",
      "range": {
        "end": {
          "character": 54,
          "line": 1
        },
        "start": {
          "character": 0,
          "line": 1
        }
      },
      "uri": "file://<root>/tasks.x.md#L2"
    },
    "title": "Child #errands"
  }
]

### 2 cli query tasks.x.md length(filter(tasks, fn(r) => r.parent != null)) --json
$ xmd query tasks.x.md length(filter(tasks, fn(r) => r.parent != null)) --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  2
]

### 3 cli query tasks.x.md map(tasks, fn(r) => {title: r.title, due: r.due})
$ xmd query tasks.x.md map(tasks, fn(r) => {title: r.title, due: r.due}) --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
due=null	title=Parent
due=2026-09-17	title=Child #errands
due=null	title=Done
due=2026-10-01	title=Later

### 4 cli query pipes.x.md map(filter(tasks, fn(r) => r.title == "a|b" || (false && r.nonexistent)), fn(r) => {label: r.title, separator: ":,|", nested: contains(r.title, "|"), timestamp: 2026-09-16T12:00:00-04:00}) --json
$ xmd query pipes.x.md map(filter(tasks, fn(r) => r.title == "a|b" || (false && r.nonexistent)), fn(r) => {label: r.title, separator: ":,|", nested: contains(r.title, "|"), timestamp: 2026-09-16T12:00:00-04:00}) --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "label": "a|b",
    "nested": true,
    "separator": ":,|",
    "timestamp": {
      "type": "datetime",
      "value": "2026-09-16T12:00:00-04:00"
    }
  }
]

