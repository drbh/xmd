{
  "steps": [
    {
      "cli": [
        "render",
        "charts.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "query",
        "errors.x.md",
        "map(diagnostics, fn(r) => {line: r.line, message: r.message})",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "charts.x.md"
        },
        {
          "request": "textDocument/inlayHint",
          "file": "charts.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 12,
              "character": 0
            }
          }
        },
        {
          "request": "textDocument/signatureHelp",
          "file": "charts.x.md",
          "line": 1,
          "character": 47
        }
      ]
    }
  ]
}
