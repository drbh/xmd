{
  "activeParameter": 2,
  "activeSignature": 0,
  "signatures": [
    {
      "documentation": {
        "kind": "markdown",
        "value": "Draw one Unicode bar per numeric value, in list order. Null leaves a gap (·). The scale uses the data's minimum and maximum unless both bounds are supplied; values outside fixed bounds are clipped. Values and bounds must use matching units."
      },
      "label": "sparkline(values: List, min?: Number, Money, Ratio, or Duration, max?: Number, Money, Ratio, or Duration) → Text",
      "parameters": [
        {
          "label": "values: List"
        },
