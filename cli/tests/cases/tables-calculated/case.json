{
  "steps": [
    { "cli": ["render", "calc.x.md", "--format", "text"] },
    { "cli": ["query", "calc.x.md", "map(cells, fn(r) => {title: r.title, line: r.line, value: r.value})", "--json"] },
    { "cli": ["query", "calc.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    {
      "lsp": [
        { "open": "calc.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "calc.x.md" },
        { "request": "textDocument/hover", "file": "calc.x.md", "line": 6, "character": 11 },
        {
          "request": "textDocument/references",
          "file": "calc.x.md",
          "line": 0,
          "character": 7,
          "extra": { "context": { "includeDeclaration": true } }
        },
        {
          "request": "textDocument/formatting",
          "file": "calc.x.md",
          "extra": { "options": { "tabSize": 2, "insertSpaces": true } }
        }
      ]
    },
    { "cli": ["query", "wrong.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    {
      "lsp": [
        { "open": "wrong.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "wrong.x.md" }
      ]
    },
    { "cli": ["query", "unknown.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "empty.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] }
  ]
}
