{
  "steps": [
    { "cli": ["render", "badcells.x.md", "--format", "text"] },
    { "cli": ["query", "badcells.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    {
      "lsp": [
        { "open": "badcells.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "badcells.x.md" }
      ]
    },
    { "cli": ["query", "malformed-empty.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "malformed-empty.x.md", "total", "--json"] },
    { "cli": ["query", "malformed-short.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "malformed-short.x.md", "total", "--json"] },
    { "cli": ["query", "malformed-extra.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "malformed-extra.x.md", "total", "--json"] },
    { "cli": ["query", "malformed-money.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "malformed-money.x.md", "total", "--json"] },
    {
      "lsp": [
        { "open": "malformed-empty.x.md" },
        { "request": "textDocument/formatting", "file": "malformed-empty.x.md", "extra": { "options": { "tabSize": 2, "insertSpaces": true } } },
        { "open": "malformed-short.x.md" },
        { "request": "textDocument/formatting", "file": "malformed-short.x.md", "extra": { "options": { "tabSize": 2, "insertSpaces": true } } },
        { "open": "malformed-extra.x.md" },
        { "request": "textDocument/formatting", "file": "malformed-extra.x.md", "extra": { "options": { "tabSize": 2, "insertSpaces": true } } },
        { "open": "malformed-money.x.md" },
        { "request": "textDocument/formatting", "file": "malformed-money.x.md", "extra": { "options": { "tabSize": 2, "insertSpaces": true } } }
      ]
    },
    { "cli": ["query", "shape-empty.x.md", "t", "--json"] },
    { "cli": ["query", "shape-empty.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "shape-dupe.x.md", "t", "--json"] },
    { "cli": ["query", "shape-dupe.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "shape-keyword.x.md", "t", "--json"] },
    { "cli": ["query", "shape-keyword.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "shape-separator.x.md", "t", "--json"] },
    { "cli": ["query", "shape-separator.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    { "cli": ["query", "empty.x.md", "sum(t, value)", "--json"] },
    { "cli": ["query", "empty.x.md", "sum(12, value)", "--json"] },
    { "cli": ["query", "empty.x.md", "sum(t)", "--json"] },
    { "cli": ["query", "nested.x.md", "sum(t, sum(t, sum(t, sum(t, value))))", "--json"] },
    { "cli": ["query", "units.x.md", "[sum(money, value), sum(pct, value), sum(dur, value)]", "--json"] },
    { "cli": ["query", "units.x.md", "sum(text, value)", "--json"] }
  ]
}
