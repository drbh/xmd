{
  "steps": [
    { "cli": ["render", "focus.x.md", "--format", "text"] },
    { "cli": ["render", "focus.x.md", "--now", "2026-09-17T14:00:00-04:00", "--format", "text"] },
    { "cli": ["query", "focus.x.md", "map(timers, fn(r) => {name: r.name, line: r.line, value: r.value})", "--json"] },
    { "cli": ["render", "running.x.md", "--format", "text"] },
    { "cli": ["render", "running.x.md", "--now", "2026-09-16T14:01:59-04:00", "--format", "text"] },
    { "cli": ["render", "running.x.md", "--now", "2026-09-16T14:02:00-04:00", "--format", "text"] },
    { "cli": ["render", "running.x.md", "--now", "2026-09-16T16:30:00-04:00", "--format", "text"] },
    { "cli": ["query", "running.x.md", "map(timers, fn(r) => {name: r.name, value: r.value})", "--json", "--now", "2026-09-16T16:30:00-04:00"] },
    {
      "lsp": [
        { "open": "multiline.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "multiline.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:multiline.x.md}", "row": 2, "expected": "[focus] := countdown(", "module": "timers", "event": {"name": "focus", "action": "start"}}] }
        },
        { "await": "workspace/applyEdit" },
        { "open": "multiline-crlf.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:multiline-crlf.x.md}", "row": 2, "expected": "[focus] := countdown(", "module": "timers", "event": {"name": "focus", "action": "start"}}] }
        },
        { "await": "workspace/applyEdit" },
        { "open": "grouped.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:grouped.x.md}", "row": 1, "expected": "[watch] := ((countdown(limit)))", "module": "timers", "event": {"name": "watch", "action": "start"}}] }
        },
        { "await": "workspace/applyEdit" },
        {
          "request": "textDocument/inlayHint",
          "file": "grouped.x.md",
          "range": { "start": { "line": 0, "character": 0 }, "end": { "line": 99, "character": 0 } }
        }
      ]
    },
    { "cli": ["render", "cycle.x.md", "--format", "text"] },
    { "cli": ["query", "cycle.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] }
  ]
}
