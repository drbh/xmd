{
  "steps": [
    { "cli": ["render", "idle.x.md", "--format", "text"] },
    { "cli": ["render", "idle.x.md", "--now", "2026-09-17T14:00:00-04:00", "--format", "text"] },
    { "cli": ["query", "idle.x.md", "timers", "--json"] },
    {
      "lsp": [
        { "open": "idle.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "idle.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:idle.x.md}", "row": 0, "expected": "🦀 [watch] := stopwatch()", "module": "timers", "event": {"name": "watch", "action": "pause"}}] }
        },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:idle.x.md}", "row": 0, "expected": "🦀 [watch] := stopwatch()", "module": "timers", "event": {"name": "watch", "action": "start"}}] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "cli": ["render", "running.x.md", "--format", "text"] },
    { "cli": ["render", "running.x.md", "--now", "2026-09-16T14:01:00-04:00", "--format", "text"] },
    { "cli": ["query", "running.x.md", "timers", "--json"] },
    {
      "lsp": [
        { "open": "running.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:running.x.md}", "row": 0, "expected": "[watch] := stopwatch(0s, 2026-09-16T13:58:47-04:00)", "module": "timers", "event": {"name": "watch", "action": "pause"}}] }
        },
        { "await": "workspace/applyEdit" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:running.x.md}", "row": 0, "expected": "[watch] := stopwatch(0s, 2026-09-16T13:58:47-04:00)", "module": "timers", "event": {"name": "watch", "action": "reset"}}] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "cli": ["render", "paused.x.md", "--format", "text"] },
    { "cli": ["render", "paused.x.md", "--now", "2026-09-16T15:00:00-04:00", "--format", "text"] },
    { "cli": ["query", "paused.x.md", "timers", "--json"] },
    {
      "lsp": [
        { "open": "paused.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:paused.x.md}", "row": 0, "expected": "[watch] := stopwatch(73s)", "module": "timers", "event": {"name": "watch", "action": "start"}}] }
        },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:paused.x.md}", "row": 0, "expected": "[watch] := stopwatch(73s)", "module": "timers", "event": {"name": "watch", "action": "resume"}}] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "cli": ["render", "alias.x.md", "--format", "text"] },
    {
      "lsp": [
        { "open": "alias.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "alias.x.md" },
        { "request": "textDocument/codeLens", "file": "alias.x.md" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "xmd.row", "arguments": [{"kind": "row", "document": "${uri:shared.x.md}", "row": 0, "expected": "[focus] := countdown(25m)", "module": "timers", "event": {"name": "focus", "action": "start"}}] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "read": ["idle.x.md", "running.x.md", "paused.x.md", "shared.x.md"] }
  ]
}
