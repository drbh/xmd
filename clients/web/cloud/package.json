{
  "name": "xmd-docs-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "make -C ../../.. cloud",
    "dev": "make -C ../../.. cloud WASM_PREBUILT=1 && wrangler dev --var DEV_AUTH:1 --port 8788",
    "migrate": "wrangler d1 migrations apply xmd-docs --remote",
    "migrate:local": "wrangler d1 migrations apply xmd-docs --local",
    "deploy": "make -C ../../.. cloud && wrangler d1 migrations apply xmd-docs --remote && wrangler deploy",
    "test": "node --test --test-concurrency=1 test/*.test.mjs && npx playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "partyserver": "^0.5.10",
    "y-indexeddb": "^9.0.12",
    "y-partyserver": "^2.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "overrides": {
    "@cloudflare/workers-types": "$@cloudflare/workers-types"
  }
}
