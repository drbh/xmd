### 0 cli render main.x.md --format text
$ xmd render main.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 0
--- stdout
# Branching

score := 72 = 72
state := "paused" = paused

grade := if(score >= 90, "A", score >= 80, "B", score >= 70, "C", "F") = C
icon := match(state, "running", "▸", "paused", "‖", "done", "✓", "○") = ‖

Grade [grade] C, icon [icon] ‖.

