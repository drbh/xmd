          }
        },
        {
          "method": "query",
          "params": { "query": "map(filter(values, fn(r) => r.name == \"total\"), fn(r) => {name: r.name, value: r.value, source: r.source})" }
        }
      ]
    },
    {
      "cli": [
        "query",
        "--workspace",
        "map(filter(values, fn(r) => r.name == \"total\"), fn(r) => {name: r.name, value: r.value, source: r.source})",
