### 2 cli render dates.x.md --format text
$ xmd render dates.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 1
--- stdout
# Date builtins

date_ok := import("probe").date("16/09/2026", "%d/%m/%Y") = 2026-09-16
date_miss := import("probe").date("31/02/2026", "%d/%m/%Y") = null
date_bad := import("probe").date(20260916, "%Y%m%d")
stamp_ok := import("probe").datetime("2026-09-16 09:30", "%Y-%m-%d %H:%M", now()) = 2026-09-16 09:30:00 -04:00
stamp_miss := import("probe").datetime("2026-09-16", "%Y-%m-%d %H:%M", now()) = null
stamp_bad := import("probe").datetime("2026-09-16 09:30", "%Y-%m-%d %H:%M", 2026-09-16)
time_ok := import("probe").time("09:30", "%H:%M") = 570m
time_miss := import("probe").time("25:00", "%H:%M") = null
time_bad := import("probe").time(930, "%H%M")
duration_ok := import("probe").duration("90m") = 90m
duration_spaced := import("probe").duration("1h 30m") = null
duration_miss := import("probe").duration("soon") = null
duration_bad := import("probe").duration(90)
made_date := import("probe").make(2026, 9, 16) = 2026-09-16
made_leap := import("probe").make(2026, 2, 29) = null
made_month := import("probe").make(2026, 13, 1) = null
made_fraction := import("probe").make(2026, 1.5, 1) = null
made_bad := import("probe").make("2026", 1, 1)
parts_date := import("probe").parts(2026-09-16) = {"day": 16, "month": 9, "weekday": 2, "year": 2026}
parts_stamp := import("probe").parts(2026-09-16T23:30:00-04:00) = {"day": 16, "month": 9, "weekday": 2, "year": 2026}
parts_bad := import("probe").parts("2026-09-16")
at := import("probe").at(2026-09-16, 90m, now()) = 2026-09-16 01:30:00 -04:00
at_end := import("probe").at(2026-09-16, 86399s, now()) = 2026-09-16 23:59:59 -04:00
at_day := import("probe").at(2026-09-16, 24h, now())
at_negative := import("probe").at(2026-09-16, -1s, now())
at_edge := import("probe").at(import("probe").make(262142, 12, 31), 23h, now())
at_bad := import("probe").at(2026-09-16, 90m, 2026-09-16)
split_time := import("probe").split_duration(12307s) = {"hours": 3, "minutes": 25, "seconds": 7}
split_negative := import("probe").split_duration(-90s) = {"hours": 0, "minutes": -1, "seconds": -30}
split_bad := import("probe").split_duration(5)
note_tier := parse_date("2026-09-16", "%F")
