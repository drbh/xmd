### 0 cli render text.x.md --format text
$ xmd render text.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 1
--- stdout
# Text builtins

lowered := lower("MiXeD") = mixed
uppered := upper("MiXeD") = MIXED
lower_bad := lower(1)
replaced := replace("a-b-c", "-", "+") = a+b+c
replace_limit := replace(repeat("a", 8192), "a", repeat("b", 200))
split_ok := split("a,b,,c", ",") = ["a", "b", "", "c"]
split_limit := split(repeat(",", 8192), ",")
split_bad := split("a", 1)
starts := starts_with("xmd notes", "xmd") = true
starts_no := starts_with("xmd notes", "notes") = false
starts_bad := starts_with(1, "x")
ends := ends_with("xmd notes", "notes") = true
ends_bad := ends_with("x", null)
padded_start := pad_start("7", 3, "0") = 007
padded_end := pad_end("ab", 5, ".") = ab...
padded_wide := pad_start("long", 2, "0") = long
pad_fill := pad_start("7", 3, "00")
pad_width := pad_end("7", -1, "0")
pad_limit := pad_start("7", 9000, "0")
pad_bad := pad_end(7, 3, "0")
encoded := import("probe").encode("a b&c=d/é") = a+b%26c%3Dd%2F%C3%A9
encode_bad := import("probe").encode(3)
encode_note := url_encode("a b")
