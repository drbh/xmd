### 1 cli render values.x.md --format text
$ xmd render values.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 1
--- stdout
# Value builtins

made := object([{key: "b", value: 2}, {key: "a", value: [1, 2]}]) = {"a": [1, 2], "b": 2}
made_empty := object([]) = {}
object_row := object([1])
object_key := object([{key: 1, value: 2}])
object_value := object([{key: "a"}])
object_duplicate := object([{key: "a", value: 1}, {key: "a", value: 2}])
object_bad := object({key: "a", value: 1})
listed := entries({b: 2, a: "x"}) = [{"key": "a", "value": "x"}, {"key": "b", "value": 2}]
entries_bad := entries([1])
as_number := number($12.50) = 12.5
number_duration := number(90s) = 90
number_bool := number(true) = 1
number_ratio := number(25%) = 0.25
number_bad := number("12")
kind_number := type(1) = Number
kind_text := type("x") = Text
kind_money := type($1) = Money
kind_list := type([1]) = List
kind_null := type(null) = Null
floored := floor(2.7) = 2
floored_ratio := floor(250%) = 2
rounded := round(2.5) = 3
rounded_negative := round(-2.5) = -3
floor_bad := floor($2.70)
round_bad := round("2")
first := coalesce(null, null, 3, 4) = 3
nothing := coalesce(null) = null
empty := coalesce() = null
lazy := coalesce(1, error("never evaluated")) = 1
merged := import("probe").merge("a\nb\nc\nd\n", "A\nb\nc\nd\n", "a\nb\nc\nD\n") = {"clean": true, "text": "A\nb\nc\nD\n"}
conflict := import("probe").merge("a\n", "b\n", "c\n") = {"clean": false, "text": "<<<<<<< ours\nb\n||||||| original\na\n=======\nc\n>>>>>>> theirs\n"}
same := import("probe").merge("a\n", "z\n", "z\n") = {"clean": true, "text": "z\n"}
merge_bad := import("probe").merge("a", "b", 3)
solver := import("probe").solve({goal: "minimize", variables: {x: {kind: "continuous", lower: 2}}, objective: {constant: 0, terms: {x: 1}}, constraints: []}) = {"status": "optimal", "values": {"x": 2}}
solver_note := solve_linear({})

## Chores :chores ███░░░░░ 1/3 complete

- [x] Sweep
- [ ] Mop
- [ ] Dust

left := remaining(chores) = 2
left_bad := remaining(3)
