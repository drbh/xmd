{
  "steps": [
    {
      "lsp": [
        {
          "open": "note.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "note.x.md"
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": []
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "row",
                "document": "${uri:note.x.md}",
                "row": 0,
                "expected": "- [ ] Task",
                "module": "tasks",
                "event": {"line": 0}
              },
              "extra"
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "show_today"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "explode",
                "document": "${uri:note.x.md}"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "row",
                "document": "${uri:note.x.md}",
                "row": 0,
                "module": "tasks",
                "event": {"line": 0}
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "row",
                "document": "${uri:note.x.md}",
                "row": -1,
                "expected": "- [ ] Task",
                "module": "tasks",
                "event": {"line": -1}
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "row",
                "document": "${uri:note.x.md}",
                "row": "0",
                "expected": "- [ ] Task",
                "module": "tasks",
                "event": {"line": "0"}
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "row",
                "document": "https://example.com",
                "row": 0,
                "expected": "- [ ] Task",
                "module": "tasks",
                "event": {"line": 0}
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [
              {
                "kind": "row",
                "document": "file:///workspace/note.x.md#L1",
                "row": 0,
                "expected": "- [ ] Task",
                "module": "tasks",
                "event": {"line": 0}
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [{"kind": "row", "document": "${uri:note.x.md}", "row": 0, "expected": "- [ ] Task", "module": "timers", "event": {"name": "focus", "action": "explode"}}]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.row",
            "arguments": [{"kind": "row", "document": "${uri:note.x.md}", "row": 0, "expected": "- [ ] Task", "module": "timers", "event": {"name": 12, "action": "start"}}]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.openResource",
            "arguments": [
              {
                "kind": "open_resource",
                "target": {
                  "document": "${uri:note.x.md}",
                  "row": 0,
                  "expected": "- [ ] Task"
                },
                "url": "not a URL"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.openResource",
            "arguments": [
              {
                "kind": "refresh_resource",
                "target": {
                  "document": "${uri:note.x.md}",
                  "row": 0,
                  "expected": "- [ ] Task"
                },
                "url": "https://example.com"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.refresh",
            "arguments": [
              {
                "kind": "refresh",
                "document": "${uri:note.x.md}"
              },
              "extra"
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.today",
            "arguments": [
              "${uri:note.x.md}"
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.applyEdits",
            "arguments": [
              {
                "kind": "row",
                "document": "${uri:note.x.md}",
                "row": 0,
                "expected": "- [ ] Task",
                "module": "tasks",
                "event": {"line": 0}
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.applyEdits",
            "arguments": [
              {
                "kind": "edit"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "unknown",
            "arguments": []
          }
        }
      ]
    },
    {
      "read": [
        ".xmd/cache.json",
        "note.x.md"
      ]
    }
  ]
}
