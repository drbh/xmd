{
  "steps": [
    { "cli": ["render", "markers.x.md", "--format", "text"] },
    {
      "cli": [
        "query",
        "markers.x.md",
        "map(get(days, 0).value.stops, fn(s) => {line: s.line, title: s.title, kind: s.kind})",
        "--json"
      ]
    },
    { "cli": ["query", "markers.x.md", "map(stops, fn(r) => {title: r.title, line: r.line, at_date: r.at_date})", "--json"] },
    { "cli": ["query", "markers.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    {
      "lsp": [
        { "open": "markers.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "markers.x.md" },
        {
          "request": "textDocument/formatting",
          "file": "markers.x.md",
          "extra": { "options": { "tabSize": 2, "insertSpaces": true } },
          "apply": true
        }
      ]
    },
    { "cli": ["query", "carry.x.md", "map(stops, fn(r) => {title: r.title, at_date: r.at_date})", "--json"] },
    { "cli": ["query", "past.x.md", "map(stops, fn(r) => {title: r.title, at_date: r.at_date})", "--json"] },
    { "cli": ["query", "prose.x.md", "map(days, fn(r) => {title: r.title, line: r.line})", "--json"] },
    { "cli": ["query", "bad.x.md", "map(diagnostics, fn(r) => {line: r.line, severity: r.severity, code: r.code, message: r.message})", "--json"] },
    {
      "lsp": [
        { "open": "complete.x.md" },
        { "request": "textDocument/completion", "file": "complete.x.md", "line": 2, "character": 11 },
        { "request": "textDocument/completion", "file": "complete.x.md", "line": 5, "character": 2 }
      ]
    }
  ]
}
