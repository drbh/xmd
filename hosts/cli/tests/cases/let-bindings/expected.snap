### 0 cli render main.x.md --format text
$ xmd render main.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 0
--- stdout
# Let

price := $19.99 = $19.99
x := 100 = 100

subtotal := let({each: price, count: 3}, each * count) = $59.97
shadowed := let({x: 1}, x + 1) = 2
nested := map([1, 2], fn(n) => let({sq: n * n}, let({cube: sq * n}, [n, sq, cube]))) = [[1, 1, 1], [2, 4, 8]]
helper := let({inc: fn(n) => n + 1, twice: fn(n) => inc(inc(n))}, twice(x)) = 102

Subtotal [subtotal] $59.97, shadowed [shadowed] 2, helper [helper] 102.

### 1 cli query main.x.md nested --json
$ xmd query main.x.md nested --json --root <root> --now 2026-09-16T14:00:00-04:00
exit 0
--- stdout
[
  [
    1,
    1,
    1
  ],
  [
    2,
    4,
    8
  ]
]

