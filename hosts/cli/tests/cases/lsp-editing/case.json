{
  "steps": [
    {
      "lsp": [
        {
          "open": "links.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "links.x.md"
        },
        {
          "request": "textDocument/documentLink",
          "file": "links.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "links.x.md",
          "line": 0,
          "character": 4
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "links.x.md"
        },
        {
          "change": {
            "file": "links.x.md",
            "text": "\ud83e\udd80 ./other.x.md\n[focus] := $3.30\n- [x] Interview 09/17/2026 at 7AM\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "links.x.md"
        },
        {
          "request": "textDocument/documentLink",
          "file": "links.x.md"
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "links.x.md"
        },
        {
          "open": "symbols.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "symbols.x.md"
        },
        {
          "request": "textDocument/documentSymbol",
          "file": "symbols.x.md"
        },
        {
          "change": {
            "file": "symbols.x.md",
            "text": "# Trip\n[$3,000]:budget\n## Cash\n[remaining] := budget - $1,410\n- [ ] Pack :pack\n  - [x] Passport\n[timer] := countdown(25m)\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "symbols.x.md"
        },
        {
          "request": "textDocument/documentSymbol",
          "file": "symbols.x.md"
        },
        {
          "open": "prose.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "prose.x.md"
        },
        {
          "request": "textDocument/inlayHint",
          "file": "prose.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 200,
              "character": 0
            }
          }
        },
        {
          "change": {
            "file": "prose.x.md",
            "text": "# Trip\n\nOur budget is [$3,000]:trip_budget.\n\nWe've spent [$1,410]:trip_spent.\n\n[trip_left] := trip_budget - trip_spent\n\nWe have [trip_left] remaining.\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "prose.x.md"
        },
        {
          "request": "textDocument/inlayHint",
          "file": "prose.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 200,
              "character": 0
            }
          }
        }
      ]
    },
    {
      "read": [
        "links.x.md",
        "symbols.x.md",
        "prose.x.md"
      ]
    },
    {
      "lsp": [
        {
          "open": "flat.x.md"
        },
        {
          "request": "textDocument/documentSymbol",
          "file": "flat.x.md"
        }
      ],
      "capabilities": {}
    },
    {
      "cli": [
        "query",
        "--workspace",
        "sort_by(map(notes, fn(r) => {title: r.title}), fn(r) => r.title)",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "ignored/TODOS.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "ignored/TODOS.x.md"
        },
        {
          "request": "textDocument/inlayHint",
          "file": "ignored/TODOS.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 200,
              "character": 0
            }
          }
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "ignored/TODOS.x.md"
        },
        {
          "change": {
            "file": "ignored/TODOS.x.md",
            "text": "# Notes\n\n## Checklist :launch\n\n- [x] First @estimate(20m)\n- [X] Finished\n\ndone := completed(launch)\nleft := remaining(launch)\nwork := effort(launch)\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "ignored/TODOS.x.md"
        },
        {
          "request": "textDocument/inlayHint",
          "file": "ignored/TODOS.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 200,
              "character": 0
            }
          }
        },
        {
          "notify": "workspace/didChangeWatchedFiles",
          "params": {
            "changes": [
              {
                "uri": "${uri:ignored/TODOS.x.md}",
                "type": 2
              }
            ]
          }
        },
        {
          "request": "textDocument/inlayHint",
          "file": "ignored/TODOS.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 200,
              "character": 0
            }
          }
        }
      ]
    }
  ]
}
