{
  "steps": [
    {
      "cli": [
        "query",
        "plan.x.md",
        "map(tasks, fn(r) => {title: r.title, done: r.done, checked: r.checked, in_progress: r.in_progress})",
        "--json"
      ]
    },
    {
      "cli": [
        "ast",
        "plan.x.md",
        "-q",
        "map(filter(ast, fn(r) => r.kind == \"checkbox\"), fn(r) => {text: r.text, state: r.state, checked: r.checked})"
      ]
    },
    {
      "cli": [
        "render",
        "plan.x.md",
        "--format",
        "text"
      ]
    },
    {
      "lsp": [
        {
          "open": "plan.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "plan.x.md"
        },
        {
          "request": "textDocument/semanticTokens/full",
          "file": "plan.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "plan.x.md",
          "line": 3,
          "character": 8
        },
        {
          "request": "textDocument/hover",
          "file": "plan.x.md",
          "line": 4,
          "character": 8
        },
        {
          "request": "textDocument/inlayHint",
          "file": "plan.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 9,
              "character": 0
            }
          }
        },
        {
          "request": "textDocument/codeAction",
          "file": "plan.x.md",
          "range": {
            "start": {
              "line": 3,
              "character": 0
            },
            "end": {
              "line": 3,
              "character": 0
            }
          },
          "extra": {
            "context": {
              "diagnostics": []
            }
          }
        }
      ]
    }
  ]
}
