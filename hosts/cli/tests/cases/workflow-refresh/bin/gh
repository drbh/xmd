#!/bin/sh
if [ "${XMD_TEST_FAIL:-}" = 1 ]; then printf '%s\n' 'fixture failure' >&2; exit 1; fi
case "$*" in
  "pr view 42"*)
    printf '%s' '{"title":"Fixture PR","state":"MERGED","mergedAt":"2026-09-16T12:00:00Z","reviewDecision":"APPROVED","statusCheckRollup":[{"conclusion":"SUCCESS"}]}' ;;
  *) echo "unexpected gh invocation: $*" >&2; exit 1 ;;
esac
