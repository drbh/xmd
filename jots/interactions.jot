Lunch budget: $25 today.

<!-- Select 3 * 4, then use Extract named calculation. -->
[demo_total] := 2 + 3 * 4

<!-- On demo_cash below, try Inline expression or Freeze current value. -->
[demo_half] := demo_cash / 2

