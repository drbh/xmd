{
  "steps": [
    { "cli": ["render", "markers.x.md", "--format", "text"] },
    {
      "cli": [
        "query",
        "markers.x.md",
        "map(get(days, 0).value.stops, fn(s) => {line: s.line, title: s.title, kind: s.kind})",
        "--json"
      ]
    },
    { "cli": ["query", "markers.x.md", "stops | select {title, line, at_date}", "--json"] },
    { "cli": ["query", "markers.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    {
      "lsp": [
        { "open": "markers.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "markers.x.md" },
        {
          "request": "textDocument/formatting",
          "file": "markers.x.md",
          "extra": { "options": { "tabSize": 2, "insertSpaces": true } },
          "apply": true
        }
      ]
    },
    { "cli": ["query", "carry.x.md", "stops | select {title, at_date}", "--json"] },
    { "cli": ["query", "past.x.md", "stops | select {title, at_date}", "--json"] },
    { "cli": ["query", "prose.x.md", "days | select {title, line}", "--json"] },
    { "cli": ["query", "bad.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    {
      "lsp": [
        { "open": "complete.x.md" },
        { "request": "textDocument/completion", "file": "complete.x.md", "line": 2, "character": 11 },
        { "request": "textDocument/completion", "file": "complete.x.md", "line": 5, "character": 2 }
      ]
    }
  ]
}
