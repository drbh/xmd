// Unit conversion is ordinary pure arithmetic over named factor tables.
module := {api: 1, id: "units", kind: "library", inputs: []}

// Spelled-out unit names map onto the short canonical symbols.
aliases := {
  celsius: "c",
  centigrade: "c",
  fahrenheit: "f",
  kelvin: "k",
  millimeters: "mm",
  millimetres: "mm",
  centimeters: "cm",
  centimetres: "cm",
  meters: "m",
  metres: "m",
  kilometers: "km",
  kilometres: "km",
  inches: "in",
  feet: "ft",
  yards: "yd",
  miles: "mi",
  grams: "g",
  kilograms: "kg",
  ounces: "oz",
  pounds: "lb",
  lbs: "lb",
  milliliters: "ml",
  millilitres: "ml",
  liters: "l",
  litres: "l",
  teaspoons: "tsp",
  tablespoons: "tbsp",
  cups: "cup",
  pints: "pt",
  quarts: "qt",
  gallons: "gal",
  knots: "knot",
  hectares: "ha",
  acres: "acre",
  bytes: "b",
  kilobytes: "kb",
  megabytes: "mb",
  gigabytes: "gb",
  terabytes: "tb"
}

// Each dimension converts through one base unit: m, g, ml, m/s, m², or bytes.
tables := {
  distance: {
    mm: 0.001,
    cm: 0.01,
    m: 1,
    km: 1000,
    in: 0.0254,
    ft: 0.3048,
    yd: 0.9144,
    mi: 1609.344
  },
  mass: {g: 1, kg: 1000, oz: 28.349523125, lb: 453.59237},
  volume: {
    ml: 1,
    l: 1000,
    tsp: 4.92892159375,
    tbsp: 14.78676478125,
    cup: 236.5882365,
    floz: 29.5735295625,
    pt: 473.176473,
    qt: 946.352946,
    gal: 3785.411784
  },
  speed: {mps: 1, kph: 0.2777777777777778, mph: 0.44704, knot: 0.5144444444444445},
  area: {sqm: 1, sqkm: 1000000, sqft: 0.09290304, acre: 4046.8564224, ha: 10000},
  data: {b: 1, kb: 1000, mb: 1000000, gb: 1000000000, tb: 1000000000000}
}

// Temperatures are offsets rather than factors, so they convert separately.
temperatures := ["c", "f", "k"]

// Accept aliases and surrounding space, and keep units lowercase.
canonical := fn(unit) => (
  if(
    type(unit) != "Text",
    error("Units must be text, e.g. convert(100, \"km\", \"mi\")"),
    coalesce(get(aliases, lower(trim(unit))), lower(trim(unit)))
  )
)

// Search the factor tables for the dimension that declares this unit.
lookup := fn(unit) => (
  get(
    fold(
      entries(tables),
      {name: null},
      fn(found, table) => if(get(table.value, unit) == null, found, {name: table.key})
    ),
    "name"
  )
)

// Name the dimension a unit belongs to, or report that it is unknown.
dimension := fn(unit) => (
  if(
    contains(temperatures, canonical(unit)),
    "temperature",
    coalesce(
      lookup(canonical(unit)),
      error("Unknown unit '" + canonical(unit) + "'")
    )
  )
)

// Read the unit's factor towards the base unit of its dimension.
factor := fn(unit) => (
  get(get(tables, dimension(unit)), canonical(unit))
)

// Kelvin is the pivot for every temperature scale.
to_kelvin := fn(value, unit) => (
  if(unit == "k", value, if(unit == "c", value + 273.15, (value - 32) * 5 / 9 + 273.15))
)

// Convert back out of kelvin into the requested scale.
from_kelvin := fn(value, unit) => (
  if(unit == "k", value, if(unit == "c", value - 273.15, (value - 273.15) * 9 / 5 + 32))
)

// Convert between two units of the same dimension, e.g. convert(100, "km", "mi").
convert := fn(value, from, to) => (
  if(
    dimension(from) != dimension(to),
    error("Cannot convert " + canonical(from) + " to " + canonical(to)),
    if(
      dimension(from) == "temperature",
      from_kelvin(to_kelvin(value, canonical(from)), canonical(to)),
      value * factor(from) / factor(to)
    )
  )
)

// Round to two decimals and append the canonical unit for display.
format := fn(value, unit) => (
  text(round(value * 100) / 100) + " " + canonical(unit)
)

// Convert and format in one step.
show := fn(value, from, to) => (
  format(convert(value, from, to), to)
)

// Common pairs, spelled out for notes that prefer a named function.
c_to_f := fn(value) => convert(value, "c", "f")
f_to_c := fn(value) => convert(value, "f", "c")
km_to_mi := fn(value) => convert(value, "km", "mi")
mi_to_km := fn(value) => convert(value, "mi", "km")
kg_to_lb := fn(value) => convert(value, "kg", "lb")
lb_to_kg := fn(value) => convert(value, "lb", "kg")
