{
  "now": "2026-09-17T14:00:00+00:00",
  "steps": [
    {
      "cli": [
        "query",
        "weather.x.md",
        "diagnostics | select {line, severity, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "errors.x.md",
        "diagnostics | select {line, message}",
        "--json"
      ]
    },
    {
      "lsp": [
        {
          "open": "weather.x.md"
        },
        {
          "request": "textDocument/codeLens",
          "file": "weather.x.md"
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "wtf.refresh",
            "arguments": [
              {
                "kind": "refresh",
                "document": "${uri:weather.x.md}"
              }
            ]
          }
        },
        {
          "await": "window/showMessage"
        },
        {
          "request": "textDocument/inlayHint",
          "file": "weather.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 6,
              "character": 0
            }
          }
        }
      ]
    },
    {
      "read": [
        ".wtf/lookups.json"
      ]
    },
    {
      "cli": [
        "render",
        "weather.x.md",
        "--format",
        "text"
      ]
    }
  ]
}
