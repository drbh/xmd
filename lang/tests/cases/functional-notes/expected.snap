### 12 cli render errors.x.md --format text
$ wtf render errors.x.md --format text --root <root> --now 2026-09-18T12:00:00Z
exit 1
--- stdout
rate := 2 = 2
bad := fn(x) => (
  // A Unicode prefix must not move the error.
  length("🦀") + x / 0
) = <function>
result := (
  rate + bad(1)
)
--- stderr
<root>/errors.x.md:4:22: error: Division by zero (Number / Number)
wtf: 1 error(s) while rendering

