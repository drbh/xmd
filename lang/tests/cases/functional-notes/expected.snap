### 0 cli render multiline.x.md --format text
$ wtf render multiline.x.md --format text --root <root> --now 2026-09-18T12:00:00Z
exit 0
--- stdout
// The closure keeps its defining scope.
rate := 10% = 10%
with_tax := fn(
  cost
) => (
  // Only this branch is evaluated.
  if(
    cost > $0,
    cost + cost * rate,
    $0
  )
) = <function>
result := fold(
  map([$2, $3], with_tax),
  $0,
  fn(total, price) => total + price
) = $5.50
config := {
  title: "https://example.com/)", // Delimiters here are data.
  values: [
    1,
    2
  ]
} = {"title": "https://example.com/)", "values": [1, 2]}
add := fn(x) =>
  fn(y) => x + y = <function>

