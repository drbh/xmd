{
  "steps": [
    {
      "cli": [
        "query",
        "types.x.md",
        "diagnostics | select {line, severity, code, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "syntax.x.md",
        "diagnostics | select {line, code, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "clock.x.md",
        "diagnostics | select {line, message}",
        "--json"
      ]
    },
    {
      "cli": [
        "query",
        "clock.x.md",
        "diagnostics | select {line, message}",
        "--json",
        "--now",
        "2026-09-16T14:00:01-04:00"
      ]
    },
    {
      "lsp": [
        {
          "open": "types.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "types.x.md"
        },
        {
          "open": "syntax.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "syntax.x.md"
        },
        {
          "open": "cycles.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "cycles.x.md"
        },
        {
          "open": "ambiguous.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "ambiguous.x.md"
        },
        {
          "open": "tasks.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "tasks.x.md"
        }
      ]
    }
  ]
