### 0 cli render trip.wtf --format text
$ wtf render trip.wtf --format text --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
## Friday, November 20, 2026 · New York | Oaxaca 1 stops · 07:04 AM – 07:04 AM · in 64 days · 24°C / 12°C · light rain · 40% rain

07:04 AM  > Depart JFK

## Saturday, November 21 · Oaxaca 0 stops · in 65 days · 25°C / 14°C · seasonal outlook (estimate) · 50% rain

[weather] := forecast("Oaxaca", 2026-11-20, F) = 76°F / 53°F · light rain · 40% rain
[rain] := weather.rain = 40%
[celsius] := forecast("Oaxaca", 2026-11-20) = 24°C / 12°C · light rain · 40% rain
[later] := forecast("Oaxaca", 2026-11-21) = 25°C / 14°C · seasonal outlook (estimate) · 50% rain
[pack_rain_jacket] := later.rain > 30% = true

### 1 cli query trip.wtf map(days, fn(d) => {line: d.line, places: d.value.places, forecast: d.value.forecast}) --json
$ wtf query trip.wtf map(days, fn(d) => {line: d.line, places: d.value.places, forecast: d.value.forecast}) --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[
  {
    "forecast": {
      "display": "24°C / 12°C · light rain · 40% rain",
      "fetched_at": {
        "type": "datetime",
        "value": "2026-09-17T12:00:00+00:00"
      },
      "place": "Oaxaca",
      "source": "open-meteo.com"
    },
    "line": 0,
    "places": "New York | Oaxaca"
  },
  {
    "forecast": {
      "display": "25°C / 14°C · seasonal outlook (estimate) · 50% rain",
      "fetched_at": {
        "type": "datetime",
        "value": "2026-09-17T12:00:00+00:00"
      },
      "place": "Oaxaca",
      "source": "open-meteo.com (seasonal ensemble)"
    },
    "line": 4,
    "places": "Oaxaca"
  }
]

### 2 cli query trip.wtf values | select {name, display} --json
$ wtf query trip.wtf values | select {name, display} --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[
  {
    "display": "76°F / 53°F · light rain · 40% rain",
    "name": "weather"
  },
  {
    "display": "40%",
    "name": "rain"
  },
  {
    "display": "24°C / 12°C · light rain · 40% rain",
    "name": "celsius"
  },
  {
    "display": "25°C / 14°C · seasonal outlook (estimate) · 50% rain",
    "name": "later"
  },
  {
    "display": "true",
    "name": "pack_rain_jacket"
  }
]

### 3 cli query trip.wtf diagnostics | select {line, severity, code, message} --json
$ wtf query trip.wtf diagnostics | select {line, severity, code, message} --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[]

