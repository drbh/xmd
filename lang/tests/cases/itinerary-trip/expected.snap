$ wtf query trip.wtf map(days, fn(d) => {line: d.line, month: d.value.month, day: d.value.day, year: d.value.year, places: d.value.places, stops: length(d.value.stops)}) --json --root <root> --now 2026-09-16T14:00:00-04:00
