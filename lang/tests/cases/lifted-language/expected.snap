### 0 cli render solver.x.md --format text
$ wtf render solver.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 0
--- stdout
optimal := import("lifted").solve({goal: "maximize", variables: {x: {kind: "integer", lower: 0, upper: 2.8}}, objective: {constant: 0, terms: {x: 1}}, constraints: []}) = {"status": "optimal", "values": {"x": 2}}
unbounded := import("lifted").solve({goal: "maximize", variables: {x: {kind: "continuous", lower: 0}}, objective: {constant: 0, terms: {x: 1}}, constraints: []}) = {"status": "unbounded"}
infeasible := import("lifted").solve({goal: "maximize", variables: {x: {kind: "integer", lower: 0, upper: 2.8}}, objective: {constant: 0, terms: {x: 1}}, constraints: [{lhs: {constant: 0, terms: {x: 1}}, op: ">=", rhs: {constant: 5, terms: {}}}]}) = {"status": "infeasible"}

