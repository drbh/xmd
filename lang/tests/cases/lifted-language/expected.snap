### 2 cli render badmodels.x.md --format text
$ wtf render badmodels.x.md --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 1
--- stdout
bad_0 := import("lifted").solve({goal: "maximize", variables: {x: {kind: "integer", lower: 5, upper: 2.8}}, objective: {constant: 0, terms: {x: 1}}, constraints: []})
bad_1 := import("lifted").solve({goal: "maximize", variables: {x: {kind: "integer", lower: 0, upper: 2.8}}, objective: {constant: 0, terms: {missing: 1}}, constraints: []})
bad_2 := import("lifted").solve({goal: "maximize", variables: {x: {kind: "imaginary", lower: 0, upper: 2.8}}, objective: {constant: 0, terms: {x: 1}}, constraints: []})
bad_3 := import("lifted").solve({goal: "guess", variables: {x: {kind: "integer", lower: 0, upper: 2.8}}, objective: {constant: 0, terms: {x: 1}}, constraints: []})
bad_4 := import("lifted").solve({goal: "maximize", variables: {x: {kind: "integer", lower: 0, upper: 2.8}}, objective: {constant: 0, terms: {x: 1}}, constraints: [], order: ["x", "x"]})
