    "source": "frankfurter.dev"
  }
}

### 3 cli render trip.wtf --format text
$ wtf render trip.wtf --format text --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[€450]:hotel
[usd] := to(hotel, USD) = $490.50
[nvda] := quote(NVDA) = €42.50

## Friday, November 20, 2026 · Oaxaca 0 stops · in 64 days · 24°C / 12°C · light rain · 40% rain

## Saturday, December 5, 2026 · Oaxaca 0 stops · in 79 days · no forecast yet; forecasts cover about 16 days

### 4 cli query trip.wtf values | select {name, display} --json
$ wtf query trip.wtf values | select {name, display} --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[
  {
    "display": "€450",
    "name": "hotel"
  },
  {
    "display": "$490.50",
    "name": "usd"
  },
  {
    "display": "€42.50",
    "name": "nvda"
  }
]

### 5 cli query --workspace diagnostics | where severity == "error" --fail-on-match
$ wtf query --workspace diagnostics | where severity == "error" --fail-on-match --root <root> --now 2026-09-17T14:00:00+00:00
exit 0

