### 0 cli query trip.wtf diagnostics | select {line, severity, code, message} --json
$ wtf query trip.wtf diagnostics | select {line, severity, code, message} --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[
  {
    "code": "evaluation",
    "line": 1,
    "message": "No cached rate EUR→USD; run wtf refresh or use the ⟳ lookups lens",
    "severity": "warning"
  },
  {
    "code": "evaluation",
    "line": 2,
    "message": "No cached quote for NVDA; run wtf refresh or use the ⟳ lookups lens",
    "severity": "warning"
  }
]

### 1 cli refresh
$ wtf refresh --root <root>
exit 0
--- stdout
Resource cache updated (0 resources)

### 2 read .wtf/lookups.json
-- .wtf/lookups.json
{
  "forecast:oaxaca:2026-11-20": {
    "value": {
      "high": 24.2,
      "low": 11.8,
      "place": "Oaxaca",
