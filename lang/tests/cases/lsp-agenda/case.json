{
  "steps": [
    {
      "lsp": [
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.today",
            "arguments": [
              {
                "kind": "show_today"
              }
            ]
          }
        },
        {
          "await": "window/showDocument"
        }
      ]
    },
    {
      "read": [
        ".xmd/today.md"
      ]
    },
    {
      "lsp": [
        {
          "write": {
            "file": ".xmd/modules/agenda.x.md",
            "text": "module := {api: 1, id: \"agenda\", kind: \"library\", inputs: []}\nbetween := fn(entries, first, last) => filter(entries, fn(e) => e.done)\n"
          }
        },
        {
          "write": {
            "file": ".xmd/modules.json",
            "text": "[\"./modules/agenda.x.md\"]\n"
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.today",
            "arguments": [
              {
                "kind": "show_today"
              }
            ]
          }
        },
        {
          "await": "window/showDocument"
        },
        {
          "query": {
            "query": "map(import(\"agenda\").between(entries, today(), today()), fn(e) => e.title)"
          }
        }
      ]
    },
    {
      "read": [
        ".xmd/today.md"
      ]
    }
  ]
}
