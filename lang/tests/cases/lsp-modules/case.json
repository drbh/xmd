          "request": "textDocument/codeLens",
          "file": "main2.wtf"
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "wtf.applyEdits",
            "arguments": [
              {
                "kind": "edit",
                "document": "${uri:main2.wtf}",
                "expected": "Hello world\n",
                "edits": [
