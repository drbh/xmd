                    "range": {
                      "start": {
                        "line": 0,
                        "character": 0
                      },
                      "end": {
                        "line": 0,
                        "character": 5
                      }
                    },
                    "newText": "Goodbye"
                  }
                ]
              }
            ]
          }
        },
        {
          "await": "workspace/applyEdit"
        },
        {
          "change": {
            "file": "main2.wtf",
            "text": "Goodbye world\n"
          }
        },
