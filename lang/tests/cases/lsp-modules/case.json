            "file": ".wtf/modules/edit.wtf",
            "text": "module := {api: 1, id: \"edit\", kind: \"feature\", inputs: []}\nactions := fn(ctx) => if(ctx.row == 0, [{title: \"Greeting\", action: {kind: \"edit\", document: ctx.document.uri, expected: ctx.document.text, edits: [{range: {start: {line: 0, character: 0}, end: {line: 0, character: 5}}, newText: \"Goodbye\"}]}}], [])\n"
