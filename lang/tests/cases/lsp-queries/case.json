{
  "steps": [
    {
      "lsp": [
        {
          "open": "n.x.md"
        },
        {
          "change": {
            "file": "n.x.md",
            "text": "$9:price\n- [ ] Unsaved\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "n.x.md"
        },
        {
          "query": {
            "query": "values | select {name, value, day:today(), clock:now()}"
          }
        },
        {
          "query": {
            "query": "tasks | where leaf && !done | sort source.path, source.line | select title"
          }
        },
        {
          "change": {
            "file": "n.x.md",
            "text": "$12:price\n- [x] Finished\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "n.x.md"
        },
        {
          "query": {
            "query": "tasks | where leaf && !done | sort source.path, source.line"
          }
        },
        {
          "request": "xmd/query",
          "params": {
            "query": "tasks | where ("
          }
        }
      ]
    },
    {
      "read": [
        "n.x.md"
      ]
    },
    {
      "lsp": [
        {
          "open": "one.x.md"
        },
        {
          "change": {
            "file": "one.x.md",
