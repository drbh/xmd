          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "one.x.md"
        },
        {
          "query": {
            "query": "map(filter(ast, fn(n) => n.kind == \"definition\"), fn(n) => n.name)",
            "uri": "one.x.md"
          }
        },
        {
          "query": {
            "query": "tasks | select title",
            "uri": "one.x.md"
          }
        },
        {
          "query": {
            "query": "length(tasks)"
          }
        },
        {
          "query": {
            "query": "graph.nodes | where external | select name",
            "uri": "one.x.md"
          }
        },
        {
          "request": "xmd/query",
          "params": {
            "uri": "https://example.com/n.x.md",
            "query": "ast"
          }
        },
        {
          "request": "xmd/query",
          "params": {
            "uri": "${uri:missing.x.md}",
            "query": "ast"
          }
        }
      ]
    },
    {
      "lsp": [
        {
          "open": "main.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "main.x.md"
        },
        {
          "change": {
            "file": "main.x.md",
            "text": "src := import(\"./.hidden/values.x.md\")\nanswer := src.amount\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "main.x.md"
        },
        {
          "query": {
            "query": "answer",
            "uri": "main.x.md"
          }
        },
        {
          "open": ".hidden/values.x.md"
        },
        {
          "change": {
            "file": ".hidden/values.x.md",
            "text": "amount := 77\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": ".hidden/values.x.md"
        },
        {
          "query": {
            "query": "answer",
            "uri": "main.x.md"
          }
        },
        {
          "close": ".hidden/values.x.md"
        },
        {
          "query": {
            "query": "answer",
            "uri": "main.x.md"
          }
        }
      ]
    },
    {
      "read": [
        "main.x.md",
        ".hidden/values.x.md"
      ]
