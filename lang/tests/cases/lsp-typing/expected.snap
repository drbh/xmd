### 0 lsp
-- initialize
{
  "capabilities": {
    "callHierarchyProvider": true,
    "codeActionProvider": true,
    "codeLensProvider": {
      "resolveProvider": false
    },
    "completionProvider": {
      "triggerCharacters": [
        "[",
        "@",
        "."
      ]
    },
    "definitionProvider": true,
    "documentFormattingProvider": true,
    "documentHighlightProvider": true,
    "documentLinkProvider": {
      "resolveProvider": false
    },
    "documentOnTypeFormattingProvider": {
      "firstTriggerCharacter": "\n",
      "moreTriggerCharacter": [
        "|"
      ]
    },
    "documentSymbolProvider": true,
    "executeCommandProvider": {
      "commands": [
        "wtf.invoke",
        "wtf.applyEdits",
        "wtf.task",
        "wtf.timer",
        "wtf.openResource",
        "wtf.refreshResource",
        "wtf.refresh",
        "wtf.today"
      ]
    },
    "experimental": {
      "wtfQuery": {
        "method": "wtf/query",
        "schemaVersion": 1
      }
    },
    "foldingRangeProvider": true,
    "hoverProvider": true,
    "inlayHintProvider": true,
    "referencesProvider": true,
    "renameProvider": {
      "prepareProvider": true
    },
    "semanticTokensProvider": {
      "full": true,
      "legend": {
        "tokenModifiers": [
          "declaration",
          "defaultLibrary"
        ],
        "tokenTypes": [
          "comment",
          "keyword",
          "number",
          "variable",
          "operator",
          "string",
          "heading",
          "function",
          "property",
          "decorator",
          "wtfMoney",
          "wtfDate",
          "wtfDuration",
          "wtfRatio",
          "wtfBoolean",
          "wtfPunctuation",
          "wtfCode",
          "wtfLink",
          "wtfCheckbox",
          "wtfTaskDone",
          "wtfCheckboxChecked",
          "wtfTime",
          "wtfDay",
          "wtfPlace",
          "wtfDetailKey",
          "wtfDepart",
          "wtfArrive",
          "wtfTransit",
          "wtfStay",
          "wtfMeal",
          "wtfVisit",
          "wtfExplore"
        ]
      }
    },
    "signatureHelpProvider": {
      "retriggerCharacters": [
        ")"
      ],
      "triggerCharacters": [
        "(",
        ","
      ]
    },
    "textDocumentSync": 1,
    "workspaceSymbolProvider": true
  },
  "serverInfo": {
    "name": "WTF",
    "version": "0.1.0"
  }
}
-- open plan.wtf
-- await textDocument/publishDiagnostics plan.wtf
