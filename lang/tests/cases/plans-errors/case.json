{
  "steps": [
    { "cli": ["render", "units.wtf", "--format", "text"] },
    { "cli": ["query", "units.wtf", "plans | select {name, display, solution}", "--json"] },
    { "cli": ["query", "units.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["query", "mixed.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["query", "quadratic.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["query", "strict.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["query", "shape.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["render", "unbounded.wtf", "--format", "text"] },
    { "cli": ["query", "unbounded.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["render", "infeasible.wtf", "--format", "text"] },
    { "cli": ["query", "infeasible.wtf", "diagnostics | select {line, severity, code, message}", "--json"] },
    {
      "lsp": [
        { "open": "unbounded.wtf" },
        { "await": "textDocument/publishDiagnostics", "file": "unbounded.wtf" },
        { "open": "infeasible.wtf" },
        { "await": "textDocument/publishDiagnostics", "file": "infeasible.wtf" },
        { "open": "mixed.wtf" },
        { "await": "textDocument/publishDiagnostics", "file": "mixed.wtf" }
      ]
    }
  ]
}
