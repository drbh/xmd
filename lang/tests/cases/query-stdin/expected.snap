### 0 cli total
$ wtf total
--- stdin
flights := $420.00
hotel := $180.50
total := flights + hotel
exit 0
--- stdout
$600.50

### 1 cli tasks | where !done | select {title} --json
$ wtf tasks | where !done | select {title} --json
--- stdin
- [x] book flights
- [ ] pack
- [ ] print tickets
exit 0
--- stdout
[
  {
    "title": "pack"
  },
  {
    "title": "print tickets"
  }
]

