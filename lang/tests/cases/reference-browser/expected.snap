### 0 browser
-- reference {}
{
  "ok": true,
  "result": {
    "attributes": [
      {
        "documentation": "Associate a named timer with this task. Completion does not stop the timer.",
        "name": "@timer",
        "params": [
          "timer: Timer"
        ],
        "try": "focus := countdown(25m)\n\n- [ ] One focused session @timer(focus)"
      },
      {
        "documentation": "Deadline. Accepts a named date, an expression, or relative input such as tomorrow. Use Freeze relative date to capture it.",
        "name": "@due",
        "params": [
          "date: Date or DateTime"
        ],
        "try": "2026-11-20:departure\n\n- [ ] Book the hotel @due(departure - 14d)"
      },
      {
        "documentation": "Planned work date; separate from the deadline.",
        "name": "@scheduled",
        "params": [
          "date: Date or DateTime"
        ],
        "try": "- [ ] Book flights @scheduled(2026-10-01) @due(2026-10-10)"
      },
      {
        "documentation": "Appointment time. Include an explicit UTC offset for ambiguous local times.",
        "name": "@at",
        "params": [
          "time: Date or DateTime"
        ],
        "try": "- Dentist @at(2026-09-25T09:30-04:00)"
      },
      {
        "documentation": "A nonnegative estimate. Examples: 30s, 20m, 2h.",
        "name": "@estimate",
        "params": [
          "effort: Duration"
        ],
        "try": "- [ ] Update the changelog @estimate(20m)"
      },
      {
        "documentation": "Block this task until all dependencies are satisfied. Cycles are reported with source locations.",
        "name": "@after",
        "params": [
          "dependency: Boolean or Checklist",
          "more dependencies..."
        ],
        "try": "- [x] Order parts :parts\n- [ ] Assemble @after(parts)"
      },
      {
        "documentation": "Repeat a leaf task: day, week, month, year, or a positive whole-day duration such as 2w.",
        "name": "@every",
        "params": [
          "interval: recurrence"
        ],
        "try": "- [ ] Water the plants @every(week) @due(2026-09-20)"
      },
      {
        "documentation": "Tag a task for filtering. Multiple tags may be comma-separated.",
        "name": "@tag",
        "params": [
          "tag: name"
        ],
        "try": "- [ ] Renew passport @tag(errands)"
      }
    ],
    "authoring": {
      "collections": [
        {
          "documentation": "Every syntax node in a note: its kind, text and parent.",
          "fields": [
            "id",
            "kind",
            "name",
            "parent",
            "children",
            "text",
            "source"
          ],
          "name": "ast",
          "tier": "module",
          "try": "ast | where kind == \"definition\" | select {name, text}"
        },
        {
          "documentation": "One record per itinerary day, with its date and cached forecast.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "value"
          ],
          "name": "days",
          "tier": "module",
          "try": "days | select {title, line}"
        },
        {
          "documentation": "Every countdown and stopwatch, at each definition and reference.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "name",
            "definition",
            "inlay",
            "value",
            "origin"
          ],
          "name": "timers",
          "tier": "module",
          "try": "timers | where definition | select {name, value}"
        },
        {
          "documentation": "Itinerary stops, placed on the day they belong to.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "due",
            "scheduled",
            "at",
            "estimate",
            "at_date",
            "parent",
            "tags",
            "blocked_by",
            "done",
            "leaf"
          ],
          "name": "stops",
          "tier": "module",
          "try": "stops | select {title, at}"
        },
        {
          "documentation": "Each decision a plan made, at the table cell it belongs in.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "value",
            "plan"
          ],
          "name": "decisions",
          "tier": "module",
          "try": "decisions | select {plan, title, value}"
        },
        {
          "documentation": "Every calculation written in prose, with its value.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "expression",
            "value",
            "type",
            "display",
            "bracketed"
          ],
          "name": "calculations",
          "tier": "module",
          "try": "calculations | select {expression, display}"
        },
        {
          "documentation": "Every bracketed reference, with the value it resolved to.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "expression",
            "value",
            "type",
            "display",
            "name",
            "property"
          ],
          "name": "references",
          "tier": "module",
          "try": "references | select {name, display}"
        },
        {
          "documentation": "Every table cell, with its expression and value.",
          "fields": [
            "kind",
            "title",
            "line",
            "anchor",
            "source",
            "errors",
            "expression",
            "value",
            "type",
            "display",
            "computed",
            "table",
            "row",
            "column"
          ],
          "name": "cells",
          "tier": "module",
          "try": "cells | where computed | select {expression, display}"
        }
      ],
      "functions": [
        {
          "documentation": "Solve a bounded linear model and return raw numeric values and status.",
          "group": "Plans",
          "name": "solve_linear",
          "params": [
            "model: Record"
          ],
          "result": "Record",
          "tier": "module",
          "try": "best := solve_linear({goal: \"maximize\", variables: {x: {kind: \"integer\", lower: 0, upper: 3}}, objective: {constant: 0, terms: {x: 1}}, constraints: []})\nstatus := best.status"
        },
        {
          "documentation": "Parse a calendar date with a strftime format; invalid input returns null.",
          "group": "Dates",
          "name": "parse_date",
          "params": [
            "text: Text",
            "format: Text"
          ],
          "result": "Date or Null",
          "tier": "module",
          "try": "departure := parse_date(\"2026-11-20\", \"%F\")"
        },
        {
          "documentation": "Parse a local timestamp using a reference timestamp's offset.",
          "group": "Dates",
          "name": "parse_datetime",
          "params": [
            "text: Text",
            "format: Text",
            "offset: DateTime"
          ],
          "result": "DateTime or Null",
          "tier": "module",
          "try": "landing := parse_datetime(\"2026-11-20 09:30\", \"%F %H:%M\", now())"
        },
        {
          "documentation": "Construct a calendar date; invalid dates return null.",
          "group": "Dates",
          "name": "make_date",
          "params": [
            "year: Number",
            "month: Number",
            "day: Number"
          ],
          "result": "Date or Null",
          "tier": "module",
          "try": "departure := make_date(2026, 11, 20)"
        },
        {
          "documentation": "Split integer seconds into total hours, remaining minutes and seconds without rounding.",
          "group": "Dates",
          "name": "duration_parts",
          "params": [
            "duration: Duration"
          ],
          "result": "Record",
          "tier": "module",
          "try": "parts := duration_parts(90m)\nminutes := parts.minutes"
        },
        {
          "documentation": "Read year, month, day and weekday (Monday is zero).",
          "group": "Dates",
          "name": "date_parts",
          "params": [
            "date: Date or DateTime"
          ],
          "result": "Record",
          "tier": "module",
          "try": "parts := date_parts(today())\nyear := parts.year"
        },
        {
          "documentation": "Combine a date and time of day using the reference timestamp offset.",
          "group": "Dates",
          "name": "at_time",
          "params": [
            "date: Date",
            "time: Duration",
            "offset: DateTime"
          ],
          "result": "DateTime",
          "tier": "module",
          "try": "standup := at_time(today(), 9h, now())"
        },
        {
          "documentation": "Parse a time of day as seconds since midnight.",
          "group": "Dates",
          "name": "parse_time",
          "params": [
            "text: Text",
            "format: Text"
          ],
          "result": "Duration or Null",
          "tier": "module",
          "try": "opens := parse_time(\"09:30\", \"%H:%M\")"
        },
        {
          "documentation": "Parse a written duration.",
          "group": "Dates",
          "name": "parse_duration",
          "params": [
            "text: Text"
          ],
          "result": "Duration or Null",
          "tier": "module",
          "try": "slot := parse_duration(\"2h\")"
        },
        {
          "documentation": "Format a date or timestamp with strftime directives.",
          "group": "Dates",
          "name": "format_date",
          "params": [
            "date: Date or DateTime",
            "format: Text"
          ],
          "result": "Text",
          "tier": "module",
          "try": "stamp := format_date(today(), \"%Y-%m-%d\")"
        },
        {
          "documentation": "Return an evaluation error.",
          "group": "Control",
          "name": "error",
          "params": [
            "message: Text"
          ],
          "result": "Never",
          "tier": "module",
          "try": "budget := $500\nchecked := if(budget > $0, budget, error(\"Budget must be positive\"))"
        },
        {
          "documentation": "Evaluate expression text in the current document's scope.",
          "group": "Control",
          "name": "eval",
          "params": [
            "expression: Text"
          ],
          "result": "Value",
          "tier": "module",
          "try": "price := $12.50\ndoubled := eval(\"price * 2\")"
        }
      ],
      "hooks": [
        {
          "arity": 1,
          "documentation": "Return the records this feature contributes for one note.",
          "kind": "feature",
          "name": "collect"
        },
        {
          "arity": 1,
          "documentation": "The inline text shown after a matching link.",
          "kind": "link",
          "name": "inlay"
        },
        {
          "arity": 1,
          "documentation": "The markdown shown when a matching link is hovered.",
          "kind": "both",
          "name": "hover"
        },
        {
          "arity": 2,
          "documentation": "Read one property off a matching link's cached data.",
          "kind": "both",
          "name": "property"
        },
        {
          "arity": 1,
          "documentation": "Describe the request that refreshes a matching link.",
          "kind": "both",
          "name": "refresh"
        },
        {
          "arity": 2,
          "documentation": "Turn a refresh response into the metadata that is cached.",
          "kind": "both",
          "name": "decode"
        },
        {
          "arity": 1,
          "documentation": "Decide whether a target belongs to this module at all.",
          "kind": "both",
          "name": "matches"
        },
        {
          "arity": 1,
          "documentation": "The property names completion offers for a matching link.",
          "kind": "both",
          "name": "property_names"
        },
        {
          "arity": 1,
          "documentation": "Whether a value has to be recomputed as the clock moves.",
          "kind": "both",
          "name": "time_dependent"
        },
        {
          "arity": 1,
          "documentation": "Code actions and lenses this module offers on a note.",
          "kind": "both",
          "name": "actions"
        },
        {
          "arity": 2,
          "documentation": "Fold this module's records into a workspace-wide answer.",
          "kind": "both",
          "name": "reduce"
        },
        {
          "arity": 1,
          "documentation": "Extra hovers this module contributes to a note.",
          "kind": "both",
          "name": "hovers"
        },
        {
          "arity": 1,
          "documentation": "Extra diagnostics this module reports for a note.",
          "kind": "both",
          "name": "diagnostics"
        },
        {
          "arity": 1,
          "documentation": "Rewrite a note's text when it is formatted.",
          "kind": "both",
          "name": "format"
        }
      ],
      "modules": [
        {
          "documentation": "Computed definitions share their evaluated values and hovers with queries.",
          "id": "definitions",
          "kind": "feature"
        },
        {
          "documentation": "Tasks are decorated entirely from the catalog: dates, blockers, children, timers.",
          "id": "tasks",
          "kind": "feature"
        },
        {
          "documentation": "Bracket references use the same expression records as document queries.",
          "id": "references",
          "kind": "feature"
        },
        {
          "documentation": "Resource views are resolved through this workspace's host modules and cache.",
          "id": "links",
          "kind": "feature"
        },
        {
          "documentation": "Calendar policy and presentation use shared date and collection primitives.",
          "id": "itinerary_core",
          "kind": "library"
        },
        {
          "documentation": "Itinerary days are decorated from the parsed day records the catalog holds.",
          "id": "itinerary",
          "kind": "feature"
        },
        {
          "documentation": "Timers show their own state, and only ask for live refreshes while one runs.",
          "id": "timers",
          "kind": "feature"
        },
        {
          "documentation": "Plans present the solver's answer: decisions, constraint slack and errors.",
          "id": "plans",
          "kind": "feature"
        },
        {
          "documentation": "Plan policy surrounds the generic numerical primitive.",
          "id": "plan",
          "kind": "library"
        },
        {
          "documentation": "Timer state and transitions. Rust carries the typed value and applies edits.",
          "id": "timer",
          "kind": "library"
        },
        {
          "documentation": "GitHub is an ordinary link module. Null namespace reads pre-module caches.",
          "hosts": [
            "github.com"
          ],
          "id": "github",
          "kind": "link"
        },
        {
          "documentation": "Any RSS or Atom feed, on any host: a link module that recognizes a URL shape rather than a site, so it declares `hosts: \"*\"` and decides in `matches`. The host parses the feed (`format: \"feed\"`), so `decode` reads plain records.",
          "hosts": [],
          "id": "rss",
          "kind": "link"
        },
        {
          "documentation": "Computed table cells retain their exact source anchor and typed display value.",
          "id": "table_cells",
          "kind": "feature"
        },
        {
          "documentation": "Section progress is a projection of leaf tasks, including evaluated completion.",
          "id": "checklists",
          "kind": "feature"
        },
        {
          "documentation": "Inline calculations use the same evaluated records as `wtf query calculations`.",
          "id": "calculations",
          "kind": "feature"
        }
      ]
    },
    "collections": [
      {
        "documentation": "Every link written in the prose of a note.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "url"
        ],
        "name": "links",
        "tier": "query",
        "try": "links | select {url}"
      },
      {
        "documentation": "Every task, with its dates, estimate, tags and what blocks it.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "due",
          "scheduled",
          "at",
          "estimate",
          "at_date",
          "parent",
          "tags",
          "blocked_by",
          "done",
          "leaf",
          "checked",
          "name",
          "attributes",
          "blocked_error",
          "schedule",
          "children",
          "timer"
        ],
        "name": "tasks",
        "tier": "query",
        "try": "tasks | where !done"
      },
      {
        "documentation": "Appointments: the lines carrying an @at time.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "due",
          "scheduled",
          "at",
          "estimate",
          "at_date",
          "parent",
          "tags",
          "blocked_by",
          "done",
          "leaf"
        ],
        "name": "events",
        "tier": "query",
        "try": "events | sort at | select {title, at}"
      },
      {
        "documentation": "Tasks, appointments and stops together, ready for one timeline.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "due",
          "scheduled",
          "at",
          "estimate",
          "at_date",
          "parent",
          "tags",
          "blocked_by",
          "done",
          "leaf",
          "checked",
          "name",
          "attributes",
          "blocked_error",
          "schedule",
          "children",
          "timer"
        ],
        "name": "entries",
        "tier": "query",
        "try": "entries | where due != null | sort due"
      },
      {
        "documentation": "Every named value, with its expression and evaluated result.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "name",
          "expression",
          "value",
          "type",
          "display",
          "computed"
        ],
        "name": "values",
        "tier": "query",
        "try": "values | select {name, display}"
      },
      {
        "documentation": "Linear plans, with the solution the solver found.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "name",
          "expression",
          "value",
          "type",
          "display",
          "computed",
          "solution"
        ],
        "name": "plans",
        "tier": "query",
        "try": "plans | select {name, solution}"
      },
      {
        "documentation": "Every table definition, with its columns and rows.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "name",
          "expression",
          "value",
          "type",
          "display",
          "computed"
        ],
        "name": "tables",
        "tier": "query",
        "try": "tables | select {name, display}"
      },
      {
        "documentation": "One record per table row, with its cells by column name.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "table",
          "cells"
        ],
        "name": "rows",
        "tier": "query",
        "try": "rows | where cells.price > $4 | select {cells}"
      },
      {
        "documentation": "Links, files, places and GitHub items, with cached metadata.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "target",
          "metadata"
        ],
        "name": "resources",
        "tier": "query",
        "try": "resources | select {target, metadata}"
      },
      {
        "documentation": "The problems a note has, as rows: the ci check in the README.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "message",
          "severity",
          "code"
        ],
        "name": "diagnostics",
        "tier": "query",
        "try": "diagnostics | where severity == \"error\""
      },
      {
        "documentation": "One record per note in the workspace, carrying its whole text.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "text"
        ],
        "name": "notes",
        "tier": "query",
        "try": "notes | select {title, line}"
      },
      {
        "documentation": "Every heading, with the span of lines it covers.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "end_line",
          "level"
        ],
        "name": "sections",
        "tier": "query",
        "try": "sections | where level == 2 | select {title}"
      }
    ],
    "commands": [
      {
        "documentation": "Start the language server over stdin/stdout (for editor integrations)",
        "name": "lsp",
        "usage": "wtf lsp"
      },
      {
        "documentation": "Query tasks, values, tables, plans, resources and diagnostics",
        "name": "query",
        "usage": "wtf query [OPTIONS] <QUERY>                (note on stdin)\n       wtf query [OPTIONS] <FILE> <QUERY>\n       wtf query [OPTIONS] --workspace <QUERY>"
      },
      {
        "documentation": "Export a saved note with the language server's colors and inline values",
        "name": "render",
        "usage": "wtf render [OPTIONS] <FILE>"
      },
      {
        "documentation": "Inspect syntax nodes, source text and expression trees for one note (JSON)",
        "name": "ast",
        "usage": "wtf ast [OPTIONS] <FILE>"
      },
      {
        "documentation": "Inspect dependencies between values, tasks and checklists in one note (JSON)",
        "name": "graph",
        "usage": "wtf graph [OPTIONS] <FILE>"
      },
      {
        "documentation": "Explicitly refresh cached resource status and external lookups",
        "name": "refresh",
        "usage": "wtf refresh [OPTIONS]"
      },
      {
        "documentation": "Keep a directory of notes in step with a folder in the web app",
        "name": "sync",
        "usage": "wtf sync [OPTIONS] <DIR>"
      },
      {
        "documentation": "Print the whole language reference: Markdown, or --json for tools",
        "name": "reference",
        "usage": "wtf reference [OPTIONS]"
      }
    ],
    "functions": [
      {
        "documentation": "Load a module by ID, or a note by path such as import(\"./values.wtf\"); members keep their own source.",
        "group": "Modules",
        "name": "import",
        "params": [
          "id: Text"
        ],
        "result": "Record",
        "tier": "note",
        "try": "units := import(\"units\")\nmiles := units.convert(100, \"km\", \"mi\")"
      },
      {
        "documentation": "Build a record from key/value pairs; duplicate keys are rejected.",
        "group": "Values",
        "name": "object",
        "params": [
          "entries: List"
        ],
        "result": "Record",
        "tier": "toolkit",
        "try": "pairs := [{key: \"city\", value: \"Oaxaca\"}, {key: \"nights\", value: 3}]\ntrip := object(pairs)"
      },
      {
        "documentation": "List key/value pairs in key order.",
        "group": "Values",
        "name": "entries",
        "params": [
          "record: Record"
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "nights := {oaxaca: 3, mexico_city: 2}\npairs := entries(nights)"
      },
      {
        "documentation": "Extract the numeric magnitude; durations use seconds.",
        "group": "Values",
        "name": "number",
        "params": [
          "value: Number, Money, Ratio, Duration or Count"
        ],
        "result": "Number",
        "tier": "toolkit",
        "try": "slot := 90m\nseconds := number(slot)"
      },
      {
        "documentation": "Format a typed scalar as a round-trippable expression.",
        "group": "Values",
        "name": "source",
        "params": [
          "value: Any"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "departure := today() + 7d\nliteral := source(departure)"
      },
      {
        "documentation": "Pad text to a character width with one character.",
        "group": "Text",
        "name": "pad_start",
        "params": [
          "text: Text",
          "width: Number",
          "fill: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "minute := pad_start(\"3\", 2, \"0\")"
      },
      {
        "documentation": "Pad text on the right.",
        "group": "Text",
        "name": "pad_end",
        "params": [
          "text: Text",
          "width: Number",
          "fill: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "cell := pad_end(\"pear\", 8, \" \")"
      },
      {
        "documentation": "Take a half-open range; text indices count Unicode characters.",
        "group": "Lists",
        "name": "slice",
        "params": [
          "value: Text or List",
          "start: Number",
          "end: Number"
        ],
        "result": "Text or List",
        "tier": "toolkit",
        "try": "code := slice(\"OAXACA\", 0, 3)"
      },
      {
        "documentation": "Concatenate lists.",
        "group": "Lists",
        "name": "concat",
        "params": [
          "lists: List..."
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "legs := concat([\"Oaxaca\", \"Puebla\"], [\"Mexico City\"])"
      },
      {
        "documentation": "Remove surrounding whitespace.",
        "group": "Text",
        "name": "trim",
        "params": [
          "text: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "city := trim(\"  Oaxaca  \")"
      },
      {
        "documentation": "Get the runtime type name.",
        "group": "Values",
        "name": "type",
        "params": [
          "value: Any"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "price := $12.50\nkind := type(price)"
      },
      {
        "documentation": "Round down to an integer.",
        "group": "Numbers",
        "name": "floor",
        "params": [
          "number: Number"
        ],
        "result": "Number",
        "tier": "toolkit",
        "try": "nights := floor(2.8)"
      },
      {
        "documentation": "Round to the nearest integer.",
        "group": "Numbers",
        "name": "round",
        "params": [
          "number: Number"
        ],
        "result": "Number",
        "tier": "toolkit",
        "try": "nights := round(2.8)"
      },
      {
        "documentation": "Repeat text a bounded number of times.",
        "group": "Text",
        "name": "repeat",
        "params": [
          "text: Text",
          "count: Number"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "bar := repeat(\"█\", 3)"
      },
      {
        "documentation": "Evaluate only the selected branch.",
        "group": "Control",
        "name": "if",
        "params": [
          "condition: Boolean",
          "then: Value",
          "else: Value"
        ],
        "result": "Value",
        "tier": "note",
        "try": "stock := 3\nlabel := if(stock > 0, \"in stock\", \"sold out\")"
      },
      {
        "documentation": "Return the first non-null value.",
        "group": "Control",
        "name": "coalesce",
        "params": [
          "values: Value..."
        ],
        "result": "Value",
        "tier": "note",
        "try": "nickname := null\nname := coalesce(nickname, \"friend\")"
      },
      {
        "documentation": "Apply a pure function to every item.",
        "group": "Lists",
        "name": "map",
        "params": [
          "items: List",
          "function: Function"
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "prices := [$3, $4.50]\ndoubled := map(prices, fn(p) => p * 2)"
      },
      {
        "documentation": "Keep items whose predicate returns true.",
        "group": "Lists",
        "name": "filter",
        "params": [
          "items: List",
          "predicate: Function"
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "sizes := [1, 2, 3]\nbig := filter(sizes, fn(n) => n > 1)"
      },
      {
        "documentation": "Stable ascending sort by a compatible scalar key; nulls come last.",
        "group": "Lists",
        "name": "sort_by",
        "params": [
          "items: List",
          "key: Function"
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "cities := [\"Puebla\", \"Oaxaca\"]\nsorted := sort_by(cities, fn(c) => c)"
      },
      {
        "documentation": "Group by a scalar key into {key, rows} records, in first-seen order.",
        "group": "Lists",
        "name": "group_by",
        "params": [
          "items: List",
          "key: Function"
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "votes := [\"yes\", \"no\", \"yes\"]\ntallies := group_by(votes, fn(v) => v)"
      },
      {
        "documentation": "Combine items left to right with an accumulator.",
        "group": "Lists",
        "name": "fold",
        "params": [
          "items: List",
          "initial: Value",
          "function: Function"
        ],
        "result": "Value",
        "tier": "toolkit",
        "try": "nights := [2, 3, 1]\ntotal := fold(nights, 0, fn(sum, n) => sum + n)"
      },
      {
        "documentation": "Read a field or index; return null when absent.",
        "group": "Values",
        "name": "get",
        "params": [
          "collection: Record or List",
          "key: Text or Number"
        ],
        "result": "Value",
        "tier": "toolkit",
        "try": "trip := {city: \"Oaxaca\", nights: 3}\ncity := get(trip, \"city\")"
      },
      {
        "documentation": "Count items, fields, or Unicode characters.",
        "group": "Values",
        "name": "length",
        "params": [
          "value: List, Record, or Text"
        ],
        "result": "Count",
        "tier": "toolkit",
        "try": "letters := length(\"Oaxaca\")"
      },
      {
        "documentation": "Format a value as text; null remains null.",
        "group": "Text",
        "name": "text",
        "params": [
          "value: Value"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "price := $25\nlabel := \"Lunch costs \" + text(price)"
      },
      {
        "documentation": "Test membership or a text substring.",
        "group": "Text",
        "name": "contains",
        "params": [
          "value: List or Text",
          "part: Value"
        ],
        "result": "Boolean",
        "tier": "toolkit",
        "try": "has_ell := contains(\"hello\", \"ell\")"
      },
      {
        "documentation": "Test a text prefix.",
        "group": "Text",
        "name": "starts_with",
        "params": [
          "text: Text",
          "prefix: Text"
        ],
        "result": "Boolean",
        "tier": "toolkit",
        "try": "local := starts_with(\"+52 951\", \"+52\")"
      },
      {
        "documentation": "Test a text suffix.",
        "group": "Text",
        "name": "ends_with",
        "params": [
          "text: Text",
          "suffix: Text"
        ],
        "result": "Boolean",
        "tier": "toolkit",
        "try": "is_note := ends_with(\"trip.wtf\", \".wtf\")"
      },
      {
        "documentation": "Split text into pieces.",
        "group": "Text",
        "name": "split",
        "params": [
          "text: Text",
          "separator: Text"
        ],
        "result": "List",
        "tier": "toolkit",
        "try": "parts := split(\"2026-11-20\", \"-\")"
      },
      {
        "documentation": "Join a list of text.",
        "group": "Text",
        "name": "join",
        "params": [
          "items: List",
          "separator: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "route := join([\"Oaxaca\", \"Puebla\"], \" to \")"
      },
      {
        "documentation": "Convert text to lowercase.",
        "group": "Text",
        "name": "lower",
        "params": [
          "text: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "slug := lower(\"Oaxaca\")"
      },
      {
        "documentation": "Convert text to uppercase.",
        "group": "Text",
        "name": "upper",
        "params": [
          "text: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "code := upper(\"mxn\")"
      },
      {
        "documentation": "Replace text occurrences.",
        "group": "Text",
        "name": "replace",
        "params": [
          "text: Text",
          "from: Text",
          "to: Text"
        ],
        "result": "Text",
        "tier": "toolkit",
        "try": "slug := replace(\"mexico city\", \" \", \"-\")"
      },
      {
        "documentation": "Add compatible quantities from a list, skipping nulls, or a row expression over each table row, keeping units.",
        "group": "Lists",
        "name": "sum",
        "params": [
          "items: List or Table",
          "expression?: row calculation"
        ],
        "result": "Number, Money, Ratio, or Duration",
        "tier": "note",
        "try": "prices := [$3, $4.50]\ntotal := sum(prices)"
      },
      {
        "documentation": "An idle countdown. Use Start timer to capture a timestamp; elapsed and started are persisted by timer controls.",
        "group": "Timers",
        "name": "countdown",
        "params": [
          "duration: Duration",
          "elapsed?: Duration",
          "started?: DateTime"
        ],
        "result": "Countdown",
        "tier": "note",
        "try": "focus := countdown(25m)\n\n- [ ] One focused session @timer(focus)"
      },
      {
        "documentation": "An idle stopwatch. Use Start, Pause, Resume, or Reset timer. Elapsed time includes time while the editor is closed.",
        "group": "Timers",
        "name": "stopwatch",
        "params": [
          "elapsed?: Duration",
          "started?: DateTime"
        ],
        "result": "Stopwatch",
        "tier": "note",
        "try": "work := stopwatch()\n\n- [ ] Investigate the flaky test @timer(work)"
      },
      {
        "documentation": "Declare a linear plan over the | constraint | expression | table below; undefined names become decisions.",
        "group": "Plans",
        "name": "maximize",
        "params": [
          "objective: linear expression"
        ],
        "result": "Plan",
        "tier": "note",
        "try": "400:flour_stock\n\nbakery := maximize($3 * bagels + $1.25 * doughnuts)\n| constraint | expression                                   |\n| ---------- | -------------------------------------------- |\n| flour      | 12 * bagels + 6.5 * doughnuts <= flour_stock |\n| milk       | bagels + 0.5 * doughnuts <= 200              |"
      },
      {
        "documentation": "Goal seek: the definition's own name is the unknown, set to the boundary value that makes the constraint hold.",
        "group": "Plans",
        "name": "solve",
        "params": [
          "constraint: expression with <=, >=, or =="
        ],
        "result": "Number, Money, or Duration",
        "tier": "note",
        "try": "$1,200:saved\n9:months_left\nsaved_by_june := monthly * months_left + saved\nmonthly := solve(saved_by_june >= $5,000)"
      },
      {
        "documentation": "Like maximize, but finds the smallest objective that satisfies every constraint in the table below.",
        "group": "Plans",
        "name": "minimize",
        "params": [
          "objective: linear expression"
        ],
        "result": "Plan",
        "tier": "note",
        "try": "plan := minimize(2 * crates)\n| constraint | expression   |\n| ---------- | ------------ |\n| demand     | crates >= 30 |"
      },
      {
        "documentation": "The current local calendar date. Updates at midnight.",
        "group": "Dates",
        "name": "today",
        "params": [],
        "result": "Date",
        "tier": "note",
        "try": "2026-11-20:departure\ndays_left := departure - today()"
      },
      {
        "documentation": "The current timestamp. Sampled once per evaluation; live hints refresh every second.",
        "group": "Dates",
        "name": "now",
        "params": [],
        "result": "DateTime",
        "tier": "note",
        "try": "stamp := now()\nin_an_hour := stamp + 1h"
      },
      {
        "documentation": "The cached exchange rate between two currencies, e.g. rate(EUR, USD). Refresh with wtf refresh or the ⟳ lookups lens; hovers show the age.",
        "group": "Lookups",
        "name": "rate",
        "params": [
          "from: currency code",
          "to: currency code"
        ],
        "result": "Number",
        "tier": "note",
        "try": "one_euro := rate(EUR, USD)"
      },
      {
        "documentation": "Convert money with the cached rate, e.g. to(hotel, USD); without one the note warns until wtf refresh.",
        "group": "Lookups",
        "name": "to",
        "params": [
          "amount: Money",
          "currency: code"
        ],
        "result": "Money",
        "tier": "note",
        "try": "hotel := 700 MXN\nusd := to(hotel, USD)"
      },
      {
        "documentation": "The cached forecast for a place and day, with .high, .low, .summary and .rain. Itinerary days with a place get one automatically.",
        "group": "Lookups",
        "name": "forecast",
        "params": [
          "place: Text",
          "date: Date",
          "unit?: F or C"
        ],
        "result": "Forecast",
        "tier": "note",
        "try": "landing := forecast(\"Oaxaca\", 2026-11-20)"
      },
      {
        "documentation": "The cached last price for a ticker, e.g. quote(NVDA); non-US tickers need a provider in .wtf/providers.json.",
        "group": "Lookups",
        "name": "quote",
        "params": [
          "symbol: ticker code"
        ],
        "result": "Money",
        "tier": "note",
        "try": "12:shares\nholding := quote(NVDA) * shares"
      },
      {
        "documentation": "Parse ISO or relative date text, or take a timestamp's calendar date in the request timezone.",
        "group": "Dates",
        "name": "date",
        "params": [
          "value: Text, Date, or DateTime"
        ],
        "result": "Date or DateTime",
        "tier": "note",
        "try": "friday := date(\"next Friday\")"
      },
      {
        "documentation": "Sum estimates of unfinished leaf tasks beneath a named heading.",
        "group": "Tasks",
        "name": "effort",
        "params": [
          "checklist: Checklist"
        ],
        "result": "Duration",
        "tier": "note",
        "try": "## Launch :launch\n\n- [ ] Record the demo @estimate(45m)\n- [ ] Update the changelog @estimate(20m)\n\nwork := effort(launch)"
      },
      {
        "documentation": "Count all leaf tasks beneath a named heading.",
        "group": "Tasks",
        "name": "total",
        "params": [
          "checklist: Checklist"
        ],
        "result": "Count",
        "tier": "note",
        "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\nsteps := total(launch)"
      },
      {
        "documentation": "Count completed leaf tasks beneath a named heading.",
        "group": "Tasks",
        "name": "completed",
        "params": [
          "checklist: Checklist"
        ],
        "result": "Count",
        "tier": "note",
        "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\ndone := completed(launch)"
      },
      {
        "documentation": "Count unfinished leaf tasks beneath a named heading.",
        "group": "Tasks",
        "name": "remaining",
        "params": [
          "checklist: Checklist"
        ],
        "result": "Count",
        "tier": "note",
        "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\nleft := remaining(launch)"
      }
    ],
    "library": [
      {
        "documentation": "Agenda selection is ordinary library code over the query API's entry records.",
        "exports": [
          {
            "documentation": "Select an inclusive date window from file-scoped or workspace entry records.",
            "name": "between",
            "params": [
              "entries",
              "first",
              "last"
            ],
            "try": "lib := import(\"agenda\")\nresult := lib.between(entries, first, last)"
          }
        ],
        "id": "agenda",
        "kind": "library"
      },
      {
        "documentation": "Shared presentation functions are ordinary library exports.",
        "exports": [
          {
            "documentation": "Render a fixed-width bar for a fraction between zero and one.",
            "name": "gauge",
            "params": [
              "fraction",
              "width"
            ],
            "try": "lib := import(\"format\")\nresult := lib.gauge(fraction, width)"
          },
          {
            "documentation": "Add a percentage to the standard ten-cell progress bar.",
            "name": "bar",
            "params": [
              "fraction"
            ],
            "try": "lib := import(\"format\")\nresult := lib.bar(fraction)"
          },
          {
            "documentation": "Format a duration as mm:ss or hh:mm:ss without losing seconds.",
            "name": "clock",
            "params": [
              "duration"
            ],
            "try": "lib := import(\"format\")\nresult := lib.clock(duration)"
          },
          {
            "documentation": "Describe a duration in hours and whole minutes.",
            "name": "human",
            "params": [
              "duration"
            ],
            "try": "lib := import(\"format\")\nresult := lib.human(duration)"
          },
          {
            "documentation": "Describe cache age with progressively coarser time units.",
            "name": "age",
            "params": [
              "elapsed"
            ],
            "try": "lib := import(\"format\")\nresult := lib.age(elapsed)"
          }
        ],
        "id": "format",
        "kind": "library"
      },
      {
        "documentation": "Unit conversion is ordinary pure arithmetic over named factor tables.",
        "exports": [
          {
            "documentation": "Name the dimension a unit belongs to, or report that it is unknown.",
            "name": "dimension",
            "params": [
              "unit"
            ],
            "try": "lib := import(\"units\")\nresult := lib.dimension(unit)"
          },
          {
            "documentation": "Convert between two units of the same dimension, e.g. convert(100, \"km\", \"mi\").",
            "name": "convert",
            "params": [
              "value",
              "from",
              "to"
            ],
            "try": "lib := import(\"units\")\nresult := lib.convert(value, from, to)"
          },
          {
            "documentation": "Round to two decimals and append the canonical unit for display.",
            "name": "format",
            "params": [
              "value",
              "unit"
            ],
            "try": "lib := import(\"units\")\nresult := lib.format(value, unit)"
          },
          {
            "documentation": "Convert and format in one step.",
            "name": "show",
            "params": [
              "value",
              "from",
              "to"
            ],
            "try": "lib := import(\"units\")\nresult := lib.show(value, from, to)"
          },
          {
            "documentation": "Common pairs, spelled out for notes that prefer a named function.",
            "name": "c_to_f",
            "params": [
              "value"
            ],
            "try": "lib := import(\"units\")\nresult := lib.c_to_f(value)"
          },
          {
            "documentation": "",
            "name": "f_to_c",
            "params": [
              "value"
            ],
            "try": "lib := import(\"units\")\nresult := lib.f_to_c(value)"
          },
          {
            "documentation": "",
            "name": "km_to_mi",
            "params": [
              "value"
            ],
            "try": "lib := import(\"units\")\nresult := lib.km_to_mi(value)"
          },
          {
            "documentation": "",
            "name": "mi_to_km",
            "params": [
              "value"
            ],
            "try": "lib := import(\"units\")\nresult := lib.mi_to_km(value)"
          },
          {
            "documentation": "",
            "name": "kg_to_lb",
            "params": [
              "value"
            ],
            "try": "lib := import(\"units\")\nresult := lib.kg_to_lb(value)"
          },
          {
            "documentation": "",
            "name": "lb_to_kg",
            "params": [
              "value"
            ],
            "try": "lib := import(\"units\")\nresult := lib.lb_to_kg(value)"
          }
        ],
        "id": "units",
        "kind": "library"
      }
    ],
    "syntaxes": [
      {
        "meaning": "a value with a name",
        "syntax": "$1,234:car"
      },
      {
        "meaning": "a calculation",
        "syntax": "total := car + $67"
      },
      {
        "meaning": "any value in a sentence",
        "syntax": "[total]"
      },
      {
        "meaning": "a date",
        "syntax": "2026-11-20:departure"
      },
      {
        "meaning": "a task with an attribute",
        "syntax": "- [ ] pack @due(departure - 14d)"
      },
      {
        "meaning": "a named heading that counts its tasks",
        "syntax": "## trip :trip"
      },
      {
        "meaning": "a timer",
        "syntax": "focus := countdown(25m)"
      }
    ],
    "types": [
      {
        "documentation": "A plain number, with , as an optional thousands separator.",
        "fields": [],
        "name": "Number",
        "tier": "scalar",
        "try": "12:units\n$8.50:unit_price\nsubtotal := units * unit_price"
      },
      {
        "documentation": "A whole number of things, as length and the checklist calls return it.",
        "fields": [],
        "name": "Count",
        "tier": "scalar",
        "try": "letters := length(\"Oaxaca\")"
      },
      {
        "documentation": "An amount in one currency; two currencies never add up silently.",
        "fields": [
          "amount",
          "currency",
          "type"
        ],
        "name": "Money",
        "tier": "scalar",
        "try": "price := $12.50\ncents := price.amount"
      },
      {
        "documentation": "A percentage, written 8.875%; it scales anything it multiplies.",
        "fields": [
          "value",
          "type"
        ],
        "name": "Ratio",
        "tier": "scalar",
        "try": "share := 8.875%\ntax := $100 * share"
      },
      {
        "documentation": "A span of whole seconds, written 30s, 20m, 2h, 14d or 2w.",
        "fields": [
          "seconds",
          "type"
        ],
        "name": "Duration",
        "tier": "scalar",
        "try": "slot := 90m\nminutes := slot.seconds / 60"
      },
      {
        "documentation": "A calendar date, written 2026-11-20; dates subtract to a duration.",
        "fields": [
          "value",
          "type"
        ],
        "name": "Date",
        "tier": "scalar",
        "try": "2026-11-20:departure\ndays_left := departure - today()"
      },
      {
        "documentation": "A timestamp with a UTC offset, written 2026-11-20T09:30-06:00.",
        "fields": [
          "value",
          "type"
        ],
        "name": "DateTime",
        "tier": "scalar",
        "try": "landing := 2026-11-20T09:30-06:00\nhour := landing + 90m"
      },
      {
        "documentation": "true or false, as comparisons and named tasks produce it.",
        "fields": [],
        "name": "Boolean",
        "tier": "scalar",
        "try": "$500:budget\n$420:spent\nbudget_ok := spent <= budget"
      },
      {
        "documentation": "Text in double quotes; an uppercase code such as USD is text too.",
        "fields": [],
        "name": "Text",
        "tier": "scalar",
        "try": "\"Oaxaca\":city\ngreeting := \"Hello from \" + city"
      },
      {
        "documentation": "An ordered list of values, written [a, b, c].",
        "fields": [],
        "name": "List",
        "tier": "scalar",
        "try": "prices := [$3, $4.50]\ntotal := sum(prices)"
      },
      {
        "documentation": "Named fields, written {key: value}; read them with a dot.",
        "fields": [],
        "name": "Record",
        "tier": "scalar",
        "try": "trip := {city: \"Oaxaca\", nights: 3}\nwhere := trip.city"
      },
      {
        "documentation": "No value: a missing lookup, an absent field, or the literal null.",
        "fields": [],
        "name": "Null",
        "tier": "scalar",
        "try": "missing := null\nname := coalesce(missing, \"friend\")"
      },
      {
        "documentation": "A pure function, written fn(a, b) => expression.",
        "fields": [],
        "name": "Function",
        "tier": "object",
        "try": "double := fn(n) => n * 2\nfour := double(2)"
      },
      {
        "documentation": "Another note or module, imported by name; its members resolve lazily.",
        "fields": [],
        "name": "Namespace",
        "tier": "object",
        "try": "units := import(\"units\")\nmiles := units.convert(100, \"km\", \"mi\")"
      },
      {
        "documentation": "A cached day of weather, with .high, .low, .summary and .rain.",
        "fields": [],
        "name": "Forecast",
        "tier": "object",
        "try": "landing := forecast(\"Oaxaca\", 2026-11-20)"
      },
      {
        "documentation": "A link, file, place or GitHub item, with cached metadata and an Open lens.",
        "fields": [],
        "name": "Resource",
        "tier": "object",
        "try": "https://example.com/docs:docs\n\n- [ ] Read the [docs]"
      },
      {
        "documentation": "A named heading: the tasks beneath it, counted by total and completed.",
        "fields": [],
        "name": "Checklist",
        "tier": "object",
        "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\ndone := completed(launch)"
      },
      {
