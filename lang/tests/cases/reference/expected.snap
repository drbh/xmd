### 0 cli reference --json
$ wtf reference --json
exit 0
--- stdout
{
  "attributes": [
    {
      "documentation": "Associate a named timer with this task. Completion does not stop the timer.",
      "name": "@timer",
      "params": [
        "timer: Timer"
      ],
      "try": "focus := countdown(25m)\n\n- [ ] One focused session @timer(focus)"
    },
    {
      "documentation": "Deadline. Accepts a named date, an expression, or relative input such as tomorrow. Use Freeze relative date to capture it.",
      "name": "@due",
      "params": [
        "date: Date or DateTime"
      ],
      "try": "2026-11-20:departure\n\n- [ ] Book the hotel @due(departure - 14d)"
    },
    {
      "documentation": "Planned work date; separate from the deadline.",
      "name": "@scheduled",
      "params": [
        "date: Date or DateTime"
      ],
      "try": "- [ ] Book flights @scheduled(2026-10-01) @due(2026-10-10)"
    },
    {
      "documentation": "Appointment time. Include an explicit UTC offset for ambiguous local times.",
      "name": "@at",
      "params": [
        "time: Date or DateTime"
      ],
      "try": "- Dentist @at(2026-09-25T09:30-04:00)"
    },
    {
      "documentation": "A nonnegative estimate. Examples: 30s, 20m, 2h.",
      "name": "@estimate",
      "params": [
        "effort: Duration"
      ],
      "try": "- [ ] Update the changelog @estimate(20m)"
    },
    {
      "documentation": "Block this task until all dependencies are satisfied. Cycles are reported with source locations.",
      "name": "@after",
      "params": [
        "dependency: Boolean or Checklist",
        "more dependencies..."
      ],
      "try": "- [x] Order parts :parts\n- [ ] Assemble @after(parts)"
    },
    {
      "documentation": "Repeat a leaf task: day, week, month, year, or a positive whole-day duration such as 2w.",
      "name": "@every",
      "params": [
        "interval: recurrence"
      ],
      "try": "- [ ] Water the plants @every(week) @due(2026-09-20)"
    },
    {
      "documentation": "Tag a task for filtering. Multiple tags may be comma-separated.",
      "name": "@tag",
      "params": [
        "tag: name"
      ],
      "try": "- [ ] Renew passport @tag(errands)"
    }
  ],
  "authoring": {
    "collections": [
      {
        "documentation": "Every syntax node in a note: its kind, text and parent.",
        "fields": [
          "id",
          "kind",
          "name",
          "parent",
          "children",
          "text",
          "source"
        ],
        "name": "ast",
        "tier": "module",
        "try": "ast | where kind == \"definition\" | select {name, text}"
      },
      {
        "documentation": "One record per itinerary day, with its date and cached forecast.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "value"
        ],
        "name": "days",
        "tier": "module",
        "try": "days | select {title, line}"
      },
      {
        "documentation": "Every countdown and stopwatch, at each definition and reference.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "name",
          "definition",
          "inlay",
          "value",
          "origin"
        ],
        "name": "timers",
        "tier": "module",
        "try": "timers | where definition | select {name, value}"
      },
      {
        "documentation": "Itinerary stops, placed on the day they belong to.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "due",
          "scheduled",
          "at",
          "estimate",
          "at_date",
          "parent",
          "tags",
          "blocked_by",
          "done",
          "leaf"
        ],
        "name": "stops",
        "tier": "module",
        "try": "stops | select {title, at}"
      },
      {
        "documentation": "Each decision a plan made, at the table cell it belongs in.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "value",
          "plan"
        ],
        "name": "decisions",
        "tier": "module",
        "try": "decisions | select {plan, title, value}"
      },
      {
        "documentation": "Every calculation written in prose, with its value.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "expression",
          "value",
          "type",
          "display",
          "bracketed"
        ],
        "name": "calculations",
        "tier": "module",
        "try": "calculations | select {expression, display}"
      },
      {
        "documentation": "Every bracketed reference, with the value it resolved to.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "expression",
          "value",
          "type",
          "display",
          "name",
          "property"
        ],
        "name": "references",
        "tier": "module",
        "try": "references | select {name, display}"
      },
      {
        "documentation": "Every table cell, with its expression and value.",
        "fields": [
          "kind",
          "title",
          "line",
          "anchor",
          "source",
          "errors",
          "expression",
          "value",
          "type",
          "display",
          "computed",
          "table",
          "row",
          "column"
        ],
        "name": "cells",
        "tier": "module",
        "try": "cells | where computed | select {expression, display}"
      }
    ],
    "functions": [
      {
        "documentation": "Solve a bounded linear model and return raw numeric values and status.",
        "group": "Plans",
        "name": "solve_linear",
        "params": [
          "model: Record"
        ],
        "result": "Record",
        "tier": "module",
        "try": "best := solve_linear({goal: \"maximize\", variables: {x: {kind: \"integer\", lower: 0, upper: 3}}, objective: {constant: 0, terms: {x: 1}}, constraints: []})\nstatus := best.status"
      },
      {
        "documentation": "Parse a calendar date with a strftime format; invalid input returns null.",
        "group": "Dates",
        "name": "parse_date",
        "params": [
          "text: Text",
          "format: Text"
        ],
        "result": "Date or Null",
        "tier": "module",
        "try": "departure := parse_date(\"2026-11-20\", \"%F\")"
      },
      {
        "documentation": "Parse a local timestamp using a reference timestamp's offset.",
        "group": "Dates",
        "name": "parse_datetime",
        "params": [
          "text: Text",
          "format: Text",
          "offset: DateTime"
        ],
        "result": "DateTime or Null",
        "tier": "module",
        "try": "landing := parse_datetime(\"2026-11-20 09:30\", \"%F %H:%M\", now())"
      },
      {
        "documentation": "Construct a calendar date; invalid dates return null.",
        "group": "Dates",
        "name": "make_date",
        "params": [
          "year: Number",
          "month: Number",
          "day: Number"
        ],
        "result": "Date or Null",
        "tier": "module",
        "try": "departure := make_date(2026, 11, 20)"
      },
      {
        "documentation": "Split integer seconds into total hours, remaining minutes and seconds without rounding.",
        "group": "Dates",
        "name": "duration_parts",
        "params": [
          "duration: Duration"
        ],
        "result": "Record",
        "tier": "module",
        "try": "parts := duration_parts(90m)\nminutes := parts.minutes"
      },
      {
        "documentation": "Read year, month, day and weekday (Monday is zero).",
        "group": "Dates",
        "name": "date_parts",
        "params": [
          "date: Date or DateTime"
        ],
        "result": "Record",
        "tier": "module",
        "try": "parts := date_parts(today())\nyear := parts.year"
      },
      {
        "documentation": "Combine a date and time of day using the reference timestamp offset.",
        "group": "Dates",
        "name": "at_time",
        "params": [
          "date: Date",
          "time: Duration",
          "offset: DateTime"
        ],
        "result": "DateTime",
        "tier": "module",
        "try": "standup := at_time(today(), 9h, now())"
      },
      {
        "documentation": "Parse a time of day as seconds since midnight.",
        "group": "Dates",
        "name": "parse_time",
        "params": [
          "text: Text",
          "format: Text"
        ],
        "result": "Duration or Null",
        "tier": "module",
        "try": "opens := parse_time(\"09:30\", \"%H:%M\")"
      },
      {
        "documentation": "Parse a written duration.",
        "group": "Dates",
        "name": "parse_duration",
        "params": [
          "text: Text"
        ],
        "result": "Duration or Null",
        "tier": "module",
        "try": "slot := parse_duration(\"2h\")"
      },
      {
        "documentation": "Format a date or timestamp with strftime directives.",
        "group": "Dates",
        "name": "format_date",
        "params": [
          "date: Date or DateTime",
          "format: Text"
        ],
        "result": "Text",
        "tier": "module",
        "try": "stamp := format_date(today(), \"%Y-%m-%d\")"
      },
      {
        "documentation": "Return an evaluation error.",
        "group": "Control",
        "name": "error",
        "params": [
          "message: Text"
        ],
        "result": "Never",
        "tier": "module",
        "try": "budget := $500\nchecked := if(budget > $0, budget, error(\"Budget must be positive\"))"
      },
      {
        "documentation": "Evaluate expression text in the current document's scope.",
        "group": "Control",
        "name": "eval",
        "params": [
          "expression: Text"
        ],
        "result": "Value",
        "tier": "module",
        "try": "price := $12.50\ndoubled := eval(\"price * 2\")"
      }
    ],
    "hooks": [
      {
        "arity": 1,
        "documentation": "Return the records this feature contributes for one note.",
        "kind": "feature",
        "name": "collect"
      },
      {
        "arity": 1,
        "documentation": "The inline text shown after a matching link.",
        "kind": "link",
        "name": "inlay"
      },
      {
        "arity": 1,
        "documentation": "The markdown shown when a matching link is hovered.",
        "kind": "both",
        "name": "hover"
      },
      {
        "arity": 2,
        "documentation": "Read one property off a matching link's cached data.",
        "kind": "both",
        "name": "property"
      },
      {
        "arity": 1,
        "documentation": "Describe the request that refreshes a matching link.",
        "kind": "both",
        "name": "refresh"
      },
      {
        "arity": 2,
        "documentation": "Turn a refresh response into the metadata that is cached.",
        "kind": "both",
        "name": "decode"
      },
      {
        "arity": 1,
        "documentation": "Decide whether a target belongs to this module at all.",
        "kind": "both",
        "name": "matches"
      },
      {
        "arity": 1,
        "documentation": "The property names completion offers for a matching link.",
        "kind": "both",
        "name": "property_names"
      },
      {
        "arity": 1,
        "documentation": "Whether a value has to be recomputed as the clock moves.",
        "kind": "both",
        "name": "time_dependent"
      },
      {
        "arity": 1,
        "documentation": "Code actions and lenses this module offers on a note.",
        "kind": "both",
        "name": "actions"
      },
      {
        "arity": 2,
        "documentation": "Fold this module's records into a workspace-wide answer.",
        "kind": "both",
        "name": "reduce"
      },
      {
        "arity": 1,
        "documentation": "Extra hovers this module contributes to a note.",
        "kind": "both",
        "name": "hovers"
      },
      {
        "arity": 1,
        "documentation": "Extra diagnostics this module reports for a note.",
        "kind": "both",
        "name": "diagnostics"
      },
      {
        "arity": 1,
        "documentation": "Rewrite a note's text when it is formatted.",
        "kind": "both",
        "name": "format"
      }
    ],
    "modules": [
      {
        "documentation": "Computed definitions share their evaluated values and hovers with queries.",
        "id": "definitions",
        "kind": "feature"
      },
      {
        "documentation": "Tasks are decorated entirely from the catalog: dates, blockers, children, timers.",
        "id": "tasks",
        "kind": "feature"
      },
      {
        "documentation": "Bracket references use the same expression records as document queries.",
        "id": "references",
        "kind": "feature"
      },
      {
        "documentation": "Resource views are resolved through this workspace's host modules and cache.",
        "id": "links",
        "kind": "feature"
      },
      {
        "documentation": "Calendar policy and presentation use shared date and collection primitives.",
        "id": "itinerary_core",
        "kind": "library"
      },
      {
        "documentation": "Itinerary days are decorated from the parsed day records the catalog holds.",
        "id": "itinerary",
        "kind": "feature"
      },
      {
        "documentation": "Timers show their own state, and only ask for live refreshes while one runs.",
        "id": "timers",
        "kind": "feature"
      },
      {
        "documentation": "Plans present the solver's answer: decisions, constraint slack and errors.",
        "id": "plans",
        "kind": "feature"
      },
      {
        "documentation": "Plan policy surrounds the generic numerical primitive.",
        "id": "plan",
        "kind": "library"
      },
      {
        "documentation": "Timer state and transitions. Rust carries the typed value and applies edits.",
        "id": "timer",
        "kind": "library"
      },
      {
        "documentation": "GitHub is an ordinary link module. Null namespace reads pre-module caches.",
        "hosts": [
          "github.com"
        ],
        "id": "github",
        "kind": "link"
      },
      {
        "documentation": "Any RSS or Atom feed, on any host: a link module that recognizes a URL shape rather than a site, so it declares `hosts: \"*\"` and decides in `matches`. The host parses the feed (`format: \"feed\"`), so `decode` reads plain records.",
        "hosts": [],
        "id": "rss",
        "kind": "link"
      },
      {
        "documentation": "Computed table cells retain their exact source anchor and typed display value.",
        "id": "table_cells",
        "kind": "feature"
      },
      {
        "documentation": "Section progress is a projection of leaf tasks, including evaluated completion.",
        "id": "checklists",
        "kind": "feature"
      },
      {
        "documentation": "Inline calculations use the same evaluated records as `wtf query calculations`.",
        "id": "calculations",
        "kind": "feature"
      }
    ]
  },
  "collections": [
    {
      "documentation": "Every link written in the prose of a note.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "url"
      ],
      "name": "links",
      "tier": "query",
      "try": "links | select {url}"
    },
    {
      "documentation": "Every task, with its dates, estimate, tags and what blocks it.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "due",
        "scheduled",
        "at",
        "estimate",
        "at_date",
        "parent",
        "tags",
        "blocked_by",
        "done",
        "leaf",
        "checked",
        "name",
        "attributes",
        "blocked_error",
        "schedule",
        "children",
        "timer"
      ],
      "name": "tasks",
      "tier": "query",
      "try": "tasks | where !done"
    },
    {
      "documentation": "Appointments: the lines carrying an @at time.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "due",
        "scheduled",
        "at",
        "estimate",
        "at_date",
        "parent",
        "tags",
        "blocked_by",
        "done",
        "leaf"
      ],
      "name": "events",
      "tier": "query",
      "try": "events | sort at | select {title, at}"
    },
    {
      "documentation": "Tasks, appointments and stops together, ready for one timeline.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "due",
        "scheduled",
        "at",
        "estimate",
        "at_date",
        "parent",
        "tags",
        "blocked_by",
        "done",
        "leaf",
        "checked",
        "name",
        "attributes",
        "blocked_error",
        "schedule",
        "children",
        "timer"
      ],
      "name": "entries",
      "tier": "query",
      "try": "entries | where due != null | sort due"
    },
    {
      "documentation": "Every named value, with its expression and evaluated result.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "name",
        "expression",
        "value",
        "type",
        "display",
        "computed"
      ],
      "name": "values",
      "tier": "query",
      "try": "values | select {name, display}"
    },
    {
      "documentation": "Linear plans, with the solution the solver found.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "name",
        "expression",
        "value",
        "type",
        "display",
        "computed",
        "solution"
      ],
      "name": "plans",
      "tier": "query",
      "try": "plans | select {name, solution}"
    },
    {
      "documentation": "Every table definition, with its columns and rows.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "name",
        "expression",
        "value",
        "type",
        "display",
        "computed"
      ],
      "name": "tables",
      "tier": "query",
      "try": "tables | select {name, display}"
    },
    {
      "documentation": "One record per table row, with its cells by column name.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "table",
        "cells"
      ],
      "name": "rows",
      "tier": "query",
      "try": "rows | where cells.price > $4 | select {cells}"
    },
    {
      "documentation": "Links, files, places and GitHub items, with cached metadata.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "target",
        "metadata"
      ],
      "name": "resources",
      "tier": "query",
      "try": "resources | select {target, metadata}"
    },
    {
      "documentation": "The problems a note has, as rows: the ci check in the README.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "message",
        "severity",
        "code"
      ],
      "name": "diagnostics",
      "tier": "query",
      "try": "diagnostics | where severity == \"error\""
    },
    {
      "documentation": "One record per note in the workspace, carrying its whole text.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "text"
      ],
      "name": "notes",
      "tier": "query",
      "try": "notes | select {title, line}"
    },
    {
      "documentation": "Every heading, with the span of lines it covers.",
      "fields": [
        "kind",
        "title",
        "line",
        "anchor",
        "source",
        "errors",
        "end_line",
        "level"
      ],
      "name": "sections",
      "tier": "query",
      "try": "sections | where level == 2 | select {title}"
    }
  ],
  "commands": [
    {
      "documentation": "Start the language server over stdin/stdout (for editor integrations)",
      "name": "lsp",
      "usage": "wtf lsp"
    },
    {
      "documentation": "Query tasks, values, tables, plans, resources and diagnostics",
      "name": "query",
      "usage": "wtf query [OPTIONS] <QUERY>                (note on stdin)\n       wtf query [OPTIONS] <FILE> <QUERY>\n       wtf query [OPTIONS] --workspace <QUERY>"
    },
    {
      "documentation": "Export a saved note with the language server's colors and inline values",
      "name": "render",
      "usage": "wtf render [OPTIONS] <FILE>"
    },
    {
      "documentation": "Inspect syntax nodes, source text and expression trees for one note (JSON)",
      "name": "ast",
      "usage": "wtf ast [OPTIONS] <FILE>"
    },
    {
      "documentation": "Inspect dependencies between values, tasks and checklists in one note (JSON)",
      "name": "graph",
      "usage": "wtf graph [OPTIONS] <FILE>"
    },
    {
      "documentation": "Explicitly refresh cached resource status and external lookups",
      "name": "refresh",
      "usage": "wtf refresh [OPTIONS]"
    },
    {
      "documentation": "Keep a directory of notes in step with a folder in the web app",
      "name": "sync",
      "usage": "wtf sync [OPTIONS] <DIR>"
    },
    {
      "documentation": "Print the whole language reference: Markdown, or --json for tools",
      "name": "reference",
      "usage": "wtf reference [OPTIONS]"
    }
  ],
  "functions": [
    {
      "documentation": "Load a module by ID, or a note by path such as import(\"./values.wtf\"); members keep their own source.",
      "group": "Modules",
      "name": "import",
      "params": [
        "id: Text"
      ],
      "result": "Record",
      "tier": "note",
      "try": "units := import(\"units\")\nmiles := units.convert(100, \"km\", \"mi\")"
    },
    {
      "documentation": "Build a record from key/value pairs; duplicate keys are rejected.",
      "group": "Values",
      "name": "object",
      "params": [
        "entries: List"
      ],
      "result": "Record",
      "tier": "toolkit",
      "try": "pairs := [{key: \"city\", value: \"Oaxaca\"}, {key: \"nights\", value: 3}]\ntrip := object(pairs)"
    },
    {
      "documentation": "List key/value pairs in key order.",
      "group": "Values",
      "name": "entries",
      "params": [
        "record: Record"
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "nights := {oaxaca: 3, mexico_city: 2}\npairs := entries(nights)"
    },
    {
      "documentation": "Extract the numeric magnitude; durations use seconds.",
      "group": "Values",
      "name": "number",
      "params": [
        "value: Number, Money, Ratio, Duration or Count"
      ],
      "result": "Number",
      "tier": "toolkit",
      "try": "slot := 90m\nseconds := number(slot)"
    },
    {
      "documentation": "Format a typed scalar as a round-trippable expression.",
      "group": "Values",
      "name": "source",
      "params": [
        "value: Any"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "departure := today() + 7d\nliteral := source(departure)"
    },
    {
      "documentation": "Pad text to a character width with one character.",
      "group": "Text",
      "name": "pad_start",
      "params": [
        "text: Text",
        "width: Number",
        "fill: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "minute := pad_start(\"3\", 2, \"0\")"
    },
    {
      "documentation": "Pad text on the right.",
      "group": "Text",
      "name": "pad_end",
      "params": [
        "text: Text",
        "width: Number",
        "fill: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "cell := pad_end(\"pear\", 8, \" \")"
    },
    {
      "documentation": "Take a half-open range; text indices count Unicode characters.",
      "group": "Lists",
      "name": "slice",
      "params": [
        "value: Text or List",
        "start: Number",
        "end: Number"
      ],
      "result": "Text or List",
      "tier": "toolkit",
      "try": "code := slice(\"OAXACA\", 0, 3)"
    },
    {
      "documentation": "Concatenate lists.",
      "group": "Lists",
      "name": "concat",
      "params": [
        "lists: List..."
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "legs := concat([\"Oaxaca\", \"Puebla\"], [\"Mexico City\"])"
    },
    {
      "documentation": "Remove surrounding whitespace.",
      "group": "Text",
      "name": "trim",
      "params": [
        "text: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "city := trim(\"  Oaxaca  \")"
    },
    {
      "documentation": "Get the runtime type name.",
      "group": "Values",
      "name": "type",
      "params": [
        "value: Any"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "price := $12.50\nkind := type(price)"
    },
    {
      "documentation": "Round down to an integer.",
      "group": "Numbers",
      "name": "floor",
      "params": [
        "number: Number"
      ],
      "result": "Number",
      "tier": "toolkit",
      "try": "nights := floor(2.8)"
    },
    {
      "documentation": "Round to the nearest integer.",
      "group": "Numbers",
      "name": "round",
      "params": [
        "number: Number"
      ],
      "result": "Number",
      "tier": "toolkit",
      "try": "nights := round(2.8)"
    },
    {
      "documentation": "Repeat text a bounded number of times.",
      "group": "Text",
      "name": "repeat",
      "params": [
        "text: Text",
        "count: Number"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "bar := repeat(\"█\", 3)"
    },
    {
      "documentation": "Evaluate only the selected branch.",
      "group": "Control",
      "name": "if",
      "params": [
        "condition: Boolean",
        "then: Value",
        "else: Value"
      ],
      "result": "Value",
      "tier": "note",
      "try": "stock := 3\nlabel := if(stock > 0, \"in stock\", \"sold out\")"
    },
    {
      "documentation": "Return the first non-null value.",
      "group": "Control",
      "name": "coalesce",
      "params": [
        "values: Value..."
      ],
      "result": "Value",
      "tier": "note",
      "try": "nickname := null\nname := coalesce(nickname, \"friend\")"
    },
    {
      "documentation": "Apply a pure function to every item.",
      "group": "Lists",
      "name": "map",
      "params": [
        "items: List",
        "function: Function"
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "prices := [$3, $4.50]\ndoubled := map(prices, fn(p) => p * 2)"
    },
    {
      "documentation": "Keep items whose predicate returns true.",
      "group": "Lists",
      "name": "filter",
      "params": [
        "items: List",
        "predicate: Function"
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "sizes := [1, 2, 3]\nbig := filter(sizes, fn(n) => n > 1)"
    },
    {
      "documentation": "Stable ascending sort by a compatible scalar key; nulls come last.",
      "group": "Lists",
      "name": "sort_by",
      "params": [
        "items: List",
        "key: Function"
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "cities := [\"Puebla\", \"Oaxaca\"]\nsorted := sort_by(cities, fn(c) => c)"
    },
    {
      "documentation": "Group by a scalar key into {key, rows} records, in first-seen order.",
      "group": "Lists",
      "name": "group_by",
      "params": [
        "items: List",
        "key: Function"
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "votes := [\"yes\", \"no\", \"yes\"]\ntallies := group_by(votes, fn(v) => v)"
    },
    {
      "documentation": "Combine items left to right with an accumulator.",
      "group": "Lists",
      "name": "fold",
      "params": [
        "items: List",
        "initial: Value",
        "function: Function"
      ],
      "result": "Value",
      "tier": "toolkit",
      "try": "nights := [2, 3, 1]\ntotal := fold(nights, 0, fn(sum, n) => sum + n)"
    },
    {
      "documentation": "Read a field or index; return null when absent.",
      "group": "Values",
      "name": "get",
      "params": [
        "collection: Record or List",
        "key: Text or Number"
      ],
      "result": "Value",
      "tier": "toolkit",
      "try": "trip := {city: \"Oaxaca\", nights: 3}\ncity := get(trip, \"city\")"
    },
    {
      "documentation": "Count items, fields, or Unicode characters.",
      "group": "Values",
      "name": "length",
      "params": [
        "value: List, Record, or Text"
      ],
      "result": "Count",
      "tier": "toolkit",
      "try": "letters := length(\"Oaxaca\")"
    },
    {
      "documentation": "Format a value as text; null remains null.",
      "group": "Text",
      "name": "text",
      "params": [
        "value: Value"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "price := $25\nlabel := \"Lunch costs \" + text(price)"
    },
    {
      "documentation": "Inspect any value as compact JSON text in an inlay. Records, lists, and host objects expose their fields; money, dates, durations, and ratios keep their type and units.",
      "group": "Values",
      "name": "debug",
      "params": [
        "value: Value"
      ],
      "result": "Text",
      "tier": "note",
      "try": "weather := {high: 25, rain: 35%}\n[debug(weather)]"
    },
    {
      "documentation": "Draw one Unicode bar per numeric value, in list order. Null leaves a gap (·). The scale uses the data's minimum and maximum unless both bounds are supplied; values outside fixed bounds are clipped. Values and bounds must use matching units.",
      "group": "Values",
      "name": "sparkline",
      "params": [
        "values: List",
        "min?: Number, Money, Ratio, or Duration",
        "max?: Number, Money, Ratio, or Duration"
      ],
      "result": "Text",
      "tier": "note",
      "try": "sales := [12, 18, 9, 24]\n[sparkline(sales)]\n[sparkline([20%, 40%, 30%], 0%, 100%)]"
    },
    {
      "documentation": "Test membership or a text substring.",
      "group": "Text",
      "name": "contains",
      "params": [
        "value: List or Text",
        "part: Value"
      ],
      "result": "Boolean",
      "tier": "toolkit",
      "try": "has_ell := contains(\"hello\", \"ell\")"
    },
    {
      "documentation": "Test a text prefix.",
      "group": "Text",
      "name": "starts_with",
      "params": [
        "text: Text",
        "prefix: Text"
      ],
      "result": "Boolean",
      "tier": "toolkit",
      "try": "local := starts_with(\"+52 951\", \"+52\")"
    },
    {
      "documentation": "Test a text suffix.",
      "group": "Text",
      "name": "ends_with",
      "params": [
        "text: Text",
        "suffix: Text"
      ],
      "result": "Boolean",
      "tier": "toolkit",
      "try": "is_note := ends_with(\"trip.wtf\", \".wtf\")"
    },
    {
      "documentation": "Split text into pieces.",
      "group": "Text",
      "name": "split",
      "params": [
        "text: Text",
        "separator: Text"
      ],
      "result": "List",
      "tier": "toolkit",
      "try": "parts := split(\"2026-11-20\", \"-\")"
    },
    {
      "documentation": "Join a list of text.",
      "group": "Text",
      "name": "join",
      "params": [
        "items: List",
        "separator: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "route := join([\"Oaxaca\", \"Puebla\"], \" to \")"
    },
    {
      "documentation": "Convert text to lowercase.",
      "group": "Text",
      "name": "lower",
      "params": [
        "text: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "slug := lower(\"Oaxaca\")"
    },
    {
      "documentation": "Convert text to uppercase.",
      "group": "Text",
      "name": "upper",
      "params": [
        "text: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "code := upper(\"mxn\")"
    },
    {
      "documentation": "Replace text occurrences.",
      "group": "Text",
      "name": "replace",
      "params": [
        "text: Text",
        "from: Text",
        "to: Text"
      ],
      "result": "Text",
      "tier": "toolkit",
      "try": "slug := replace(\"mexico city\", \" \", \"-\")"
    },
    {
      "documentation": "Add compatible quantities from a list, skipping nulls, or a row expression over each table row, keeping units.",
      "group": "Lists",
      "name": "sum",
      "params": [
        "items: List or Table",
        "expression?: row calculation"
      ],
      "result": "Number, Money, Ratio, or Duration",
      "tier": "note",
      "try": "prices := [$3, $4.50]\ntotal := sum(prices)"
    },
    {
      "documentation": "An idle countdown. Use Start timer to capture a timestamp; elapsed and started are persisted by timer controls.",
      "group": "Timers",
      "name": "countdown",
      "params": [
        "duration: Duration",
        "elapsed?: Duration",
        "started?: DateTime"
      ],
      "result": "Countdown",
      "tier": "note",
      "try": "focus := countdown(25m)\n\n- [ ] One focused session @timer(focus)"
    },
    {
      "documentation": "An idle stopwatch. Use Start, Pause, Resume, or Reset timer. Elapsed time includes time while the editor is closed.",
      "group": "Timers",
      "name": "stopwatch",
      "params": [
        "elapsed?: Duration",
        "started?: DateTime"
      ],
      "result": "Stopwatch",
      "tier": "note",
      "try": "work := stopwatch()\n\n- [ ] Investigate the flaky test @timer(work)"
    },
    {
      "documentation": "Declare a linear plan over the | constraint | expression | table below; undefined names become decisions.",
      "group": "Plans",
      "name": "maximize",
      "params": [
        "objective: linear expression"
      ],
      "result": "Plan",
      "tier": "note",
      "try": "400:flour_stock\n\nbakery := maximize($3 * bagels + $1.25 * doughnuts)\n| constraint | expression                                   |\n| ---------- | -------------------------------------------- |\n| flour      | 12 * bagels + 6.5 * doughnuts <= flour_stock |\n| milk       | bagels + 0.5 * doughnuts <= 200              |"
    },
    {
      "documentation": "Goal seek: the definition's own name is the unknown, set to the boundary value that makes the constraint hold.",
      "group": "Plans",
      "name": "solve",
      "params": [
        "constraint: expression with <=, >=, or =="
      ],
      "result": "Number, Money, or Duration",
      "tier": "note",
      "try": "$1,200:saved\n9:months_left\nsaved_by_june := monthly * months_left + saved\nmonthly := solve(saved_by_june >= $5,000)"
    },
    {
      "documentation": "Like maximize, but finds the smallest objective that satisfies every constraint in the table below.",
      "group": "Plans",
      "name": "minimize",
      "params": [
        "objective: linear expression"
      ],
      "result": "Plan",
      "tier": "note",
      "try": "plan := minimize(2 * crates)\n| constraint | expression   |\n| ---------- | ------------ |\n| demand     | crates >= 30 |"
    },
    {
      "documentation": "The current local calendar date. Updates at midnight.",
      "group": "Dates",
      "name": "today",
      "params": [],
      "result": "Date",
      "tier": "note",
      "try": "2026-11-20:departure\ndays_left := departure - today()"
    },
    {
      "documentation": "The current timestamp. Sampled once per evaluation; live hints refresh every second.",
      "group": "Dates",
      "name": "now",
      "params": [],
      "result": "DateTime",
      "tier": "note",
      "try": "stamp := now()\nin_an_hour := stamp + 1h"
    },
    {
      "documentation": "The cached exchange rate between two currencies, e.g. rate(EUR, USD). Refresh with wtf refresh or the ⟳ lookups lens; hovers show the age.",
      "group": "Lookups",
      "name": "rate",
      "params": [
        "from: currency code",
        "to: currency code"
      ],
      "result": "Number",
      "tier": "note",
      "try": "one_euro := rate(EUR, USD)"
    },
    {
      "documentation": "Convert money with the cached rate, e.g. to(hotel, USD); without one the note warns until wtf refresh.",
      "group": "Lookups",
      "name": "to",
      "params": [
        "amount: Money",
        "currency: code"
      ],
      "result": "Money",
      "tier": "note",
      "try": "hotel := 700 MXN\nusd := to(hotel, USD)"
    },
    {
      "documentation": "The cached forecast for a place and day, with .high, .low, .summary and .rain. Beyond 16 days, returns a seasonal outlook for up to about 7 months, labeled as an estimate. Seasonal .rain is the fraction of available ensemble runs with more than 0.1 mm of daily precipitation (including snow); it is unavailable with fewer than two valid runs. Itinerary days with a place get one automatically.",
      "group": "Lookups",
      "name": "forecast",
      "params": [
        "place: Text",
        "date: Date",
        "unit?: F or C"
      ],
      "result": "Forecast",
      "tier": "note",
      "try": "landing := forecast(\"Oaxaca\", 2026-11-20)"
    },
    {
      "documentation": "Cached daily forecasts in chronological order, including both dates. Project .high, .low, or .rain and pass the list to sparkline. One refresh requests the entire interval. Dates beyond 16 days use seasonal estimates; missing days remain lookup warnings until available. Limited to 4096 days.",
      "group": "Lookups",
      "name": "forecast_range",
      "params": [
        "place: Text",
        "start: Date",
        "end: Date",
        "unit?: F or C"
      ],
      "result": "List",
      "tier": "note",
      "try": "week := forecast_range(\"Oaxaca\", 2026-11-20, 2026-11-26, F)\nHighs °F: [sparkline(week.high)]\nRain: [sparkline(week.rain, 0%, 100%)]"
    },
    {
      "documentation": "The cached last price for a ticker, e.g. quote(NVDA); non-US tickers need a provider in .wtf/providers.json.",
      "group": "Lookups",
      "name": "quote",
      "params": [
        "symbol: ticker code"
      ],
      "result": "Money",
      "tier": "note",
      "try": "12:shares\nholding := quote(NVDA) * shares"
    },
    {
      "documentation": "Parse ISO or relative date text, or take a timestamp's calendar date in the request timezone.",
      "group": "Dates",
      "name": "date",
      "params": [
        "value: Text, Date, or DateTime"
      ],
      "result": "Date or DateTime",
      "tier": "note",
      "try": "friday := date(\"next Friday\")"
    },
    {
      "documentation": "Sum estimates of unfinished leaf tasks beneath a named heading.",
      "group": "Tasks",
      "name": "effort",
      "params": [
        "checklist: Checklist"
      ],
      "result": "Duration",
      "tier": "note",
      "try": "## Launch :launch\n\n- [ ] Record the demo @estimate(45m)\n- [ ] Update the changelog @estimate(20m)\n\nwork := effort(launch)"
    },
    {
      "documentation": "Count all leaf tasks beneath a named heading.",
      "group": "Tasks",
      "name": "total",
      "params": [
        "checklist: Checklist"
      ],
      "result": "Count",
      "tier": "note",
      "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\nsteps := total(launch)"
    },
    {
      "documentation": "Count completed leaf tasks beneath a named heading.",
      "group": "Tasks",
      "name": "completed",
      "params": [
        "checklist: Checklist"
      ],
      "result": "Count",
      "tier": "note",
      "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\ndone := completed(launch)"
    },
    {
      "documentation": "Count unfinished leaf tasks beneath a named heading.",
      "group": "Tasks",
      "name": "remaining",
      "params": [
        "checklist: Checklist"
      ],
      "result": "Count",
      "tier": "note",
      "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\nleft := remaining(launch)"
    }
  ],
  "library": [
    {
      "documentation": "Agenda selection is ordinary library code over the query API's entry records.",
      "exports": [
        {
          "documentation": "Select an inclusive date window from file-scoped or workspace entry records.",
          "name": "between",
          "params": [
            "entries",
            "first",
            "last"
          ],
          "try": "lib := import(\"agenda\")\nresult := lib.between(entries, first, last)"
        }
      ],
      "id": "agenda",
      "kind": "library"
    },
    {
      "documentation": "Shared presentation functions are ordinary library exports.",
      "exports": [
        {
          "documentation": "Render a fixed-width bar for a fraction between zero and one.",
          "name": "gauge",
          "params": [
            "fraction",
            "width"
          ],
          "try": "lib := import(\"format\")\nresult := lib.gauge(fraction, width)"
        },
        {
          "documentation": "Add a percentage to the standard ten-cell progress bar.",
          "name": "bar",
          "params": [
            "fraction"
          ],
          "try": "lib := import(\"format\")\nresult := lib.bar(fraction)"
        },
        {
          "documentation": "Format a duration as mm:ss or hh:mm:ss without losing seconds.",
          "name": "clock",
          "params": [
            "duration"
          ],
          "try": "lib := import(\"format\")\nresult := lib.clock(duration)"
        },
        {
          "documentation": "Describe a duration in hours and whole minutes.",
          "name": "human",
          "params": [
            "duration"
          ],
          "try": "lib := import(\"format\")\nresult := lib.human(duration)"
        },
        {
          "documentation": "Describe cache age with progressively coarser time units.",
          "name": "age",
          "params": [
            "elapsed"
          ],
          "try": "lib := import(\"format\")\nresult := lib.age(elapsed)"
        }
      ],
      "id": "format",
      "kind": "library"
    },
    {
      "documentation": "Unit conversion is ordinary pure arithmetic over named factor tables.",
      "exports": [
        {
          "documentation": "Name the dimension a unit belongs to, or report that it is unknown.",
          "name": "dimension",
          "params": [
            "unit"
          ],
          "try": "lib := import(\"units\")\nresult := lib.dimension(unit)"
        },
        {
          "documentation": "Convert between two units of the same dimension, e.g. convert(100, \"km\", \"mi\").",
          "name": "convert",
          "params": [
            "value",
            "from",
            "to"
          ],
          "try": "lib := import(\"units\")\nresult := lib.convert(value, from, to)"
        },
        {
          "documentation": "Round to two decimals and append the canonical unit for display.",
          "name": "format",
          "params": [
            "value",
            "unit"
          ],
          "try": "lib := import(\"units\")\nresult := lib.format(value, unit)"
        },
        {
          "documentation": "Convert and format in one step.",
          "name": "show",
          "params": [
            "value",
            "from",
            "to"
          ],
          "try": "lib := import(\"units\")\nresult := lib.show(value, from, to)"
        },
        {
          "documentation": "Common pairs, spelled out for notes that prefer a named function.",
          "name": "c_to_f",
          "params": [
            "value"
          ],
          "try": "lib := import(\"units\")\nresult := lib.c_to_f(value)"
        },
        {
          "documentation": "",
          "name": "f_to_c",
          "params": [
            "value"
          ],
          "try": "lib := import(\"units\")\nresult := lib.f_to_c(value)"
        },
        {
          "documentation": "",
          "name": "km_to_mi",
          "params": [
            "value"
          ],
          "try": "lib := import(\"units\")\nresult := lib.km_to_mi(value)"
        },
        {
          "documentation": "",
          "name": "mi_to_km",
          "params": [
            "value"
          ],
          "try": "lib := import(\"units\")\nresult := lib.mi_to_km(value)"
        },
        {
          "documentation": "",
          "name": "kg_to_lb",
          "params": [
            "value"
          ],
          "try": "lib := import(\"units\")\nresult := lib.kg_to_lb(value)"
        },
        {
          "documentation": "",
          "name": "lb_to_kg",
          "params": [
            "value"
          ],
          "try": "lib := import(\"units\")\nresult := lib.lb_to_kg(value)"
        }
      ],
      "id": "units",
      "kind": "library"
    }
  ],
  "syntaxes": [
    {
      "meaning": "a value with a name",
      "syntax": "$1,234:car"
    },
    {
      "meaning": "a calculation",
      "syntax": "total := car + $67"
    },
    {
      "meaning": "any value in a sentence",
      "syntax": "[total]"
    },
    {
      "meaning": "a date",
      "syntax": "2026-11-20:departure"
    },
    {
      "meaning": "a task with an attribute",
      "syntax": "- [ ] pack @due(departure - 14d)"
    },
    {
      "meaning": "a named heading that counts its tasks",
      "syntax": "## trip :trip"
    },
    {
      "meaning": "a timer",
      "syntax": "focus := countdown(25m)"
    }
  ],
  "types": [
    {
      "documentation": "A plain number, with , as an optional thousands separator.",
      "fields": [],
      "name": "Number",
      "tier": "scalar",
      "try": "12:units\n$8.50:unit_price\nsubtotal := units * unit_price"
    },
    {
      "documentation": "A whole number of things, as length and the checklist calls return it.",
      "fields": [],
      "name": "Count",
      "tier": "scalar",
      "try": "letters := length(\"Oaxaca\")"
    },
    {
      "documentation": "An amount in one currency; two currencies never add up silently.",
      "fields": [
        "amount",
        "currency",
        "type"
      ],
      "name": "Money",
      "tier": "scalar",
      "try": "price := $12.50\ncents := price.amount"
    },
    {
      "documentation": "A percentage, written 8.875%; it scales anything it multiplies.",
      "fields": [
        "value",
        "type"
      ],
      "name": "Ratio",
      "tier": "scalar",
      "try": "share := 8.875%\ntax := $100 * share"
    },
    {
      "documentation": "A span of whole seconds, written 30s, 20m, 2h, 14d or 2w.",
      "fields": [
        "seconds",
        "type"
      ],
      "name": "Duration",
      "tier": "scalar",
      "try": "slot := 90m\nminutes := slot.seconds / 60"
    },
    {
      "documentation": "A calendar date, written 2026-11-20; dates subtract to a duration.",
      "fields": [
        "value",
        "type"
      ],
      "name": "Date",
      "tier": "scalar",
      "try": "2026-11-20:departure\ndays_left := departure - today()"
    },
    {
      "documentation": "A timestamp with a UTC offset, written 2026-11-20T09:30-06:00.",
      "fields": [
        "value",
        "type"
      ],
      "name": "DateTime",
      "tier": "scalar",
      "try": "landing := 2026-11-20T09:30-06:00\nhour := landing + 90m"
    },
    {
      "documentation": "true or false, as comparisons and named tasks produce it.",
      "fields": [],
      "name": "Boolean",
      "tier": "scalar",
      "try": "$500:budget\n$420:spent\nbudget_ok := spent <= budget"
    },
    {
      "documentation": "Text in double quotes; an uppercase code such as USD is text too.",
      "fields": [],
      "name": "Text",
      "tier": "scalar",
      "try": "\"Oaxaca\":city\ngreeting := \"Hello from \" + city"
    },
    {
      "documentation": "An ordered list of values, written [a, b, c].",
      "fields": [],
      "name": "List",
      "tier": "scalar",
      "try": "prices := [$3, $4.50]\ntotal := sum(prices)"
    },
    {
      "documentation": "Named fields, written {key: value}; read them with a dot.",
      "fields": [],
      "name": "Record",
      "tier": "scalar",
      "try": "trip := {city: \"Oaxaca\", nights: 3}\nwhere := trip.city"
    },
    {
      "documentation": "No value: a missing lookup, an absent field, or the literal null.",
      "fields": [],
      "name": "Null",
      "tier": "scalar",
      "try": "missing := null\nname := coalesce(missing, \"friend\")"
    },
    {
      "documentation": "A pure function, written fn(a, b) => expression.",
      "fields": [],
      "name": "Function",
      "tier": "object",
      "try": "double := fn(n) => n * 2\nfour := double(2)"
    },
    {
      "documentation": "Another note or module, imported by name; its members resolve lazily.",
      "fields": [],
      "name": "Namespace",
      "tier": "object",
      "try": "units := import(\"units\")\nmiles := units.convert(100, \"km\", \"mi\")"
    },
    {
      "documentation": "A cached day of weather, with .high, .low, .summary and .rain. Seasonal outlooks include estimated temperatures and precipitation chance, labeled as estimates.",
      "fields": [],
      "name": "Forecast",
      "tier": "object",
      "try": "landing := forecast(\"Oaxaca\", 2026-11-20)"
    },
    {
      "documentation": "A link, file, place or GitHub item, with cached metadata and an Open lens.",
      "fields": [],
      "name": "Resource",
      "tier": "object",
      "try": "https://example.com/docs:docs\n\n- [ ] Read the [docs]"
    },
    {
      "documentation": "A named heading: the tasks beneath it, counted by total and completed.",
      "fields": [],
      "name": "Checklist",
      "tier": "object",
      "try": "## Launch :launch\n\n- [x] Draft the announcement\n- [ ] Ship it\n\ndone := completed(launch)"
    },
    {
      "documentation": "A countdown timer started from a duration; controls persist its state.",
      "fields": [],
      "name": "Countdown",
      "tier": "object",
      "try": "focus := countdown(25m)\nleft := focus.remaining"
    },
    {
      "documentation": "A stopwatch that counts up; elapsed time survives a closed editor.",
      "fields": [],
      "name": "Stopwatch",
      "tier": "object",
      "try": "work := stopwatch()\nspent := work.elapsed"
    },
    {
      "documentation": "A Markdown table with typed columns, read by sum and the row calls.",
      "fields": [],
      "name": "Table",
      "tier": "object",
      "try": "groceries := table\n| item  | quantity | price |\n| ----- | -------- | ----- |\n| apple | 2        | $3.30 |\n| pear  | 4        | $4.30 |\n\ntotal := sum(groceries, quantity * price)"
    },
    {
      "documentation": "A solved linear plan: its decisions and its constraint slack.",
      "fields": [],
      "name": "Plan",
      "tier": "object",
      "try": "bakery := maximize($3 * bagels + $1.25 * doughnuts)\n| constraint | expression                        |\n| ---------- | --------------------------------- |\n| flour      | 12 * bagels + 6.5 * doughnuts <= 400 |\n\nbake := bakery.bagels"
    },
    {
      "documentation": "No value has this kind: it types a table's yes/no decision column.",
      "fields": [],
      "name": "Choice",
      "tier": "object",
      "try": "gear := table\n| item  | weight | value | take? |\n| ----- | ------ | ----- | ----- |\n| tent  | 3      | 9     |       |\n| stove | 1      | 4     |       |\n\npack := maximize(sum(gear, value * take))\n| constraint | expression                    |\n| ---------- | ----------------------------- |\n| weight     | sum(gear, weight * take) <= 3 |"
    }
  ],
  "version": 2
}

### 1 cli reference
$ wtf reference
exit 0
--- stdout
# wtf reference (v2)

## Syntax

| syntax | meaning |
| --- | --- |
| `$1,234:car` | a value with a name |
| `total := car + $67` | a calculation |
| `[total]` | any value in a sentence |
| `2026-11-20:departure` | a date |
| `- [ ] pack @due(departure - 14d)` | a task with an attribute |
| `## trip :trip` | a named heading that counts its tasks |
| `focus := countdown(25m)` | a timer |

## Functions

### Values

`debug(value: Value) -> Text`
Inspect any value as compact JSON text in an inlay. Records, lists, and host objects expose their fields; money, dates, durations, and ratios keep their type and units.

```wtf
weather := {high: 25, rain: 35%}
[debug(weather)]
```

`sparkline(values: List, min?: Number, Money, Ratio, or Duration, max?: Number, Money, Ratio, or Duration) -> Text`
Draw one Unicode bar per numeric value, in list order. Null leaves a gap (·). The scale uses the data's minimum and maximum unless both bounds are supplied; values outside fixed bounds are clipped. Values and bounds must use matching units.

```wtf
sales := [12, 18, 9, 24]
[sparkline(sales)]
[sparkline([20%, 40%, 30%], 0%, 100%)]
```

### Lists

`sum(items: List or Table, expression?: row calculation) -> Number, Money, Ratio, or Duration`
Add compatible quantities from a list, skipping nulls, or a row expression over each table row, keeping units.

```wtf
prices := [$3, $4.50]
total := sum(prices)
```

### Dates

`today() -> Date`
The current local calendar date. Updates at midnight.

```wtf
2026-11-20:departure
days_left := departure - today()
```

`now() -> DateTime`
The current timestamp. Sampled once per evaluation; live hints refresh every second.

```wtf
stamp := now()
in_an_hour := stamp + 1h
```

`date(value: Text, Date, or DateTime) -> Date or DateTime`
Parse ISO or relative date text, or take a timestamp's calendar date in the request timezone.

```wtf
friday := date("next Friday")
```

### Tasks

`effort(checklist: Checklist) -> Duration`
Sum estimates of unfinished leaf tasks beneath a named heading.

```wtf
## Launch :launch

- [ ] Record the demo @estimate(45m)
- [ ] Update the changelog @estimate(20m)

work := effort(launch)
```

`total(checklist: Checklist) -> Count`
Count all leaf tasks beneath a named heading.

```wtf
## Launch :launch

- [x] Draft the announcement
- [ ] Ship it

steps := total(launch)
```

`completed(checklist: Checklist) -> Count`
Count completed leaf tasks beneath a named heading.

```wtf
## Launch :launch

- [x] Draft the announcement
- [ ] Ship it

done := completed(launch)
```

`remaining(checklist: Checklist) -> Count`
Count unfinished leaf tasks beneath a named heading.

```wtf
## Launch :launch

- [x] Draft the announcement
- [ ] Ship it

left := remaining(launch)
```

### Timers

`countdown(duration: Duration, elapsed?: Duration, started?: DateTime) -> Countdown`
An idle countdown. Use Start timer to capture a timestamp; elapsed and started are persisted by timer controls.

```wtf
focus := countdown(25m)

- [ ] One focused session @timer(focus)
```

`stopwatch(elapsed?: Duration, started?: DateTime) -> Stopwatch`
An idle stopwatch. Use Start, Pause, Resume, or Reset timer. Elapsed time includes time while the editor is closed.

```wtf
work := stopwatch()

- [ ] Investigate the flaky test @timer(work)
```

### Lookups

`rate(from: currency code, to: currency code) -> Number`
The cached exchange rate between two currencies, e.g. rate(EUR, USD). Refresh with wtf refresh or the ⟳ lookups lens; hovers show the age.

```wtf
one_euro := rate(EUR, USD)
```

`to(amount: Money, currency: code) -> Money`
Convert money with the cached rate, e.g. to(hotel, USD); without one the note warns until wtf refresh.

```wtf
hotel := 700 MXN
usd := to(hotel, USD)
```

`forecast(place: Text, date: Date, unit?: F or C) -> Forecast`
The cached forecast for a place and day, with .high, .low, .summary and .rain. Beyond 16 days, returns a seasonal outlook for up to about 7 months, labeled as an estimate. Seasonal .rain is the fraction of available ensemble runs with more than 0.1 mm of daily precipitation (including snow); it is unavailable with fewer than two valid runs. Itinerary days with a place get one automatically.

```wtf
landing := forecast("Oaxaca", 2026-11-20)
```

`forecast_range(place: Text, start: Date, end: Date, unit?: F or C) -> List`
Cached daily forecasts in chronological order, including both dates. Project .high, .low, or .rain and pass the list to sparkline. One refresh requests the entire interval. Dates beyond 16 days use seasonal estimates; missing days remain lookup warnings until available. Limited to 4096 days.

```wtf
week := forecast_range("Oaxaca", 2026-11-20, 2026-11-26, F)
Highs °F: [sparkline(week.high)]
Rain: [sparkline(week.rain, 0%, 100%)]
```

`quote(symbol: ticker code) -> Money`
The cached last price for a ticker, e.g. quote(NVDA); non-US tickers need a provider in .wtf/providers.json.

```wtf
12:shares
holding := quote(NVDA) * shares
```

### Plans

`maximize(objective: linear expression) -> Plan`
Declare a linear plan over the | constraint | expression | table below; undefined names become decisions.

```wtf
400:flour_stock

bakery := maximize($3 * bagels + $1.25 * doughnuts)
| constraint | expression                                   |
| ---------- | -------------------------------------------- |
| flour      | 12 * bagels + 6.5 * doughnuts <= flour_stock |
| milk       | bagels + 0.5 * doughnuts <= 200              |
```

`solve(constraint: expression with <=, >=, or ==) -> Number, Money, or Duration`
Goal seek: the definition's own name is the unknown, set to the boundary value that makes the constraint hold.

```wtf
$1,200:saved
9:months_left
saved_by_june := monthly * months_left + saved
monthly := solve(saved_by_june >= $5,000)
```

`minimize(objective: linear expression) -> Plan`
Like maximize, but finds the smallest objective that satisfies every constraint in the table below.

```wtf
plan := minimize(2 * crates)
| constraint | expression   |
| ---------- | ------------ |
| demand     | crates >= 30 |
```

### Modules

`import(id: Text) -> Record`
Load a module by ID, or a note by path such as import("./values.wtf"); members keep their own source.

```wtf
units := import("units")
miles := units.convert(100, "km", "mi")
```

### Control

`if(condition: Boolean, then: Value, else: Value) -> Value`
Evaluate only the selected branch.

```wtf
stock := 3
label := if(stock > 0, "in stock", "sold out")
```

`coalesce(values: Value...) -> Value`
Return the first non-null value.

```wtf
nickname := null
name := coalesce(nickname, "friend")
```

### Toolkit

#### Values

`object(entries: List) -> Record`
Build a record from key/value pairs; duplicate keys are rejected.

```wtf
pairs := [{key: "city", value: "Oaxaca"}, {key: "nights", value: 3}]
trip := object(pairs)
```

`entries(record: Record) -> List`
List key/value pairs in key order.

```wtf
nights := {oaxaca: 3, mexico_city: 2}
pairs := entries(nights)
```

`number(value: Number, Money, Ratio, Duration or Count) -> Number`
Extract the numeric magnitude; durations use seconds.

```wtf
slot := 90m
seconds := number(slot)
```

`source(value: Any) -> Text`
Format a typed scalar as a round-trippable expression.

```wtf
departure := today() + 7d
literal := source(departure)
```

`type(value: Any) -> Text`
Get the runtime type name.

```wtf
price := $12.50
kind := type(price)
```

`get(collection: Record or List, key: Text or Number) -> Value`
Read a field or index; return null when absent.

```wtf
trip := {city: "Oaxaca", nights: 3}
city := get(trip, "city")
```

`length(value: List, Record, or Text) -> Count`
Count items, fields, or Unicode characters.

```wtf
letters := length("Oaxaca")
```

#### Text

`pad_start(text: Text, width: Number, fill: Text) -> Text`
Pad text to a character width with one character.

```wtf
minute := pad_start("3", 2, "0")
```

`pad_end(text: Text, width: Number, fill: Text) -> Text`
Pad text on the right.

```wtf
cell := pad_end("pear", 8, " ")
```

`trim(text: Text) -> Text`
Remove surrounding whitespace.

```wtf
city := trim("  Oaxaca  ")
```

`repeat(text: Text, count: Number) -> Text`
Repeat text a bounded number of times.

```wtf
bar := repeat("█", 3)
```

`text(value: Value) -> Text`
Format a value as text; null remains null.

```wtf
price := $25
label := "Lunch costs " + text(price)
```

`contains(value: List or Text, part: Value) -> Boolean`
Test membership or a text substring.

```wtf
has_ell := contains("hello", "ell")
```

`starts_with(text: Text, prefix: Text) -> Boolean`
Test a text prefix.

```wtf
local := starts_with("+52 951", "+52")
```

`ends_with(text: Text, suffix: Text) -> Boolean`
Test a text suffix.

```wtf
is_note := ends_with("trip.wtf", ".wtf")
```

`split(text: Text, separator: Text) -> List`
Split text into pieces.

```wtf
parts := split("2026-11-20", "-")
```

`join(items: List, separator: Text) -> Text`
Join a list of text.

```wtf
route := join(["Oaxaca", "Puebla"], " to ")
```

`lower(text: Text) -> Text`
Convert text to lowercase.

```wtf
slug := lower("Oaxaca")
```

`upper(text: Text) -> Text`
Convert text to uppercase.

```wtf
code := upper("mxn")
```

`replace(text: Text, from: Text, to: Text) -> Text`
Replace text occurrences.

```wtf
slug := replace("mexico city", " ", "-")
```

#### Lists

`slice(value: Text or List, start: Number, end: Number) -> Text or List`
Take a half-open range; text indices count Unicode characters.

```wtf
code := slice("OAXACA", 0, 3)
```

`concat(lists: List...) -> List`
Concatenate lists.

```wtf
legs := concat(["Oaxaca", "Puebla"], ["Mexico City"])
```

`map(items: List, function: Function) -> List`
Apply a pure function to every item.

```wtf
prices := [$3, $4.50]
doubled := map(prices, fn(p) => p * 2)
```

`filter(items: List, predicate: Function) -> List`
Keep items whose predicate returns true.

```wtf
sizes := [1, 2, 3]
big := filter(sizes, fn(n) => n > 1)
```

`sort_by(items: List, key: Function) -> List`
Stable ascending sort by a compatible scalar key; nulls come last.

```wtf
cities := ["Puebla", "Oaxaca"]
sorted := sort_by(cities, fn(c) => c)
```

`group_by(items: List, key: Function) -> List`
Group by a scalar key into {key, rows} records, in first-seen order.

```wtf
votes := ["yes", "no", "yes"]
tallies := group_by(votes, fn(v) => v)
```

`fold(items: List, initial: Value, function: Function) -> Value`
Combine items left to right with an accumulator.

```wtf
nights := [2, 3, 1]
total := fold(nights, 0, fn(sum, n) => sum + n)
```

#### Numbers

`floor(number: Number) -> Number`
Round down to an integer.

```wtf
nights := floor(2.8)
```

`round(number: Number) -> Number`
Round to the nearest integer.

```wtf
nights := round(2.8)
```

## Attributes

`@timer(timer: Timer)`
Associate a named timer with this task. Completion does not stop the timer.

```wtf
focus := countdown(25m)

- [ ] One focused session @timer(focus)
```

`@due(date: Date or DateTime)`
Deadline. Accepts a named date, an expression, or relative input such as tomorrow. Use Freeze relative date to capture it.

```wtf
2026-11-20:departure

- [ ] Book the hotel @due(departure - 14d)
```

`@scheduled(date: Date or DateTime)`
Planned work date; separate from the deadline.

```wtf
- [ ] Book flights @scheduled(2026-10-01) @due(2026-10-10)
```

`@at(time: Date or DateTime)`
Appointment time. Include an explicit UTC offset for ambiguous local times.

```wtf
- Dentist @at(2026-09-25T09:30-04:00)
```

`@estimate(effort: Duration)`
A nonnegative estimate. Examples: 30s, 20m, 2h.

```wtf
- [ ] Update the changelog @estimate(20m)
```

`@after(dependency: Boolean or Checklist, more dependencies...)`
Block this task until all dependencies are satisfied. Cycles are reported with source locations.

```wtf
- [x] Order parts :parts
- [ ] Assemble @after(parts)
```

`@every(interval: recurrence)`
Repeat a leaf task: day, week, month, year, or a positive whole-day duration such as 2w.

```wtf
- [ ] Water the plants @every(week) @due(2026-09-20)
```

`@tag(tag: name)`
Tag a task for filtering. Multiple tags may be comma-separated.

```wtf
- [ ] Renew passport @tag(errands)
```

## Types

`Number`
A plain number, with , as an optional thousands separator.

```wtf
12:units
$8.50:unit_price
subtotal := units * unit_price
```

`Count`
A whole number of things, as length and the checklist calls return it.

```wtf
letters := length("Oaxaca")
```

`Money` — fields: amount, currency, type
An amount in one currency; two currencies never add up silently.

```wtf
price := $12.50
cents := price.amount
```

`Ratio` — fields: value, type
A percentage, written 8.875%; it scales anything it multiplies.

```wtf
share := 8.875%
tax := $100 * share
```

`Duration` — fields: seconds, type
A span of whole seconds, written 30s, 20m, 2h, 14d or 2w.

```wtf
slot := 90m
minutes := slot.seconds / 60
```

`Date` — fields: value, type
A calendar date, written 2026-11-20; dates subtract to a duration.

```wtf
2026-11-20:departure
days_left := departure - today()
```

`DateTime` — fields: value, type
A timestamp with a UTC offset, written 2026-11-20T09:30-06:00.

```wtf
landing := 2026-11-20T09:30-06:00
hour := landing + 90m
```

`Boolean`
true or false, as comparisons and named tasks produce it.

```wtf
$500:budget
$420:spent
budget_ok := spent <= budget
```

`Text`
Text in double quotes; an uppercase code such as USD is text too.

```wtf
"Oaxaca":city
greeting := "Hello from " + city
```

`List`
An ordered list of values, written [a, b, c].

```wtf
prices := [$3, $4.50]
total := sum(prices)
```

`Record`
Named fields, written {key: value}; read them with a dot.

```wtf
trip := {city: "Oaxaca", nights: 3}
where := trip.city
```

`Null`
No value: a missing lookup, an absent field, or the literal null.

```wtf
missing := null
name := coalesce(missing, "friend")
```

### Engine objects

`Function`
A pure function, written fn(a, b) => expression.

```wtf
double := fn(n) => n * 2
four := double(2)
```

`Namespace`
Another note or module, imported by name; its members resolve lazily.

```wtf
units := import("units")
miles := units.convert(100, "km", "mi")
```

`Forecast`
A cached day of weather, with .high, .low, .summary and .rain. Seasonal outlooks include estimated temperatures and precipitation chance, labeled as estimates.

```wtf
landing := forecast("Oaxaca", 2026-11-20)
```

`Resource`
A link, file, place or GitHub item, with cached metadata and an Open lens.

```wtf
https://example.com/docs:docs

- [ ] Read the [docs]
```

`Checklist`
A named heading: the tasks beneath it, counted by total and completed.

```wtf
## Launch :launch

- [x] Draft the announcement
- [ ] Ship it

done := completed(launch)
```

`Countdown`
A countdown timer started from a duration; controls persist its state.

```wtf
focus := countdown(25m)
left := focus.remaining
```

`Stopwatch`
A stopwatch that counts up; elapsed time survives a closed editor.

```wtf
work := stopwatch()
spent := work.elapsed
```

`Table`
A Markdown table with typed columns, read by sum and the row calls.

```wtf
groceries := table
| item  | quantity | price |
| ----- | -------- | ----- |
| apple | 2        | $3.30 |
| pear  | 4        | $4.30 |

total := sum(groceries, quantity * price)
```

`Plan`
A solved linear plan: its decisions and its constraint slack.

```wtf
bakery := maximize($3 * bagels + $1.25 * doughnuts)
| constraint | expression                        |
| ---------- | --------------------------------- |
| flour      | 12 * bagels + 6.5 * doughnuts <= 400 |

bake := bakery.bagels
```

`Choice`
No value has this kind: it types a table's yes/no decision column.

```wtf
gear := table
| item  | weight | value | take? |
| ----- | ------ | ----- | ----- |
| tent  | 3      | 9     |       |
| stove | 1      | 4     |       |

pack := maximize(sum(gear, value * take))
| constraint | expression                    |
| ---------- | ----------------------------- |
| weight     | sum(gear, weight * take) <= 3 |
```

## Query

### Collections

`links` — fields: kind, title, line, anchor, source, errors, url
Every link written in the prose of a note.

```wtf
links | select {url}
```

`tasks` — fields: kind, title, line, anchor, source, errors, due, scheduled, at, estimate, at_date, parent, tags, blocked_by, done, leaf, checked, name, attributes, blocked_error, schedule, children, timer
Every task, with its dates, estimate, tags and what blocks it.

```wtf
tasks | where !done
```

`events` — fields: kind, title, line, anchor, source, errors, due, scheduled, at, estimate, at_date, parent, tags, blocked_by, done, leaf
Appointments: the lines carrying an @at time.

```wtf
events | sort at | select {title, at}
```

`entries` — fields: kind, title, line, anchor, source, errors, due, scheduled, at, estimate, at_date, parent, tags, blocked_by, done, leaf, checked, name, attributes, blocked_error, schedule, children, timer
Tasks, appointments and stops together, ready for one timeline.

```wtf
entries | where due != null | sort due
```

`values` — fields: kind, title, line, anchor, source, errors, name, expression, value, type, display, computed
Every named value, with its expression and evaluated result.

```wtf
values | select {name, display}
```

`plans` — fields: kind, title, line, anchor, source, errors, name, expression, value, type, display, computed, solution
Linear plans, with the solution the solver found.

```wtf
plans | select {name, solution}
```

`tables` — fields: kind, title, line, anchor, source, errors, name, expression, value, type, display, computed
Every table definition, with its columns and rows.

```wtf
tables | select {name, display}
```

`rows` — fields: kind, title, line, anchor, source, errors, table, cells
One record per table row, with its cells by column name.

```wtf
rows | where cells.price > $4 | select {cells}
```

`resources` — fields: kind, title, line, anchor, source, errors, target, metadata
Links, files, places and GitHub items, with cached metadata.

```wtf
resources | select {target, metadata}
```

`diagnostics` — fields: kind, title, line, anchor, source, errors, message, severity, code
The problems a note has, as rows: the ci check in the README.

```wtf
diagnostics | where severity == "error"
```

`notes` — fields: kind, title, line, anchor, source, errors, text
One record per note in the workspace, carrying its whole text.

```wtf
notes | select {title, line}
```

`sections` — fields: kind, title, line, anchor, source, errors, end_line, level
Every heading, with the span of lines it covers.

```wtf
sections | where level == 2 | select {title}
```

### Commands

`lsp` — Start the language server over stdin/stdout (for editor integrations)
    wtf lsp
`query` — Query tasks, values, tables, plans, resources and diagnostics
    wtf query [OPTIONS] <QUERY>                (note on stdin)
    wtf query [OPTIONS] <FILE> <QUERY>
    wtf query [OPTIONS] --workspace <QUERY>
`render` — Export a saved note with the language server's colors and inline values
    wtf render [OPTIONS] <FILE>
`ast` — Inspect syntax nodes, source text and expression trees for one note (JSON)
    wtf ast [OPTIONS] <FILE>
`graph` — Inspect dependencies between values, tasks and checklists in one note (JSON)
    wtf graph [OPTIONS] <FILE>
`refresh` — Explicitly refresh cached resource status and external lookups
    wtf refresh [OPTIONS]
`sync` — Keep a directory of notes in step with a folder in the web app
    wtf sync [OPTIONS] <DIR>
`reference` — Print the whole language reference: Markdown, or --json for tools
    wtf reference [OPTIONS]

## Library

### agenda

Agenda selection is ordinary library code over the query API's entry records.

- `between(entries, first, last)` Select an inclusive date window from file-scoped or workspace entry records.

### format

Shared presentation functions are ordinary library exports.

- `gauge(fraction, width)` Render a fixed-width bar for a fraction between zero and one.
- `bar(fraction)` Add a percentage to the standard ten-cell progress bar.
- `clock(duration)` Format a duration as mm:ss or hh:mm:ss without losing seconds.
- `human(duration)` Describe a duration in hours and whole minutes.
- `age(elapsed)` Describe cache age with progressively coarser time units.

### units

Unit conversion is ordinary pure arithmetic over named factor tables.

- `dimension(unit)` Name the dimension a unit belongs to, or report that it is unknown.
- `convert(value, from, to)` Convert between two units of the same dimension, e.g. convert(100, "km", "mi").
- `format(value, unit)` Round to two decimals and append the canonical unit for display.
- `show(value, from, to)` Convert and format in one step.
- `c_to_f(value)` Common pairs, spelled out for notes that prefer a named function.
- `f_to_c(value)` 
- `km_to_mi(value)` 
- `mi_to_km(value)` 
- `kg_to_lb(value)` 
- `lb_to_kg(value)` 

## Module authoring

### Functions

#### Dates

`parse_date(text: Text, format: Text) -> Date or Null`
Parse a calendar date with a strftime format; invalid input returns null.

```wtf
departure := parse_date("2026-11-20", "%F")
```

`parse_datetime(text: Text, format: Text, offset: DateTime) -> DateTime or Null`
Parse a local timestamp using a reference timestamp's offset.

```wtf
landing := parse_datetime("2026-11-20 09:30", "%F %H:%M", now())
```

`make_date(year: Number, month: Number, day: Number) -> Date or Null`
Construct a calendar date; invalid dates return null.

```wtf
departure := make_date(2026, 11, 20)
```

`duration_parts(duration: Duration) -> Record`
Split integer seconds into total hours, remaining minutes and seconds without rounding.

```wtf
parts := duration_parts(90m)
minutes := parts.minutes
```

`date_parts(date: Date or DateTime) -> Record`
Read year, month, day and weekday (Monday is zero).

```wtf
parts := date_parts(today())
year := parts.year
```

`at_time(date: Date, time: Duration, offset: DateTime) -> DateTime`
Combine a date and time of day using the reference timestamp offset.

```wtf
standup := at_time(today(), 9h, now())
```

`parse_time(text: Text, format: Text) -> Duration or Null`
Parse a time of day as seconds since midnight.

```wtf
opens := parse_time("09:30", "%H:%M")
```

`parse_duration(text: Text) -> Duration or Null`
Parse a written duration.

```wtf
slot := parse_duration("2h")
```

`format_date(date: Date or DateTime, format: Text) -> Text`
Format a date or timestamp with strftime directives.

```wtf
stamp := format_date(today(), "%Y-%m-%d")
```

#### Plans

`solve_linear(model: Record) -> Record`
Solve a bounded linear model and return raw numeric values and status.

```wtf
best := solve_linear({goal: "maximize", variables: {x: {kind: "integer", lower: 0, upper: 3}}, objective: {constant: 0, terms: {x: 1}}, constraints: []})
status := best.status
```

#### Control

`error(message: Text) -> Never`
Return an evaluation error.

```wtf
budget := $500
checked := if(budget > $0, budget, error("Budget must be positive"))
```

`eval(expression: Text) -> Value`
Evaluate expression text in the current document's scope.

```wtf
price := $12.50
doubled := eval("price * 2")
```

### Collections

`ast` — fields: id, kind, name, parent, children, text, source
Every syntax node in a note: its kind, text and parent.

```wtf
ast | where kind == "definition" | select {name, text}
```

`days` — fields: kind, title, line, anchor, source, errors, value
One record per itinerary day, with its date and cached forecast.

```wtf
days | select {title, line}
```

`timers` — fields: kind, title, line, anchor, source, errors, name, definition, inlay, value, origin
Every countdown and stopwatch, at each definition and reference.

```wtf
timers | where definition | select {name, value}
```

`stops` — fields: kind, title, line, anchor, source, errors, due, scheduled, at, estimate, at_date, parent, tags, blocked_by, done, leaf
Itinerary stops, placed on the day they belong to.

```wtf
stops | select {title, at}
```

`decisions` — fields: kind, title, line, anchor, source, errors, value, plan
Each decision a plan made, at the table cell it belongs in.

```wtf
decisions | select {plan, title, value}
```

`calculations` — fields: kind, title, line, anchor, source, errors, expression, value, type, display, bracketed
Every calculation written in prose, with its value.

```wtf
calculations | select {expression, display}
```

`references` — fields: kind, title, line, anchor, source, errors, expression, value, type, display, name, property
Every bracketed reference, with the value it resolved to.

```wtf
references | select {name, display}
```

`cells` — fields: kind, title, line, anchor, source, errors, expression, value, type, display, computed, table, row, column
Every table cell, with its expression and value.

```wtf
cells | where computed | select {expression, display}
```

### Bundled modules

| id | kind | about |
| --- | --- | --- |
| definitions | feature | Computed definitions share their evaluated values and hovers with queries. |
| tasks | feature | Tasks are decorated entirely from the catalog: dates, blockers, children, timers. |
| references | feature | Bracket references use the same expression records as document queries. |
| links | feature | Resource views are resolved through this workspace's host modules and cache. |
| itinerary_core | library | Calendar policy and presentation use shared date and collection primitives. |
| itinerary | feature | Itinerary days are decorated from the parsed day records the catalog holds. |
| timers | feature | Timers show their own state, and only ask for live refreshes while one runs. |
| plans | feature | Plans present the solver's answer: decisions, constraint slack and errors. |
| plan | library | Plan policy surrounds the generic numerical primitive. |
| timer | library | Timer state and transitions. Rust carries the typed value and applies edits. |
| github | link | GitHub is an ordinary link module. Null namespace reads pre-module caches. |
| rss | link | Any RSS or Atom feed, on any host: a link module that recognizes a URL shape rather than a site, so it declares `hosts: "*"` and decides in `matches`. The host parses the feed (`format: "feed"`), so `decode` reads plain records. |
| table_cells | feature | Computed table cells retain their exact source anchor and typed display value. |
| checklists | feature | Section progress is a projection of leaf tasks, including evaluated completion. |
| calculations | feature | Inline calculations use the same evaluated records as `wtf query calculations`. |

### Hooks

- `collect/1` (feature) Return the records this feature contributes for one note.
- `inlay/1` (link) The inline text shown after a matching link.
- `hover/1` (both) The markdown shown when a matching link is hovered.
- `property/2` (both) Read one property off a matching link's cached data.
- `refresh/1` (both) Describe the request that refreshes a matching link.
- `decode/2` (both) Turn a refresh response into the metadata that is cached.
- `matches/1` (both) Decide whether a target belongs to this module at all.
- `property_names/1` (both) The property names completion offers for a matching link.
- `time_dependent/1` (both) Whether a value has to be recomputed as the clock moves.
- `actions/1` (both) Code actions and lenses this module offers on a note.
- `reduce/2` (both) Fold this module's records into a workspace-wide answer.
- `hovers/1` (both) Extra hovers this module contributes to a note.
- `diagnostics/1` (both) Extra diagnostics this module reports for a note.
- `format/1` (both) Rewrite a note's text when it is formatted.

