### 0 cli render clock.wtf --format text
$ wtf render clock.wtf --format text --root <root> --now 2026-09-18T12:00:00Z
exit 0
--- stdout
clock := now() 2026-09-18T12:00:00+00:00 second

### 1 cli render missing.wtf --format text
$ wtf render missing.wtf --format text --root <root> --now 2026-09-18T12:00:00Z
exit 1
--- stderr
wtf: <root>/missing.wtf: No such file or directory (os error 2)

