{
  "steps": [
    { "cli": ["render", "calc.x.md", "--format", "text"] },
    { "cli": ["query", "calc.x.md", "cells | select {title, line, value}", "--json"] },
    { "cli": ["query", "calc.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    {
      "lsp": [
        { "open": "calc.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "calc.x.md" },
        { "request": "textDocument/hover", "file": "calc.x.md", "line": 6, "character": 11 },
        {
          "request": "textDocument/references",
          "file": "calc.x.md",
          "line": 0,
          "character": 7,
          "extra": { "context": { "includeDeclaration": true } }
        },
        {
          "request": "textDocument/formatting",
          "file": "calc.x.md",
          "extra": { "options": { "tabSize": 2, "insertSpaces": true } }
        }
      ]
    },
    { "cli": ["query", "wrong.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    {
      "lsp": [
        { "open": "wrong.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "wrong.x.md" }
      ]
    },
    { "cli": ["query", "unknown.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["query", "empty.x.md", "diagnostics | select {line, severity, code, message}", "--json"] }
  ]
}
