### 5 lsp
-- open wrong.wtf
-- await textDocument/publishDiagnostics wrong.wtf
{
  "diagnostics": [
    {
      "code": "evaluation",
      "message": "Column 'price' expects Money, found Number",
      "range": {
        "end": {
          "character": 14,
          "line": 7
        },
        "start": {
          "character": 11,
          "line": 7
        }
      },
      "severity": 1,
      "source": "wtf"
    }
  ],
  "uri": "file://<root>/wrong.wtf",
  "version": 1
}

