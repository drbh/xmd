### 1 lsp
-- open crlf.wtf
-- await textDocument/publishDiagnostics crlf.wtf
{
  "diagnostics": [],
  "uri": "file://<root>/crlf.wtf",
  "version": 1
}
-- request textDocument/formatting crlf.wtf
[
  {
    "newText": "| item        | n    |",
    "range": {
      "end": {
        "character": 8,
        "line": 2
      },
      "start": {
        "character": 0,
        "line": 2
      }
    }
  },
  {
    "newText": "| :---------: | ---: |",
    "range": {
      "end": {
        "character": 12,
        "line": 3
      },
      "start": {
        "character": 0,
        "line": 3
      }
    }
  },
  {
    "newText": "| \"梨 | pear\" | 2    |",
    "range": {
      "end": {
        "character": 14,
        "line": 4
      },
      "start": {
        "character": 0,
        "line": 4
      }
    }
  },
  {
    "newText": "| apple\\|pear | 4    |",
    "range": {
      "end": {
        "character": 15,
        "line": 5
      },
      "start": {
        "character": 0,
        "line": 5
      }
    }
  }
]
-- applied to crlf.wtf (version 2)
# Shopping␍
[t] := table␍
| item        | n    |␍
| :---------: | ---: |␍
| "梨 | pear" | 2    |␍
| apple\|pear | 4    |␍
␍
| ordinary | table |␍
|---|---|␍
|leave|alone|
-- request textDocument/formatting crlf.wtf
[]

### 2 cli query crlf.wtf sum(t, n) --json
$ wtf query crlf.wtf sum(t, n) --json --root <root> --now 2026-09-16T14:00:00-04:00
exit 0
--- stdout
[
  6
]

