{
  "steps": [
    { "cli": ["query", "bad.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["query", "attributes.x.md", "diagnostics | select {line, severity, code, message}", "--json"] },
    { "cli": ["render", "attributes.x.md", "--format", "text"] },
    {
      "lsp": [
        { "open": "attributes.x.md" },
        { "await": "textDocument/publishDiagnostics", "file": "attributes.x.md" }
      ]
    }
  ]
}
