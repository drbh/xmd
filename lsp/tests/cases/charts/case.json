{
  "steps": [
    {
      "cli": [
        "render",
        "table.x.md",
        "--format",
        "text"
      ]
    },
    {
      "cli": [
        "render",
        "timers.x.md",
        "--format",
        "text"
      ]
    },
    {
      "lsp": [
        {
          "open": "table.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "table.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "table.x.md",
          "line": 1,
          "character": 10
        },
        {
          "request": "textDocument/hover",
          "file": "table.x.md",
          "line": 1,
          "character": 3
        },
        {
          "request": "textDocument/hover",
          "file": "table.x.md",
          "line": 6,
          "character": 2
        },
        {
          "open": "timers.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "timers.x.md",
          "line": 0,
          "character": 2
        },
        {
          "request": "textDocument/hover",
          "file": "timers.x.md",
          "line": 1,
          "character": 8
        },
        {
          "request": "textDocument/inlayHint",
          "file": "timers.x.md",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 200,
              "character": 0
            }
          }
        }
      ]
    },
    {
      "cli": [
        "render",
        "edges.x.md",
        "--format",
        "text"
      ]
    },
    {
      "lsp": [
        {
          "open": "edges.x.md"
        },
        {
          "request": "textDocument/hover",
          "file": "edges.x.md",
          "line": 0,
          "character": 8
        },
        {
          "request": "textDocument/hover",
          "file": "edges.x.md",
          "line": 3,
          "character": 9
        },
        {
          "request": "textDocument/hover",
          "file": "edges.x.md",
          "line": 6,
          "character": 11
        }
      ]
    }
  ]
}
