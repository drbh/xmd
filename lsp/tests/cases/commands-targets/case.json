{
  "steps": [
    {
      "lsp": [
        {
          "open": "note.x.md"
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "note.x.md"
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.task",
            "arguments": [
              {
                "kind": "toggle_task",
                "document": "${uri:note.x.md}",
                "row": 0,
                "expected": "- [ ] Different"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.task",
            "arguments": [
              {
                "kind": "toggle_task",
                "document": "${uri:note.x.md}",
                "row": 9999,
                "expected": ""
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.task",
            "arguments": [
              {
                "kind": "toggle_task",
                "document": "${uri:gone.x.md}",
                "row": 0,
                "expected": "- [ ] Task"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.task",
            "arguments": [
              {
                "kind": "toggle_task",
                "document": "${uri:blocked.x.md}",
                "row": 0,
                "expected": "- [ ] Waiting @after(prerequisite)"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.task",
            "arguments": [
              {
                "kind": "toggle_task",
                "document": "${uri:plain.x.md}",
                "row": 0,
                "expected": "plain text"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.timer",
            "arguments": [
              {
                "kind": "timer",
                "document": "${uri:alias.x.md}",
                "name": "alias",
                "action": "start"
              }
            ]
          }
        },
        {
          "await": "workspace/applyEdit"
        },
        {
          "write": {
            "file": "timer.x.md",
            "text": "[focus] := stopwatch(0s, 2026-09-16T13:58:45-04:00)\n"
          }
        },
        {
          "notify": "workspace/didChangeWatchedFiles",
          "params": {
            "changes": [
              {
                "uri": "${uri:timer.x.md}",
                "type": 2
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.timer",
            "arguments": [
              {
                "kind": "timer",
                "document": "${uri:alias.x.md}",
                "name": "alias",
                "action": "start"
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.timer",
            "arguments": [
              {
                "kind": "timer",
                "document": "${uri:alias.x.md}",
                "name": "alias",
                "action": "pause"
              }
            ]
          }
        },
        {
          "await": "workspace/applyEdit"
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.openResource",
            "arguments": [
              {
                "kind": "open_resource",
                "target": {
                  "document": "${uri:use.x.md}",
                  "row": 0,
                  "expected": "See [site]."
                },
                "url": "https://example.com/old"
              }
            ]
          }
        },
        {
          "await": "window/showDocument"
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.refreshResource",
            "arguments": [
              {
                "kind": "refresh_resource",
                "target": {
                  "document": "${uri:use.x.md}",
                  "row": 0,
                  "expected": "See [site]."
                },
                "url": "https://example.com/old"
              }
            ]
          }
        },
        {
          "write": {
            "file": "links.x.md",
            "text": "[https://github.com/acme/app/pull/42]:site\n"
          }
        },
        {
          "notify": "workspace/didChangeWatchedFiles",
          "params": {
            "changes": [
              {
                "uri": "${uri:links.x.md}",
                "type": 2
              }
            ]
          }
        },
        {
          "request": "workspace/executeCommand",
          "params": {
            "command": "xmd.openResource",
            "arguments": [
              {
                "kind": "open_resource",
                "target": {
                  "document": "${uri:use.x.md}",
                  "row": 0,
                  "expected": "See [site]."
                },
                "url": "https://example.com/old"
              }
            ]
          }
        }
      ]
    },
    {
      "read": [
        "note.x.md",
        "blocked.x.md",
        "timer.x.md"
      ]
    }
  ]
}
