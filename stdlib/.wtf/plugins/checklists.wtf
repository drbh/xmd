// Section progress is a projection of leaf tasks, including evaluated completion.
plugin := {
  api: 1,
  id: "checklists",
  kind: "inlay",
  inputs: {
    sections: ["anchor", "line", "end_line"],
    tasks: ["line", "leaf", "done", "estimate"]
  }
}

// Fill a progress bar to the requested width.
bar := fn(done, total, width) => (
  repeat("█", round(done / total * width)) + repeat("░", width - round(done / total * width))
)

// Select unfinished tasks that have an effort estimate.
estimated := fn(tasks) => (
  filter(tasks, fn(t) => t.done == false && t.estimate != null)
)

// Total the remaining estimates, omitting an empty summary.
remaining_effort := fn(tasks) => (
  if(
    length(tasks) == 0,
    "",
    " · " + text(fold(tasks, 0m, fn(total, t) => total + t.estimate)) + " estimated left"
  )
)

// Combine completion counts with the effort still outstanding.
summary := fn(tasks, done) => (
  text(done) + "/" + text(length(tasks)) + " complete" + remaining_effort(estimated(tasks))
)

// Build the section's compact label and expanded progress tooltip.
hint := fn(section, tasks, done) => (
  {
    at: section.anchor,
    label: bar(done, length(tasks), 8) + " " + summary(tasks, done),
    tooltip: "`"
    + bar(done, length(tasks), 10)
    + " "
    + text(round(done / length(tasks) * 100))
    + "%` "
    + summary(tasks, done)
  }
)

// Skip sections with no leaf tasks to summarize.
section_hints := fn(section, tasks) => (
  if(length(tasks) == 0, [], [hint(section, tasks, length(filter(tasks, fn(t) => t.done)))])
)

// Summarize each section's leaf tasks using evaluated completion.
collect := fn(ctx) => (
  fold(
    ctx.document.sections,
    [],
    fn(hints, s) => concat(
      hints,
      section_hints(
        s,
        filter(ctx.document.tasks, fn(t) => t.leaf && t.line > s.line && t.line < s.end_line)
      )
    )
  )
)
