# Section progress is a projection of leaf tasks, including evaluated completion.
plugin := {api: 1, id: "checklists", kind: "inlay", inputs: {sections: ["anchor", "line", "end_line"], tasks: ["line", "leaf", "done", "estimate"]}}
bar := fn(done, total, width) => repeat("█", round(done / total * width)) + repeat("░", width - round(done / total * width))
estimated := fn(tasks) => filter(tasks, fn(t) => t.done == false && t.estimate != null)
remaining_effort := fn(tasks) => if(length(tasks) == 0, "", " · " + text(fold(tasks, 0m, fn(total, t) => total + t.estimate)) + " estimated left")
summary := fn(tasks, done) => text(done) + "/" + text(length(tasks)) + " complete" + remaining_effort(estimated(tasks))
hint := fn(section, tasks, done) => {at: section.anchor, label: bar(done, length(tasks), 8) + " " + summary(tasks, done), tooltip: "`" + bar(done, length(tasks), 10) + " " + text(round(done / length(tasks) * 100)) + "%` " + summary(tasks, done)}
section_hints := fn(section, tasks) => if(length(tasks) == 0, [], [hint(section, tasks, length(filter(tasks, fn(t) => t.done)))])
collect := fn(ctx) => fold(ctx.document.sections, [], fn(hints, s) => concat(hints, section_hints(s, filter(ctx.document.tasks, fn(t) => t.leaf && t.line > s.line && t.line < s.end_line))))
