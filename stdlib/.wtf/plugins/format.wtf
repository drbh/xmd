# Shared presentation functions are ordinary library exports.
plugin := {api: 1, id: "format", kind: "library", inputs: []}
clamp := fn(value, low, high) => if(value < low, low, if(value > high, high, value))
gauge := fn(fraction, width) => repeat("█", round(clamp(fraction, 0, 1) * width)) + repeat("░", width - round(clamp(fraction, 0, 1) * width))
bar := fn(fraction) => gauge(fraction, 10) + " " + text(round(clamp(fraction, 0, 1) * 100)) + "%"
clock_parts := fn(p) => if(p.hours == 0, "", pad_start(source(p.hours), 2, "0") + ":") + pad_start(source(p.minutes), 2, "0") + ":" + pad_start(source(p.seconds), 2, "0")
clock := fn(duration) => clock_parts(duration_parts(duration))
human_parts := fn(p) => if(p.hours == 0, source(p.minutes) + "m", source(p.hours) + "h" + if(p.minutes == 0, "", " " + source(p.minutes) + "m"))
human := fn(duration) => human_parts(duration_parts(duration))
age := fn(elapsed) => if(elapsed < 1m, "just now", if(elapsed < 1h, source(floor(elapsed / 1m)) + "m ago", if(elapsed < 1d, source(floor(elapsed / 1h)) + "h ago", if(elapsed < 14d, source(floor(elapsed / 1d)) + "d ago", source(floor(elapsed / 7d)) + "w ago"))))
