plugin := {api: 1, id: "itinerary", kind: "inlay", inputs: {days: ["value"]}, imports: ["itinerary_core"]}
trip := import("itinerary_core")
days := fn(ctx) => map(ctx.document.days, fn(d) => d.value)
collect := fn(ctx) => trip.collect(days(ctx), ctx.today)
hovers := fn(ctx) => trip.hovers(days(ctx), ctx.today)
diagnostics := fn(ctx) => trip.diagnostics(days(ctx), ctx.today)
format := fn(ctx) => trip.format_days(days(ctx))
time_dependent := fn(ctx) => length(ctx.document.days) > 0
