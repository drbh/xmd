# Plan policy surrounds the generic numerical primitive.
plugin := {api: 1, id: "plan", kind: "library", imports: ["format"], inputs: []}
fmt := import("format")
tidy := fn(n) => round(n * 10000) / 10000
typed := fn(unit, n) => if(type(unit) == "Duration", unit * round(n), unit * n)
raw := fn(form) => {constant: form.constant, terms: form.terms}
evaluate := fn(form, values) => form.constant + fold(entries(form.terms), 0, fn(total, term) => total + term.value * get(values, term.key))
variables := fn(model) => object(concat(map(model.names, fn(name) => {key: name, value: {kind: "continuous", lower: 0}}), map(model.decisions, fn(v) => {key: v.name, value: {kind: v.kind, lower: 0}})))
solve_raw := fn(model) => solve_linear({goal: model.goal, variables: variables(model), order: concat(model.names, map(model.decisions, fn(v) => v.name)), objective: raw(model.objective), constraints: map(model.constraints, fn(c) => {lhs: raw(c.lhs), op: c.op, rhs: raw(c.rhs)})})
slack := fn(op, lhs, rhs) => tidy(if(op == "<=", rhs - lhs, if(op == ">=", lhs - rhs, 0)))
constraint_result := fn(c, lhs, rhs, unit) => {name: c.name, op: c.op, lhs: typed(unit, lhs), rhs: typed(unit, rhs), slack: typed(unit, slack(c.op, lhs, rhs)), binding: slack(c.op, lhs, rhs) == 0}
constraint := fn(c, values) => constraint_result(c, tidy(evaluate(c.lhs, values)), tidy(evaluate(c.rhs, values)), if(type(c.lhs.unit) == "Number", c.rhs.unit, c.lhs.unit))
result := fn(model, values) => {objective: typed(model.objective.unit, tidy(evaluate(model.objective, values))), variables: map(model.names, fn(n) => {name: n, value: tidy(get(values, n))}), constraints: map(model.constraints, fn(c) => constraint(c, values)), rows: object(map(model.decisions, fn(d) => {key: d.name, value: if(d.kind == "binary", tidy(get(values, d.name)) >= 0.5, round(tidy(get(values, d.name))))}))}
checked := fn(model, solution) => if(solution.status == "optimal", result(model, solution.values), error(if(solution.status == "infeasible", "No values satisfy every constraint; relax one of them", "The objective can be " + if(model.goal == "maximize", "raised", "lowered") + " without limit; add a constraint that bounds it")))
solve_model := fn(model) => checked(model, solve_raw(model))
comparison := fn(op) => if(op == "<=", "≤", if(op == ">=", "≥", "="))
status := fn(c) => if(c.binding, "● binding", "○ slack " + text(c.slack))
usage := fn(c, wide) => if(c.op == "<=" && number(c.rhs) > 0, if(wide, "`" + fmt.bar(number(c.lhs) / number(c.rhs)) + "` ", fmt.gauge(number(c.lhs) / number(c.rhs), 8) + " "), "")
constraint_label := fn(c) => usage(c, false) + text(c.lhs) + " " + comparison(c.op) + " " + text(c.rhs) + " · " + status(c)
constraint_hover := fn(c) => "**" + c.name + "**\n\n" + constraint_label(c) + "\n\nA binding constraint limits the objective; slack is the unused room."
column_label := fn(c) => c.name + " " + if(type(get(c.cells, 0).value) == "Boolean", text(length(filter(c.cells, fn(v) => v.value != false))) + " of " + text(length(c.cells)), text(fold(c.cells, 0, fn(total, v) => total + number(v.value))))
inlay := fn(p) => join(concat(["= " + text(p.objective)], map(p.variable_order, fn(name) => name + " " + text(get(p.variables, name))), map(p.columns, column_label)), " · ")
choice := fn(value) => if(type(value) == "Boolean", if(value, "☑ yes", "☐ no"), "→ " + text(value))
column_hover := fn(c) => "\n\n" + c.name + ": " + join(map(c.cells, fn(v) => if(v.value == true, v.label, if(v.value == false, "~~" + v.label + "~~", v.label + " × " + text(v.value)))), ", ")
hover := fn(p) => join(map(p.columns, column_hover), "") + "\n\n" + if(p.goal == "maximize", "Maximizes", "Minimizes") + " the objective. Variables: " + join(map(p.variable_order, fn(name) => name + " = " + text(get(p.variables, name))), ", ") + "\n\nConstraints:\n" + join(map(p.constraints, fn(c) => "\n- " + c.name + ": " + usage(c, true) + text(c.lhs) + " " + comparison(c.op) + " " + text(c.rhs) + " · " + status(c)), "") + "\n\nDecision variables are never negative; add a constraint like x >= 5 for other bounds."
write_choice := fn(cell) => " " + pad_end(if(type(cell.value) == "Boolean", if(cell.value, "yes", "no"), text(cell.value)), cell.width, " ") + " "

write_text := fn(value) => if(type(value) == "Boolean", if(value, "yes", "no"), text(value))
write_edits := fn(p, document) => map(filter(fold(p.columns, [], fn(cells, column) => concat(cells, column.cells)), fn(cell) => cell.document == document && cell.source != write_text(cell.value)), fn(cell) => {range: cell.range, newText: write_choice(cell)})
write_title := fn() => "Write the plan's choices into the table"

seek_boundary := fn(name, form, unit) => if(coalesce(get(form.terms, name), 0) == 0, error("The constraint does not depend on " + name), if(length(entries(form.terms)) > 1, error("solve() finds one value; " + join(map(filter(entries(form.terms), fn(t) => t.key != name), fn(t) => t.key), ", ") + " would need a plan"), if(unit == null, error("Cannot tell the unit of the answer; the unknown is scaled by two different units"), typed(unit, -form.constant / get(form.terms, name)))))
seek_summary := fn(op, positive) => if(op == "==", "the exact value that satisfies", if(op == ">=" && positive || op == "<=" && positive == false, "the smallest value that satisfies", "the largest value that satisfies"))
