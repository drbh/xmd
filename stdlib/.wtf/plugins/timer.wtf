# Timer state and transitions. Rust carries the typed value and applies edits.
plugin := {api: 1, id: "timer", kind: "library", imports: ["format"], inputs: []}
fmt := import("format")
duration := fn(v) => if(type(v) == "Duration" && v >= 0s, v, error("Timer durations must be nonnegative whole seconds"))
limit := fn(kind, args) => if(kind == "countdown", if(duration(get(args, 0)) == 0s, error("Countdown duration must be greater than zero"), get(args, 0)), null)
started := fn(value) => if(type(value) == "DateTime", value, error("Timer start must be a timestamp with a time, e.g. 2026-09-16T14:00:00-04:00"))
assemble := fn(bound, accumulated, since, idle) => {limit: bound, elapsed: if(bound == null, accumulated + since, if(accumulated + since > bound, bound, accumulated + since)), idle: idle}
create_at := fn(bound, accumulated, start, idle, clock) => {limit: bound, elapsed: assemble(bound, accumulated, if(start == null || clock < start, 0s, clock - start), idle).elapsed, started: start, idle: idle}
create := fn(kind, args) => if(length(args) < if(kind == "countdown", 1, 0) || length(args) > if(kind == "countdown", 3, 2), error(if(kind == "countdown", "countdown expects duration, optionally followed by elapsed and a start timestamp", "stopwatch accepts optional elapsed and a start timestamp")), create_at(limit(kind, args), duration(if(length(args) > if(kind == "countdown", 1, 0), get(args, if(kind == "countdown", 1, 0)), 0s)), if(length(args) > if(kind == "countdown", 2, 1), started(get(args, if(kind == "countdown", 2, 1))), null), length(args) == if(kind == "countdown", 1, 0), now()))
done := fn(t) => t.limit != null && t.elapsed >= t.limit
running := fn(t) => t.started != null && done(t) == false
state := fn(t) => if(done(t), "done", if(t.idle, "idle", if(running(t), "running", "paused")))
state_icon := fn(t) => get({running: "▸", paused: "‖", done: "✓", idle: "○"}, state(t))
clock := fn(t) => fmt.clock(if(t.limit == null, t.elapsed, t.limit - t.elapsed))
suffix := fn(t) => clock(t) + if(t.limit == null, " elapsed", " remaining") + " · " + state_icon(t) + " " + state(t)
display := fn(t) => if(t.limit == null, "◴ ", "◷ ") + suffix(t)
inlay := fn(t) => if(t.limit == null, "◴ ", "◷ " + fmt.gauge(t.elapsed / t.limit, 8) + " ") + suffix(t)
property := fn(t, name) => if(name == "elapsed", t.elapsed, if(name == "remaining", if(t.limit == null, error("Only countdowns have .remaining"), t.limit - t.elapsed), if(name == "duration", if(t.limit == null, error("Only countdowns have .duration"), t.limit), if(name == "running", running(t), if(name == "done", done(t), if(name == "state", state(t), error("Unknown timer property '" + name + "'")))))))
actions := fn(t) => concat(if(state(t) == "idle", ["start"], if(state(t) == "running", ["pause"], if(state(t) == "paused", ["resume"], []))), if(t.idle, [], ["reset"]))
transition := fn(t, action, duration_source) => if(contains(actions(t), action) == false, error("Cannot " + action + " a " + state(t) + " timer"), if(t.limit == null, "stopwatch", "countdown") + "(" + join(concat(if(t.limit == null, [], [duration_source]), if(action == "reset", [], [source(t.elapsed)]), if(action == "start" || action == "resume", [source(now())], [])), ", ") + ")")
hover := fn(t) => if(t.limit == null, "", "\n\n`" + fmt.bar(t.elapsed / t.limit) + "`") + "\n\nElapsed: " + text(t.elapsed) + ". State: " + state(t) + "." + if(t.started == null, "", " Current segment started: " + format_date(t.started, "%+") + ".") + "\n\nUse Start / Pause / Resume / Reset timer. Controls save state in the note; ticking never edits it."
