// Linear plans and goal seek: what a definition of the `plans` module's
// forms is worth. The host reads the objective and every constraint as linear
// forms over the unknowns; this library builds the model, solves it with the
// generic numerical primitive, and words the solution.
module := {api: 1, id: "plan", kind: "library", imports: ["format"], inputs: [], exports: []}
fmt := import("format")

// Round displayed solver results to four decimal places.
_tidy := fn(n) => (
  round(n * 10000) / 10000
)

// Restore units, rounding durations to whole seconds.
_typed := fn(unit, n) => (
  if(type(unit) == "Duration", unit * round(n), unit * n)
)

// Strip unit metadata before passing a form to the numerical solver.
_raw := fn(form) => (
  {constant: form.constant, terms: form.terms}
)

// Substitute the raw solution into a linear form.
_evaluate := fn(form, values) => (
  form.constant
  + fold(entries(form.terms), 0, fn(total, term) => total + term.value * get(values, term.key))
)

// A plan's constraints, one per row of its table: the row's name and the
// constraint read from its expression, where the expression is.
constraints := fn(f) => (
  map(
    f.rows,
    fn(row) => let(
      {named: get(row.cells, 0), c: get(row.cells, 1)},
      {name: named.text, op: c.op, lhs: c.lhs, rhs: c.rhs, anchor: c.anchor, range: c.range}
    )
  )
)

// Give plan variables nonnegative bounds and decision cells their domains.
_variables := fn(f) => (
  object(
    concat(
      map(f.unknowns, fn(name) => {key: name, value: {kind: "continuous", lower: 0}}),
      map(
        f.decisions,
        fn(d) => {key: d.name, value: {kind: if(d.domain == "choice", "binary", "integer"), lower: 0}}
      )
    )
  )
)

// Build the numerical model while preserving source variable order.
_solve_raw := fn(f) => (
  solve_linear(
    {
      goal: f.form,
      variables: _variables(f),
      order: concat(f.unknowns, map(f.decisions, fn(d) => d.name)),
      objective: _raw(get(f.arguments, 0)),
      constraints: map(constraints(f), fn(c) => {lhs: _raw(c.lhs), op: c.op, rhs: _raw(c.rhs)})
    }
  )
)

// Measure unused room on the permitted side of a constraint.
_slack := fn(op, lhs, rhs) => (
  _tidy(match(op, "<=", rhs - lhs, ">=", lhs - rhs, 0))
)

// Assemble typed constraint values and binding status.
_constraint_result := fn(c, lhs, rhs, unit) => (
  {
    name: c.name,
    op: c.op,
    lhs: _typed(unit, lhs),
    rhs: _typed(unit, rhs),
    slack: _typed(unit, _slack(c.op, lhs, rhs)),
    binding: _slack(c.op, lhs, rhs) == 0,
    anchor: c.anchor,
    range: c.range
  }
)

// Evaluate both sides from raw values before rounding for display.
_constraint := fn(c, values) => (
  _constraint_result(
    c,
    _tidy(_evaluate(c.lhs, values)),
    _tidy(_evaluate(c.rhs, values)),
    if(type(c.lhs.unit) == "Number", c.rhs.unit, c.lhs.unit)
  )
)

// A decision cell's chosen value: yes or no, or a whole number.
_choice := fn(d, values) => (
  if(
    d.domain == "choice",
    _tidy(get(values, d.name)) >= 0.5,
    round(_tidy(get(values, d.name)))
  )
)

// Each decision column, with the cells the plan chose for it, in the order
// the plan first reads them.
_columns := fn(f, values) => (
  map(
    fold(
      f.decisions,
      [],
      fn(columns, d) => let(
        {
          key: d.document + "#" + d.table + "." + d.column,
          cell: {
            value: _choice(d, values),
            label: d.label,
            document: d.document,
            source: d.source,
            line: d.line,
            anchor: d.anchor,
            range: d.range,
            width: d.width
          }
        },
        if(
          length(filter(columns, fn(c) => c.key == key)) == 0,
          concat(columns, [{key: key, name: d.column, cells: [cell]}]),
          map(
            columns,
            fn(c) => if(c.key == key, {key: c.key, name: c.name, cells: concat(c.cells, [cell])}, c)
          )
        )
      )
    ),
    fn(c) => {name: c.name, cells: c.cells}
  )
)

// The solution as a plan's record holds it: typed, rounded for display, and
// where each constraint and decision cell is.
_solution := fn(f, values) => let(
  {objective: get(f.arguments, 0)},
  {
    goal: f.form,
    objective: _typed(objective.unit, _tidy(_evaluate(objective, values))),
    variables: object(map(f.unknowns, fn(n) => {key: n, value: _tidy(get(values, n))})),
    variable_order: f.unknowns,
    constraints: map(constraints(f), fn(c) => _constraint(c, values)),
    columns: _columns(f, values)
  }
)

// Translate solver statuses into a solution or an actionable error.
_checked := fn(f, solved) => (
  if(
    solved.status == "optimal",
    _solution(f, solved.values),
    error(
      if(
        solved.status == "infeasible",
        "No values satisfy every constraint; relax one of them",
        "The objective can be "
        + if(f.form == "maximize", "raised", "lowered")
        + " without limit; add a constraint that bounds it"
      )
    )
  )
)

// Solve a plan definition: its solution record, or why it has none.
solve := fn(f) => (
  if(
    length(f.unknowns) == 0 && length(f.decisions) == 0,
    error("A plan needs at least one unknown name to solve for"),
    _checked(f, _solve_raw(f))
  )
)

// What the note reads of a solved plan: the objective, each variable and
// each constraint's slack, by name. A variable wins over a constraint of the
// same name, and the objective over both.
fields := fn(p) => (
  object(
    concat(
      map(p.constraints, fn(c) => {key: c.name, value: c.slack}),
      map(p.variable_order, fn(n) => {key: n, value: get(p.variables, n)}),
      [{key: "objective", value: p.objective}]
    )
  )
)

// A plan definition as the note reads it: tagged a Plan, shown as its
// objective, with its hover, its outline detail and its solution record.
define := fn(f) => let(
  {p: solve(f)},
  {
    value: tagged("Plan", fields(p), text(p.objective)),
    hover: hover(p),
    detail: "plan · "
    + p.goal
    + " "
    + text(p.objective)
    + " · "
    + text(length(p.variable_order))
    + " variables",
    record: p
  }
)

// Use compact mathematical symbols for displayed comparisons.
_comparison := fn(op) => (
  match(op, "<=", "≤", ">=", "≥", "=")
)

// Distinguish binding constraints from those with unused room.
_status := fn(c) => (
  if(c.binding, "● binding", "○ slack " + text(c.slack))
)

// Add a usage bar when a positive upper bound makes it meaningful.
_usage := fn(c, wide) => (
  if(
    c.op == "<=" && number(c.rhs) > 0,
    if(
      wide,
      "`" + fmt.bar(number(c.lhs) / number(c.rhs)) + "` ",
      fmt.gauge(number(c.lhs) / number(c.rhs), 8) + " "
    ),
    ""
  )
)

// Combine usage, comparison, and slack into a constraint label.
constraint_label := fn(c) => (
  _usage(c, false) + text(c.lhs) + " " + _comparison(c.op) + " " + text(c.rhs) + " · " + _status(c)
)

// Explain a constraint's displayed result and binding status.
constraint_hover := fn(c) => (
  "**"
  + c.name
  + "**\n\n"
  + constraint_label(c)
  + "\n\nA binding constraint limits the objective; slack is the unused room."
)

// Summarize selected choices or total a decision-count column.
_column_label := fn(c) => (
  c.name
  + " "
  + if(
      type(get(c.cells, 0).value) == "Boolean",
      text(length(filter(c.cells, fn(v) => v.value != false))) + " of " + text(length(c.cells)),
      text(fold(c.cells, 0, fn(total, v) => total + number(v.value)))
    )
)

// Summarize the objective, ordered variables, and decision columns.
inlay := fn(p) => (
  join(
    concat(
      ["= " + text(p.objective)],
      map(p.variable_order, fn(name) => name + " " + text(get(p.variables, name))),
      map(p.columns, _column_label)
    ),
    " · "
  )
)

// Distinguish yes/no choices from numeric decision counts.
choice := fn(value) => (
  if(type(value) == "Boolean", if(value, "☑ yes", "☐ no"), "→ " + text(value))
)

// List chosen rows, striking out rejected boolean choices.
_column_hover := fn(c) => (
  c.name
  + ": "
  + join(
      map(
        c.cells,
        fn(v) => if(
          v.value == true,
          v.label,
          if(v.value == false, "~~" + v.label + "~~", v.label + " × " + text(v.value))
        )
      ),
      ", "
    )
)

// Explain the solution, constraint usage, and default variable bounds.
hover := fn(p) => (
  join(
    concat(
      map(p.columns, _column_hover),
      [
        if(p.goal == "maximize", "Maximizes", "Minimizes")
        + " the objective. Variables: "
        + join(map(p.variable_order, fn(name) => name + " = " + text(get(p.variables, name))), ", ")
        + "\n\nConstraints:\n"
        + join(
            map(
              p.constraints,
              fn(c) => "\n- "
              + c.name
              + ": "
              + _usage(c, true)
              + text(c.lhs)
              + " "
              + _comparison(c.op)
              + " "
              + text(c.rhs)
              + " · "
              + _status(c)
            ),
            ""
          )
        + "\n\nDecision variables are never negative; add a constraint like x >= 5 for other bounds."
      ]
    ),
    "\n\n"
  )
)

// Preserve a decision cell's padding when writing its result.
_write_choice := fn(cell) => (
  " "
  + pad_end(
      if(type(cell.value) == "Boolean", if(cell.value, "yes", "no"), text(cell.value)),
      cell.width,
      " "
    )
  + " "
)

// Convert a decision value to writable table-cell text.
_write_text := fn(value) => (
  if(type(value) == "Boolean", if(value, "yes", "no"), text(value))
)

// Update changed decision cells belonging to the current document.
write_edits := fn(p, document) => (
  map(
    filter(
      fold(p.columns, [], fn(cells, column) => concat(cells, column.cells)),
      fn(cell) => cell.document == document && cell.source != _write_text(cell.value)
    ),
    fn(cell) => {range: cell.range, newText: _write_choice(cell)}
  )
)

// Name the action that writes solved choices into the table.
write_title := fn() => (
  "Write the plan's choices into the table"
)

// Solve one linear boundary and reject ambiguous unknowns or units.
seek_boundary := fn(name, form, unit) => (
  if(
    coalesce(get(form.terms, name), 0) == 0,
    error("The constraint does not depend on " + name),
    if(
      length(entries(form.terms)) > 1,
      error(
        "solve() finds one value; "
        + join(map(filter(entries(form.terms), fn(t) => t.key != name), fn(t) => t.key), ", ")
        + " would need a plan"
      ),
      if(
        unit == null,
        error(
          "Cannot tell the unit of the answer; the unknown is scaled by two different units"
        ),
        _typed(unit, -form.constant / get(form.terms, name))
      )
    )
  )
)

// Explain whether a boundary is exact, a minimum, or a maximum.
seek_summary := fn(op, positive) => (
  if(
    op == "==",
    "the exact value that satisfies",
    if(
      op == ">=" && positive || op == "<=" && positive == false,
      "the smallest value that satisfies",
      "the largest value that satisfies"
    )
  )
)

// A goal seek: the boundary its constraint sets on the definition's own
// name, and which way the hover says it moves. Both sides read as one form,
// the left minus the right; one that cannot be one scales the unknown by two
// different units.
seek := fn(f) => let(
  {c: get(f.arguments, 0), name: get(f.unknowns, 0)},
  let(
    {
      difference: if(
        c.difference == null,
        {constant: 0, terms: {}, per: null},
        c.difference
      )
    },
    {
      value: if(
        c.difference == null,
        error(
          "Cannot tell the unit of the answer; the unknown is scaled by two different units"
        ),
        seek_boundary(name, difference, difference.per)
      ),
      hover: "Goal seek: "
      + seek_summary(c.op, coalesce(get(difference.terms, name), 0) > 0)
      + " `"
      + c.text
      + "`."
    }
  )
)
