### 0 cli render imports.wtf --format text
$ wtf render imports.wtf --format text --root <root> --now 2026-09-16T12:00:00-04:00
exit 1
--- stdout
[broken] := import("./b.wtf").remote + 1
[other] := 1 / 0
[good] := 4 = 4
--- stderr
<root>/imports.wtf:1:2: error: Dependency error: Unknown name 'absent'
<root>/imports.wtf:2:16: error: Division by zero (Number / Number)
wtf: 2 error(s) while rendering

### 1 cli query imports.wtf diagnostics | select {line, severity, code, message} --json
$ wtf query imports.wtf diagnostics | select {line, severity, code, message} --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "code": "dependency",
    "line": 0,
    "message": "Dependency error: Unknown name 'absent'",
    "severity": "error"
  },
  {
    "code": "evaluation",
    "line": 1,
    "message": "Division by zero (Number / Number)",
    "severity": "error"
  }
]

### 2 cli query imports.wtf values | select {name, display} --json
$ wtf query imports.wtf values | select {name, display} --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "display": null,
    "name": "broken"
  },
  {
    "display": null,
    "name": "other"
  },
  {
    "display": "4",
    "name": "good"
  }
]

### 3 cli render lookups.wtf --format text
$ wtf render lookups.wtf --format text --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[price] := quote(ACME) = $10
[live] := now() = 2026-09-16 12:00:00 -04:00
[static] := 7 = 7

### 4 lsp
-- open lookups.wtf
-- await textDocument/publishDiagnostics lookups.wtf
{
  "diagnostics": [],
  "uri": "file://<root>/lookups.wtf",
  "version": 1
}
-- request textDocument/hover lookups.wtf 0:2
{
  "contents": {
    "kind": "markdown",
    "value": "**price · Money**\n\n$10\n\n```text\nquote(ACME)\n= $10\n```\n\nLookups:\n- quote ACME · just now · fixture\n\nDefinition: [price](<file://<root>/lookups.wtf#L1>) · <root>/lookups.wtf:1"
  },
  "range": {
    "end": {
      "character": 6,
      "line": 0
    },
    "start": {
      "character": 1,
      "line": 0
    }
  }
}
-- request textDocument/hover lookups.wtf 2:2
{
  "contents": {
    "kind": "markdown",
    "value": "**static · Number**\n\n7\n\n```text\n7\n= 7\n```\n\nDefinition: [static](<file://<root>/lookups.wtf#L3>) · <root>/lookups.wtf:3"
  },
  "range": {
    "end": {
      "character": 7,
      "line": 2
    },
    "start": {
      "character": 1,
      "line": 2
    }
  }
}
-- request textDocument/inlayHint lookups.wtf {"end":{"character":0,"line":200},"start":{"character":0,"line":0}}
[
  {
    "label": "= $10",
    "paddingLeft": true,
    "position": {
      "character": 22,
      "line": 0
    },
    "tooltip": {
      "kind": "markdown",
      "value": "**price · Money**\n\n$10\n\n```text\nquote(ACME)\n= $10\n```\n\nLookups:\n- quote ACME · just now · fixture\n\nDefinition: [price](<file://<root>/lookups.wtf#L1>) · <root>/lookups.wtf:1"
    }
  },
  {
    "label": "= 2026-09-16 12:00:00 -04:00",
    "paddingLeft": true,
    "position": {
      "character": 15,
      "line": 1
    },
    "tooltip": {
      "kind": "markdown",
      "value": "**live · DateTime**\n\n2026-09-16 12:00:00 -04:00\n\n```text\nnow()\n= 2026-09-16 12:00:00 -04:00\n```\n\nDefinition: [live](<file://<root>/lookups.wtf#L2>) · <root>/lookups.wtf:2"
    }
  },
  {
    "label": "= 7",
    "paddingLeft": true,
    "position": {
      "character": 13,
      "line": 2
    },
    "tooltip": {
      "kind": "markdown",
      "value": "**static · Number**\n\n7\n\n```text\n7\n= 7\n```\n\nDefinition: [static](<file://<root>/lookups.wtf#L3>) · <root>/lookups.wtf:3"
    }
  }
]
-- query values | where name == "price" | select {name, display}
{
  "now": "2026-09-16T12:00:00-04:00",
  "rows": [
    {
      "display": "$10",
      "name": "price"
    }
  ],
  "schemaVersion": 1,
  "versions": {
    "file://<root>/lookups.wtf": 1
  }
}

### 5 cli render calendar.wtf --now 2026-09-17T00:15:00+14:00 --format text
$ wtf render calendar.wtf --now 2026-09-17T00:15:00+14:00 --format text --root <root>
exit 0
