    "forecast": {
      "display": "24°C / 12°C · light rain · 40% rain",
      "fetched_at": {
        "type": "datetime",
        "value": "2026-09-17T12:00:00+00:00"
      },
      "place": "Oaxaca",
      "source": "open-meteo.com"
    },
    "line": 0,
    "places": "New York | Oaxaca"
  },
  {
    "forecast": {
      "display": "no forecast yet; forecasts cover about 16 days",
      "fetched_at": {
        "type": "datetime",
        "value": "2026-09-17T12:00:00+00:00"
      },
      "place": "Oaxaca",
      "source": "open-meteo.com"
    },
    "line": 4,
    "places": "Oaxaca"
  }
]

### 2 cli query trip.wtf values | select {name, display} --json
$ wtf query trip.wtf values | select {name, display} --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[
  {
    "display": "76°F / 53°F · light rain · 40% rain",
    "name": "weather"
  },
  {
    "display": "40%",
    "name": "rain"
  },
  {
    "display": "24°C / 12°C · light rain · 40% rain",
    "name": "celsius"
  },
  {
    "display": null,
    "name": "later"
  }
]

### 3 cli query trip.wtf diagnostics | select {line, severity, code, message} --json
$ wtf query trip.wtf diagnostics | select {line, severity, code, message} --json --root <root> --now 2026-09-17T14:00:00+00:00
exit 0
--- stdout
[
  {
    "code": "evaluation",
    "line": 9,
    "message": "Forecast for Oaxaca on 2026-11-21: no forecast yet; forecasts cover about 16 days",
    "severity": "warning"
  }
]

