              "${uri:controls.wtf}",
              0,
              "- [ ] First :first"
            ]
          }
        },
        {
          "await": "workspace/applyEdit"
        },
        {
          "change": {
            "file": "controls.wtf",
            "text": "- [x] First :first @completed(2026-09-16)\n[./receipt.png]:receipt\nUse [receipt].\n"
          }
        },
        {
          "await": "textDocument/publishDiagnostics",
          "file": "controls.wtf"
        },
        {
          "request": "textDocument/codeLens",
          "file": "controls.wtf"
