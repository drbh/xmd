[
  4
]

### 1 cli query tasks.wtf tasks | where leaf && !done && contains(tags, "errands") | select {title, due, estimate, source, parent} | sort due | limit 1 --json
$ wtf query tasks.wtf tasks | where leaf && !done && contains(tags, "errands") | select {title, due, estimate, source, parent} | sort due | limit 1 --json --root <root> --now 2026-09-16T12:00:00-04:00
exit 0
--- stdout
[
  {
    "due": {
      "type": "date",
      "value": "2026-09-17"
    },
    "estimate": {
      "seconds": 90,
      "type": "duration"
    },
    "parent": {
      "line": 1,
      "path": "<root>/tasks.wtf",
      "range": {
        "end": {
          "character": 5,
          "line": 0
        },
        "start": {
          "character": 2,
          "line": 0
        }
      },
      "uri": "file://<root>/tasks.wtf#L1"
    },
    "source": {
      "line": 2,
      "path": "<root>/tasks.wtf",
      "range": {
        "end": {
          "character": 54,
          "line": 1
        },
        "start": {
          "character": 0,
          "line": 1
        }
      },
      "uri": "file://<root>/tasks.wtf#L2"
    },
    "title": "Child #errands"
  }
]

