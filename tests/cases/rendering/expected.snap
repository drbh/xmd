.wtf .error { text-decoration-color: #ef8b80; }
.wtf .warning { text-decoration-color: #eac080; }
.wtf .info, .wtf .hint { text-decoration-color: #90bed8; }
.wtf[data-interactive] .t-wtfCheckbox, .wtf[data-interactive] .t-wtfCheckboxChecked { cursor: pointer; }
.wtf[data-layout="document"] { white-space: pre-wrap; overflow-wrap: anywhere; }
.wtf[data-layout="document"] .h1 { font-size: 1.9em; font-weight: 700; line-height: 1.3; }
.wtf[data-layout="document"] .h2 { font-size: 1.45em; font-weight: 700; line-height: 1.35; }
.wtf[data-layout="document"] .h3 { font-size: 1.2em; font-weight: 700; }
.wtf[data-layout="document"] .h4, .wtf[data-layout="document"] .h5, .wtf[data-layout="document"] .h6 { font-weight: 700; }
.wtf[data-layout="document"] :is(.h1, .h2, .h3) .inlay { font-size: .6em; font-weight: 400; vertical-align: middle; }
.wtf-controls { display: flex; flex-wrap: wrap; gap: .5em; font: 12px monospace; }
.wtf-controls button { font: inherit; cursor: pointer; }
.wtf-light .wtf { color-scheme: light; color: var(--wtf-foreground, #1f2622); background: var(--wtf-background, #ffffff); }
