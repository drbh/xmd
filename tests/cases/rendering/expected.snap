<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>escape.wtf</title><style>.wtf { color-scheme: dark; color: var(--wtf-foreground, #d4ded4); background: var(--wtf-background, #171b19); margin: 0; font: var(--wtf-font-size, 14px)/1.8 var(--wtf-font, "Ioskeley Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace); tab-size: 2; white-space: pre; }
