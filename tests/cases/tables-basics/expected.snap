### 7 cli render scoped.wtf --format text
$ wtf render scoped.wtf --format text --root <root> --now 2026-09-16T14:00:00-04:00
exit 0
--- stdout
[groceries] := table = 2 rows · 3 columns
| item | quantity | price |
| --- | --- | --- |
| apple | 2 | $3.30 |
| pear | 4 | $4.30 |

[999]:price
[999]:quantity
[other] := table = 1 rows · 2 columns
| quantity | price |
| --- | --- |
| 3 | $1.00 |
[nested] := sum(groceries, quantity * sum(other, price)) = $6
[total] := sum(groceries, quantity * price) = $23.80
[dates] := table = 1 rows · 2 columns
| today | tomorrow |
| --- | --- |
| 1 | 2 |
[future] := sum(dates, today + tomorrow) = 3

