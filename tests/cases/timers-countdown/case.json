{
  "steps": [
    { "cli": ["render", "focus.wtf", "--format", "text"] },
    { "cli": ["render", "focus.wtf", "--now", "2026-09-17T14:00:00-04:00", "--format", "text"] },
    { "cli": ["query", "focus.wtf", "timers | select {name, line, value}", "--json"] },
    { "cli": ["render", "running.wtf", "--format", "text"] },
    { "cli": ["render", "running.wtf", "--now", "2026-09-16T14:01:59-04:00", "--format", "text"] },
    { "cli": ["render", "running.wtf", "--now", "2026-09-16T14:02:00-04:00", "--format", "text"] },
    { "cli": ["render", "running.wtf", "--now", "2026-09-16T16:30:00-04:00", "--format", "text"] },
    { "cli": ["query", "running.wtf", "timers | select {name, value}", "--json", "--now", "2026-09-16T16:30:00-04:00"] },
    {
      "lsp": [
        { "open": "multiline.wtf" },
        { "await": "textDocument/publishDiagnostics", "file": "multiline.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:multiline.wtf}", "focus", "start"] }
        },
        { "await": "workspace/applyEdit" },
        { "open": "multiline-crlf.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:multiline-crlf.wtf}", "focus", "start"] }
        },
        { "await": "workspace/applyEdit" },
        { "open": "grouped.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:grouped.wtf}", "watch", "start"] }
        },
        { "await": "workspace/applyEdit" },
        {
          "request": "textDocument/inlayHint",
          "file": "grouped.wtf",
          "range": { "start": { "line": 0, "character": 0 }, "end": { "line": 99, "character": 0 } }
        }
      ]
    },
    { "cli": ["render", "cycle.wtf", "--format", "text"] },
    { "cli": ["query", "cycle.wtf", "diagnostics | select {line, severity, code, message}", "--json"] }
  ]
}
