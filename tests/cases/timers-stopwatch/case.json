{
  "steps": [
    { "cli": ["render", "idle.wtf", "--format", "text"] },
    { "cli": ["render", "idle.wtf", "--now", "2026-09-17T14:00:00-04:00", "--format", "text"] },
    { "cli": ["query", "idle.wtf", "timers", "--json"] },
    {
      "lsp": [
        { "open": "idle.wtf" },
        { "await": "textDocument/publishDiagnostics", "file": "idle.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:idle.wtf}", "watch", "pause"] }
        },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:idle.wtf}", "watch", "start"] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "cli": ["render", "running.wtf", "--format", "text"] },
    { "cli": ["render", "running.wtf", "--now", "2026-09-16T14:01:00-04:00", "--format", "text"] },
    { "cli": ["query", "running.wtf", "timers", "--json"] },
    {
      "lsp": [
        { "open": "running.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:running.wtf}", "watch", "pause"] }
        },
        { "await": "workspace/applyEdit" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:running.wtf}", "watch", "reset"] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "cli": ["render", "paused.wtf", "--format", "text"] },
    { "cli": ["render", "paused.wtf", "--now", "2026-09-16T15:00:00-04:00", "--format", "text"] },
    { "cli": ["query", "paused.wtf", "timers", "--json"] },
    {
      "lsp": [
        { "open": "paused.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:paused.wtf}", "watch", "start"] }
        },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:paused.wtf}", "watch", "resume"] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "cli": ["render", "alias.wtf", "--format", "text"] },
    {
      "lsp": [
        { "open": "alias.wtf" },
        { "await": "textDocument/publishDiagnostics", "file": "alias.wtf" },
        {
          "request": "workspace/executeCommand",
          "params": { "command": "wtf.timer", "arguments": ["${uri:alias.wtf}", "alias", "start"] }
        },
        { "await": "workspace/applyEdit" }
      ]
    },
    { "read": ["idle.wtf", "running.wtf", "paused.wtf", "shared.wtf"] }
  ]
}
