{
  "name": "jot",
  "displayName": "Jot",
  "description": "Calculated notes, checklists, and timers powered by the Jot language server.",
  "version": "0.1.0",
  "publisher": "drbh",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/drbh/jot" },
  "engines": { "vscode": "^1.91.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:jot"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "scripts": {
    "check": "node --check extension.js && node --check test/suite.js && node --check test/run.js",
    "test": "node test/run.js",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": { "vscode-languageclient": "10.1.1" },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "contributes": {
    "languages": [{
      "id": "jot",
      "aliases": ["Jot", "jot"],
      "extensions": [".jot"],
      "configuration": "./language-configuration.json"
    }],
    "commands": [{ "command": "jot.restartServer", "title": "Jot: Restart Language Server" }],
    "configuration": {
      "title": "Jot",
      "properties": {
        "jot.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the Jot executable built with cargo build. The extension runs it with the lsp argument."
        }
      }
    },
    "configurationDefaults": {
      "[jot]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.inlayHints.enabled": "on",
        "editor.codeLens": true,
        "editor.formatOnType": true,
        "editor.tabSize": 2
      }
    },
    "semanticTokenTypes": [
      { "id": "heading", "description": "Note heading" },
      { "id": "jotMoney", "superType": "number", "description": "Money" },
      { "id": "jotDate", "superType": "string", "description": "Date" },
      { "id": "jotTime", "superType": "string", "description": "Time" },
      { "id": "jotDuration", "superType": "number", "description": "Duration" },
      { "id": "jotRatio", "superType": "number", "description": "Percentage or ratio" },
      { "id": "jotBoolean", "superType": "keyword", "description": "Boolean" },
      { "id": "jotPunctuation", "description": "Jot punctuation" },
      { "id": "jotCode", "superType": "string", "description": "Literal code" },
      { "id": "jotLink", "superType": "string", "description": "Resource link" },
      { "id": "jotCheckbox", "description": "Open checkbox" },
      { "id": "jotCheckboxChecked", "description": "Completed checkbox" },
      { "id": "jotTaskDone", "superType": "comment", "description": "Completed task" }
    ],
    "semanticTokenScopes": [{
      "language": "jot",
      "scopes": {
        "heading": ["markup.heading"],
        "jotMoney": ["constant.numeric"],
        "jotDate": ["constant.other.date", "constant.numeric"],
        "jotTime": ["constant.other.time", "constant.numeric"],
        "jotDuration": ["constant.numeric"],
        "jotRatio": ["constant.numeric"],
        "jotBoolean": ["constant.language.boolean"],
        "jotPunctuation": ["punctuation.separator"],
        "jotCode": ["markup.inline.raw"],
        "jotLink": ["markup.underline.link"],
        "jotCheckbox": ["markup.list.unnumbered", "keyword"],
        "jotCheckboxChecked": ["constant.language.boolean"],
        "jotTaskDone": ["comment"]
      }
    }]
  }
}
